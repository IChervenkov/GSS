<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".Inventory">

        <!-- Spinner (Dropdown) -->
        <AutoCompleteTextView
            android:id="@+id/locationAutoCompleteTextView"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Select Location"
            android:minHeight="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Sample Location"
            tools:ignore="HardcodedText" />

        <!-- Label for Assets in Selected Location -->
        <TextView
            android:id="@+id/assetsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assets in Selected Location"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/locationAutoCompleteTextView"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            tools:ignore="HardcodedText" />

        <!-- Table for Assets in Selected Location -->
        <TableLayout
            android:id="@+id/table_assets_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1"
            app:layout_constraintTop_toBottomOf="@id/assetsLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <!-- Label for Additional Assets -->
        <TextView
            android:id="@+id/additionalAssetsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Additional Assets"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/table_assets_location"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            tools:ignore="HardcodedText" />

        <!-- Table for Additional Assets -->
        <TableLayout
            android:id="@+id/table_additional_assets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1"
            app:layout_constraintTop_toBottomOf="@id/additionalAssetsLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>