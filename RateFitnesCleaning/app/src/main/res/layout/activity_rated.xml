<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Rated">

    <TextView
        android:id="@+id/questionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Is the gym clean?"
        android:textSize="100sp"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp"/>

    <GridLayout
        android:id="@+id/emojiGrid"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:rowCount="1"
        android:columnCount="5"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/questionText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Emoji Buttons -->
        <Button
            android:id="@+id/btnAngry"
            android:layout_width="wrap_content"
            android:layout_height="262dp"
            android:layout_row="0"
            android:layout_column="0"
            android:backgroundTint="@android:color/transparent"
            android:drawableTop="@drawable/emoji_angry"
            android:padding="10dp"
            android:text="😞"
            android:textSize="32sp" />

        <Button
            android:id="@+id/btnNeutral"
            android:layout_width="294dp"
            android:layout_height="255dp"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_marginTop="8dp"
            android:backgroundTint="@android:color/transparent"
            android:drawableTop="@drawable/emoji_neutral"
            android:padding="10dp"
            android:text="😐"
            android:textSize="32sp" />

        <Button
            android:id="@+id/btnVeryHappy"
            android:layout_width="wrap_content"
            android:layout_height="246dp"
            android:layout_row="0"
            android:layout_column="2"
            android:backgroundTint="@android:color/transparent"
            android:drawableTop="@drawable/emoji_very_happy"
            android:padding="10dp"
            android:text="😁"
            android:textSize="32sp" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>