<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/icon/logoPage.png">
    <link rel="stylesheet" href="/style/stylesLogIn.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <title>
        <%= title %>
    </title>
</head>

<body class="bg-light">

    <div id="loadingIndicator" class="loading-overlay" style="display: none;">
        <div class="spinner"></div>
    </div>

    <div class="d-flex align-items-center justify-content-center vh-100">
        <div class="login-box bg-white p-5 rounded-4 shadow-lg" style="width: 100%; max-width: 420px;">
            <div class="text-center mb-4">
                <img src="/icon/logoPage.png" alt="img/png" class="logo-login">
                <h3 class="mt-5 fw-bold">
                    <%= title %>
                </h3>
                <p class="text-muted">Update your password securely</p>
            </div>

            <form id="changePassword" action="/web/changePassword" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <!-- Username -->
                <div class="mb-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                        <input type="text" class="form-control" id="username" name="username"
                            placeholder="Enter username">
                        <div class="invalid-feedback">Only letters, numbers, and spaces allowed.</div>
                        <div class="valid-feedback"></div>
                    </div>
                </div>

                <!-- Current password -->
                <div class="mb-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                        <input type="password" class="form-control" id="currentPassword" name="currentPassword"
                            placeholder="Enter current password">
                        <div class="invalid-feedback">Enter your current password.</div>
                        <div class="valid-feedback"></div>
                    </div>
                </div>

                <!-- New password -->
                <div class="mb-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                        <input type="password" class="form-control" id="newPassword" name="newPassword"
                            placeholder="Enter new password">
                        <div class="invalid-feedback">
                            Must be at least 8 characters, include upper & lower case, a number, a symbol, and differ
                            from current password.
                        </div>
                        <div class="valid-feedback"></div>
                    </div>
                </div>

                <!-- Confirm new password -->
                <div class="mb-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                        <input type="password" class="form-control" id="confirmNewPassword" name="confirmNewPassword"
                            placeholder="Re-enter new password">
                        <div class="invalid-feedback">Passwords must match.</div>
                        <div class="valid-feedback"></div>
                    </div>
                </div>

                <!-- Update Button -->
                <div class="d-grid">
                    <button type="submit" class="login-btn">
                        <i class="bi bi-arrow-repeat"></i> Update Password
                    </button>
                </div>

                <!-- Error message -->
                <p id="errorMessage" class="error-message text-danger text-center mt-3"></p>
            </form>
        </div>
    </div>

</body>

<script src="/java/changePassword.js"></script>

</html>