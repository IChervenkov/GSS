<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style/stylesLaundry.css" />
    <link rel="icon" href="/icon/logoPage.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

</head>

<body>

    <!-- Horizontal Navigation Bar -->
    <div class="horizontal-nav">
        <button type="button" class="menu-toggle" aria-label="Toggle horizontal navigation">&#9776; Menu</button>
        <ul id="nav-links">
            <% horizontalNavItems.forEach(item=> { %>
                <li>
                    <a href="<%= item.href %>">
                        <% if (item.name.toLowerCase()==='bicycles' ) { %>
                            <i class="bi bi-bicycle"></i>
                            <% } else if (item.name.toLowerCase()==='main page' ) { %>
                                <i class="bi bi-house-door"></i>
                                <% } else if (item.name.toLowerCase()==='assets' ) { %>
                                    <i class="bi bi-box"></i>
                                    <% } else if (item.name.toLowerCase()==='laundry' ) { %>
                                        <i class="bi bi-water"></i>
                                        <% } else if (item.name.toLowerCase()==='gym' ) { %>
                                            <i class="bi bi-activity"></i>
                                            <% } else if (item.name.toLowerCase()==='accommodation and keys' ) { %>
                                                <i class="bi bi-key"></i>
                                                <% } else if (item.name.toLowerCase()==='logout' ) { %>
                                                    <i class="bi bi-box-arrow-right"></i>
                                                    <% } %>
                                                        <span>
                                                            <%= item.name %>
                                                        </span>
                    </a>
                </li>
                <% }); %>
        </ul>
    </div>

    <div id="loadingIndicator" class="loading-overlay" style="display: none;">
        <div class="spinner"></div>
    </div>

    <div class="container">

        <h2 class="h2-top-left">
            <%= title %>
        </h2>

        <div class="status-row">
            <div class="status-box">
                <h3>Bags: <span id="bags-drop-off">
                        <%= totalCounts['drop off'] || 0 %>
                    </span></h3>
                <div id="all-type-drop-off">
                    <% if (bagData['drop off']) { %>
                        <% bagData['drop off'].forEach(item=> { %>
                            <p>
                                <%= item.type %>: <%= item.count %>
                            </p>
                            <% }) %>
                                <% } else { %>
                                    <p>There are no bags in this section</p>
                                    <% } %>
                </div>
                <div class="progress-box">
                    <div class="btn-container">
                        <button id="drop-off" class="main-btn">
                            <i class="bi bi-box-arrow-in-down"></i> Drop off
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">This is the first step of the laundry process. The bags are<br>
                                dropped off here.</span>
                        </div>
                    </div>
                </div>
                <p class="avg-in" <% if(username=='NSPA' ) { %> style="display:none" <% } %>>Average Time IN: <span
                            id="avg-in-drop-off">
                            <%= avgTimeData['drop off'] || '0 mins' %>
                        </span></p>
            </div>

            <div class="status-box">
                <h3>Bags: <span id="bags-transportation-to-laundry-facility">
                        <%= totalCounts['transportation to laundry facility'] || 0 %>
                    </span></h3>
                <div id="all-type-transportation-to-laundry-facility">
                    <% if (bagData['transportation to laundry facility']) { %>
                        <% bagData['transportation to laundry facility'].forEach(item=> { %>
                            <p>
                                <%= item.type %>: <%= item.count %>
                            </p>
                            <% }) %>
                                <% } else { %>
                                    <p>There are no bags in this section</p>
                                    <% } %>
                </div>
                <div class="progress-box">
                    <div class="btn-container">
                        <button id="transportation-to-laundry-facility" class="main-btn">
                            <i class="bi bi-truck"></i> Transportation to Laundry Facility
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">The bags are transported to the laundry facility from here.</span>
                        </div>
                    </div>
                </div>
                <p class="avg-in" <% if(username=='NSPA' ) { %> style="display:none" <% } %>>Average Time IN: <span
                            id="avg-in-transportation-to-laundry-facility">
                            <%= avgTimeData['transportation to laundry facility'] || '0 mins' %>
                        </span> </p>
            </div>

            <div class="status-box">
                <h3>Bags: <span id="bags-laundry-facility">
                        <%= totalCounts['laundry facility'] || 0 %>
                    </span></h3>
                <div id="all-type-laundry-facility">
                    <% if (bagData['laundry facility']) { %>
                        <% bagData['laundry facility'].forEach(item=> { %>
                            <p>
                                <%= item.type %>: <%= item.count %>
                            </p>
                            <% }) %>
                                <% } else { %>
                                    <p>There are no bags in this section</p>
                                    <% } %>
                </div>
                <div class="progress-box">
                    <div class="btn-container">
                        <button id="laundry-facility" class="main-btn">
                            <i class="bi bi-building"></i> Laundry facility
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">The bags are washed here.</span>
                        </div>
                    </div>
                </div>
                <p class="avg-in" <% if(username=='NSPA' ) { %> style="display:none" <% } %>>Average Time IN: <span
                            id="avg-in-laundry-facility">
                            <%= avgTimeData['laundry facility'] || '0 mins' %>
                        </span></p>
            </div>

            <div class="status-box">
                <h3>Bags: <span id="bags-transportation-to-drop-off">
                        <%= totalCounts['transportation to drop off'] || 0 %>
                    </span></h3>
                <div id="all-type-transportation-to-drop-off">
                    <% if (bagData['transportation to drop off']) { %>
                        <% bagData['transportation to drop off'].forEach(item=> { %>
                            <p>
                                <%= item.type %>: <%= item.count %>
                            </p>
                            <% }) %>
                                <% } else { %>
                                    <p>There are no bags in this section</p>
                                    <% } %>
                </div>
                <div class="progress-box">
                    <div class="btn-container">
                        <button id="transportation-to-drop-off" class="main-btn">
                            <i class="bi bi-truck"></i> Transportation to drop off
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">The bags are transported to the drop off location from
                                here.</span>
                        </div>
                    </div>
                </div>
                <p class="avg-in" <% if(username=='NSPA' ) { %> style="display:none" <% } %>>Average Time IN: <span
                            id="avg-in-transportation-to-drop-off">
                            <%= avgTimeData['transportation to drop off'] || '0 mins' %>
                        </span></p>
            </div>

            <div class="status-box">
                <h3>Bags: <span id="bags-ready-to-pick-up">
                        <%= totalCounts['ready to pick up'] || 0 %>
                    </span></h3>
                <div id="all-type-ready-to-pick-up">
                    <% if (bagData['ready to pick up']) { %>
                        <% bagData['ready to pick up'].forEach(item=> { %>
                            <p>
                                <%= item.type %>: <%= item.count %>
                            </p>
                            <% }) %>
                                <% } else { %>
                                    <p>There are no bags in this section</p>
                                    <% } %>
                </div>
                <div class="progress-box">
                    <div class="btn-container">
                        <button id="ready-to-pick-up" class="main-btn">
                            <i class="bi bi-bag-check"></i> Ready to pick up
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">The bags are ready to be picked up by the soldiers.</span>
                        </div>
                    </div>
                </div>

                <p class="avg-in" <% if(username=='NSPA' ) { %> style="display:none" <% } %>>Average Time IN: <span
                            id="avg-in-ready-to-pick-up">
                            <%= avgTimeData['ready to pick up'] || '0 mins' %>
                        </span></p>
            </div>
        </div>

        <!-- Summary and Report Button Row -->
        <div class="summary-row d-flex justify-content-between align-items-center w-100">
            <div class="summary" <% if(username=='NSPA' ) { %> style="display:none" <% } %>>
                    <p>Total Bags For Last Month: <span>
                            <%= overallTotalMountFormatted %>
                        </span></p>
                    <p>Average Washing Time: <span>
                            <%= overallAverageFormatted %>
                        </span></p>
            </div>

            <div class="button-row">
                <div class="btn-container w-100 w-md-auto">
                    <button id="reportButton" class="report-button d-flex align-items-center justify-content-center">
                        <i class="bi bi-file-earmark-text me-2"></i> <span>Report</span>
                    </button>
                    <div class="tooltip-custom">
                        <i class="bi bi-question-circle"></i>
                        <span class="tooltiptext">Generate report</span>
                    </div>
                </div>
                <div class="button-container-report" <% if(username=='NSPA' ) { %> style="cursor: not-allowed;" <% } %>>
                    <button type="button" class="download-btn <% if(username=='NSPA' ) { %> disabled-button <% } %>" id="downloadRFIDAppBtn">
                        <i class="bi bi-download"></i> Download App
                    </button>
                </div>
                <div class="w-100" <% if(username!='admin' && username!='helpDeskNikolay' ) { %> style="cursor:
                    not-allowed" <% } %>>
                        <div class="btn-container w-100 w-md-auto">
                            <button id="listOfBagsButton"
                                class="report-button <% if(username!='admin' && username != 'helpDeskNikolay') { %> disabled-button <% } %> w-100 w-md-auto">
                                <i class="bi bi-list-ul"></i> List of bags
                            </button>
                            <div class="tooltip-custom">
                                <i class="bi bi-question-circle"></i>
                                <span class="tooltiptext">List of all bags in system</span>
                            </div>
                        </div>
                </div>
            </div>

        </div>

    </div>

    <%- include('partials/modal_laundry', { id: 'dropOff' , title: 'Drop Off' , headerTable,
        destination: 'Transportation to laundry facility' , previewDestination: 'Drop off' }) %>

        <%- include('partials/modal_laundry', { id: 'transportationToLaundryFacility' ,
            title: 'Transportation to laundry Facility' , headerTable, destination: 'Laundry facility' ,
            previewDestination: 'Transportation to laundry facility' }) %>

            <%- include('partials/modal_laundry', { id: 'laundryFacility' , title: 'Laundry facility' , headerTable,
                destination: 'Transportation to drop off' , previewDestination: 'Laundry facility' }) %>

                <%- include('partials/modal_laundry', { id: 'transportationToDropOff' ,
                    title: 'Transportation to drop off' , headerTable, destination: 'Ready to pick up' ,
                    previewDestination: 'Transportation to drop off' }) %>

                    <%- include('partials/modal_laundry', { id: 'readyToPickUp' , title: 'Ready to pick up' ,
                        headerTable, destination: 'None' , previewDestination: 'Ready to pick up' }) %>

                        <% if(username !='NSPA' ) { %>
                        <div class="toast-container position-fixed bottom-0 end-0 p-3">
                            <div id="liveToast" class="toast align-items-center text-white border-0 custom-toast"
                                role="alert" aria-live="assertive" aria-atomic="true">
                                <div class="d-flex align-items-center">
                                    <!-- Info Icon -->
                                    <i class="bi bi-info-circle-fill toast-icon"></i>

                                    <!-- Toast Message -->
                                    <div class="toast-body flex-grow-1" id="toast-message">
                                        <!-- Message will be inserted here -->
                                    </div>

                                    <!-- Close Button -->
                                    <button type="button" class="btn-close btn-close-white me-2 m-auto" id="close-toast"
                                        aria-label="Close"></button>
                                </div>
                            </div>
                        </div>
                        <% } %>

                        <div id="reportViewModal" class="modal">
                            <form class="modal-content-report" action="/laundry/report" method="GET" id="form1">
                                <span class="close-btn">&times;</span>
                                <h2>Reports View</h2>

                                <!-- Left and Right Navigation Buttons -->
                                <div class="d-flex justify-content-end mt-2 mb-2">
                                    <button type="button" id="prevBtn"></button>
                                    <span id="pageNumber"></span>
                                    <button type="button" id="nextBtn"></button>
                                </div>

                                <div class="table-container">
                                    <table id="bagsWashedTable">
                                        <thead>
                                            <tr>
                                                <th><input name="bagNumber" type="text"
                                                        class="search-input-view-laundry" placeholder="Search...">Bag
                                                    number</th>
                                                <th><input name="soldierName" type="text"
                                                        class="search-input-view-laundry"
                                                        placeholder="Search...">Soldier name</th>
                                                <th><input name="nationality" type="text"
                                                        class="search-input-view-laundry"
                                                        placeholder="Search...">Nationality</th>
                                                <th><input name="bagType" type="text" class="search-input-view-laundry"
                                                        placeholder="Search...">Bag type</th>
                                                <th><input name="statusBag" type="text"
                                                        class="search-input-view-laundry"
                                                        placeholder="Search...">Location</th>
                                                <th><input name="dateIn" type="text" class="search-input-view-laundry"
                                                        placeholder="Search...">Date of issue</th>
                                                <th><input name="dateOut" type="text" class="search-input-view-laundry"
                                                        placeholder="Search...">Collection date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-end mt-2 mb-2">
                                    <button type="button" id="prevBtnDate"></button>
                                    <span id="pageNumberDate"></span>
                                    <button type="button" id="nextBtnDate"></button>
                                </div>

                                <div class="table-container">
                                    <table id="bagsWashedNationalityTable">
                                        <thead>
                                            <tr>
                                                <th><input name="nationality" type="text"
                                                        class="search-input-view-laundry-second"
                                                        placeholder="Search...">Nationality</th>
                                                <th><input name="bagCount" type="text"
                                                        class="search-input-view-laundry-second"
                                                        placeholder="Search...">Number of bags washed</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Buttons for confirming the selection -->
                                <div class="button-container">
                                    <button type="submit" id="confirmReportBtnReport" class="modal-button">Generate
                                        Report</button>
                                </div>

                            </form>
                        </div>

                        <%- include('partials/modal_laundry_action', { id: 'addBag' ,
                            destination: '/changeStatusConsole' , formId: 'form2' , title: 'Add bag' ,
                            searchId: 'search-bags' , inputSearchId: 'search-add-input-bags' , labelSearch: 'Bag Number'
                            , dropDownSearchId: 'addBagDropDown' , selectSearchId: 'addBagSelectId' ,
                            buttonId: 'add-btn' , buttonText: 'Add bag' }) %>

                            <%- include('partials/modal_laundry_action', { id: 'moveBag' ,
                                destination: '/changeStatusConsole' , formId: 'form3' , title: 'Move bag' ,
                                searchId: 'search-bags' , inputSearchId: 'search-move-input-bags' ,
                                labelSearch: 'Bag Number' , dropDownSearchId: 'moveBagDropDown' ,
                                selectSearchId: 'moveBagSelectId' , buttonId: 'move-btn' , buttonText: 'Move bag' }) %>

                                <%- include('partials/modal_laundry_action', { id: 'removeBag' ,
                                    destination: '/changeStatusConsole' , formId: 'form4' , title: 'Remove bag' ,
                                    searchId: 'search-bags' , inputSearchId: 'search-remove-input-bags' ,
                                    labelSearch: 'Bag Number' , dropDownSearchId: 'removeBagDropDown' ,
                                    selectSearchId: 'removeBagSelectId' , buttonId: 'remove-btn' ,
                                    buttonText: 'Remove bag' }) %>

                                    <%- include('partials/modal_laundry_action', { id: 'linenExchangeBag' ,
                                        destination: '/changeEndToEndStatusConsole' , formId: 'form5' ,
                                        title: 'Linen Exchange service' , searchId: 'search-bags' ,
                                        inputSearchId: 'search-exchange-input-bags' , labelSearch: 'Bag Number' ,
                                        dropDownSearchId: 'exchangeBagDropDown' , selectSearchId: 'exchangeBagSelectId'
                                        , buttonId: 'exchange-btn' , buttonText: 'Exchange bag' }) %>

                                        <div id="bagsModal" class="modal">
                                            <div class="modal-content">
                                                <span class="close-btn">&times;</span>

                                                <h2 class="d-flex align-items-center gap-2">List of Bags
                                                    <div class="btn-container">
                                                        <button type="button"
                                                            class="btn btn-outline-success btn-sm rounded-circle fw-bold"
                                                            id="addButton"><i class="bi bi-plus"></i></button>
                                                        <div class="tooltip-custom">
                                                            <i class="bi bi-question-circle"></i>
                                                            <span class="tooltiptext">Add bag to the system</span>
                                                        </div>
                                                    </div>
                                                    <div class="btn-container">
                                                        <button type="button"
                                                            class="btn btn-outline-danger btn-sm rounded-circle fw-bold"
                                                            id="removeButton"><i class="bi bi-dash"></i></button>
                                                        <div class="tooltip-custom">
                                                            <i class="bi bi-question-circle"></i>
                                                            <span class="tooltiptext">Remove bag from the system</span>
                                                        </div>
                                                    </div>
                                                </h2>

                                                <div class="d-flex justify-content-end mt-2 mb-2">
                                                    <button type="button" id="prevBtnSecond"></button>
                                                    <span id="pageNumberSecond"></span>
                                                    <button type="button" id="nextBtnSecond"></button>
                                                </div>

                                                <div class="table-container">
                                                    <table id="bagsTable">
                                                        <thead>
                                                            <tr>
                                                                <th>
                                                                    <input type="text" class="laundry-search-input"
                                                                        placeholder="Search...">
                                                                    <label id="bag-code-header">Bag code</label>
                                                                </th>

                                                                <th>
                                                                    <input type="text" class="laundry-search-input"
                                                                        placeholder="Search...">
                                                                    <label id="bag-type-header">Bag type</label>
                                                                </th>

                                                                <th>
                                                                    <input type="text" class="laundry-search-input"
                                                                        placeholder="Search...">
                                                                    <label id="bag-type-header">Maximum number of
                                                                        washes</label>
                                                                </th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="tableBodyModal">
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>

                                        <div id="insertBagModal" class="modal">
                                            <form class="modal-content" action="/laundry/addBag" method="POST"
                                                id="form6">
                                                <span class="close-btn">&times;</span>
                                                <h2>Add bag</h2>

                                                <div class="mb-3">
                                                    <label for="epc-bag" class="form-label">EPC code <span
                                                            class="text-danger">*</span></label>
                                                    <input type="text" id="epc-bag" name="epcBag" class="form-control"
                                                        placeholder="EPC code" pattern="^[a-zA-Z0-9]+$">
                                                    <div class="invalid-feedback">
                                                        Please enter a valid EPC code (only letters and numbers)
                                                    </div>
                                                    <div class="valid-feedback"></div>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="code-bag" class="form-label">Bag code <span
                                                            class="text-danger">*</span></label>
                                                    <input type="text" id="code-bag" name="codeBag" class="form-control"
                                                        placeholder="Code bag" pattern="^[a-zA-Z0-9]+$">
                                                    <div class="invalid-feedback">
                                                        Please enter a valid bag code (only letters and numbers)
                                                    </div>
                                                    <div class="valid-feedback"></div>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="type-bag" class="form-label">Bag type <span
                                                            class="text-danger">*</span></label>
                                                    <input type="text" id="type-bag" name="typeBag" class="form-control"
                                                        placeholder="Type bag" pattern="^[a-zA-Z0-9\s]+$">

                                                    <div class="invalid-feedback">
                                                        Please enter a valid bag type (only letters and numbers).
                                                    </div>
                                                    <div class="valid-feedback"></div>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="max-count-wash-bag" class="form-label">Maximum number of
                                                        washes <span class="text-danger">*</span></label>
                                                    <input type="text" id="max-count-wash-bag" name="maxCountWashBag"
                                                        class="form-control" placeholder="Maximum number of washes"
                                                        pattern="^[0-9]+$">

                                                    <div class="invalid-feedback">
                                                        Please enter a valid max wash number (only numbers).
                                                    </div>
                                                    <div class="valid-feedback"></div>
                                                </div>

                                                <!-- Buttons for confirming the selection -->

                                                <div class="button-container">
                                                    <button type="submit" id="addBagButton" class="modal-button">
                                                        <i class="bi bi-plus-circle"></i> Add
                                                    </button>
                                                </div>
                                            </form>
                                        </div>

                                        <div id="editBagModal" class="modal">
                                            <form class="modal-content" action="/laundry/editBag" method="POST"
                                                id="form7">
                                                <span class="close-btn">&times;</span>

                                                <h2>Edit bag</h2>

                                                <!-- Bag Selection with Custom Search -->
                                                <div class="mb-3 search-container" id="search-edit-bag">
                                                    <label for="bagEditSearch" class="form-label">Bag code <span
                                                            class="text-danger">*</span></label>
                                                    <input type="text" id="bagEditSearch" class="form-control"
                                                        placeholder="Bag code">
                                                    <div class="invalid-feedback"></div>
                                                    <div class="valid-feedback"></div>
                                                    <ul id="editBagDropdown" class="list-group"></ul>
                                                    <!-- Custom dropdown for search -->
                                                    <input type="hidden" id="selectedEditBagId" name="editBagId"
                                                        value="">
                                                    <!-- To store the selected soldier ID -->
                                                </div>

                                                <!-- Bag Selection with Custom Search -->
                                                <div class="mb-3" id="search-edit-type">
                                                    <label for="typeEditSearch" class="form-label">Bag type <span
                                                            class="text-danger">*</span></label>
                                                    <input type="text" id="typeEditSearch" class="form-control"
                                                        placeholder="Bag type">
                                                    <div class="invalid-feedback"></div>
                                                    <div class="valid-feedback"></div>
                                                </div>

                                                <!-- Bag Selection with Custom Search -->
                                                <div class="mb-3" id="search-edit-wash">
                                                    <label for="washEditSearch" class="form-label">Maximum number of
                                                        washes
                                                        <span class="text-danger">*</span></label>
                                                    <input type="text" id="washEditSearch" class="form-control"
                                                        placeholder="Maximum number of washes"
                                                        pattern="^[a-zA-Z0-9 ]+$">
                                                    <div class="invalid-feedback"></div>
                                                    <div class="valid-feedback"></div>
                                                </div>

                                                <!-- Buttons for confirming the selection -->
                                                <div class="button-container">
                                                    <button type="submit" id="editBagButton" class="modal-button">
                                                        <i class="bi bi-pencil-square"></i> Edit
                                                    </button>
                                                </div>

                                            </form>
                                        </div>

                                        <!-- The Modal for Reports -->
                                        <div id="reportModal" class="modal">
                                            <div class="modal-content-multi-calendar">
                                                <span class="close-btn">&times;</span>
                                                <h3 class="header-modal-report">Reports - Select Date Range (From/To
                                                    Date)
                                                </h3>

                                                <!-- Container for two side-by-side calendars -->
                                                <div class="calendar-container">
                                                    <div class="calendar" id="calendar1">
                                                        <header>
                                                            <h3></h3>
                                                            <nav>
                                                                <button type="button" id="prev"></button>
