<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/icon/logoPage.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style/styleAssets.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

</head>

<body>

    <!-- Horizontal Navigation Bar -->
    <div class="horizontal-nav">
        <ul id="nav-links">
            <% horizontalNavItems.forEach(item=> { %>
                <li>
                    <a href="<%= item.href %>">
                        <% if (item.name.toLowerCase()==='bicycles' ) { %>
                            <i class="bi bi-bicycle"></i>
                            <% } else if (item.name.toLowerCase()==='main page' ) { %>
                                <i class="bi bi-house-door"></i>
                                <% } else if (item.name.toLowerCase()==='assets' ) { %>
                                    <i class="bi bi-box"></i>
                                    <% } else if (item.name.toLowerCase()==='laundry' ) { %>
                                        <i class="bi bi-water"></i>
                                        <% } else if (item.name.toLowerCase()==='gym' ) { %>
                                            <i class="bi bi-activity"></i>
                                            <% } else if (item.name.toLowerCase()==='accommodation and keys' ) { %>
                                                <i class="bi bi-key"></i>
                                                <% } else if (item.name.toLowerCase()==='logout' ) { %>
                                                    <i class="bi bi-box-arrow-right"></i>
                                                    <% } %>
                                                        <span>
                                                            <%= item.name %>
                                                        </span>
                    </a>
                </li>
                <% }); %>
        </ul>
    </div>

    <div id="loadingIndicator" class="loading-overlay" style="display: none;">
        <div class="spinner"></div>
    </div>

    <div class="main-content">

        <div class="left-nav">
            <ul>
                <% navItems.forEach(function(item) { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <button id="<%= item.id %>" class="flex-grow-1 text-decoration-none full-back">
                            <%= item.name %>
                        </button>
                    </li>
                    <% }); %>
            </ul>
        </div>

        <div class="content">

            <div class="visualization-header">
                <div class="row align-items-center gap-4">
                    <!-- Title and Count Beds Column -->
                    <div class="col-md-auto">
                        <h3 class="mb-0">
                            <!-- Title Row -->
                            <div>
                                <%= title %>
                            </div>
                        </h3>
                    </div>
                </div>

                <div class="virtual-warehouse-labels">
                    <div class="btn-container">
                        <button type="button" id="btnAddTypeAsset" class="btn-add-type">
                            <i class="bi bi-plus-circle"></i> Add Type
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Add a new type of asset to the list.</span>
                        </div>
                    </div>

                    <div class="btn-container">
                        <button type="button" id="btnRemoveTypeAsset" class="btn-add-type">
                            <i class="bi bi-dash-circle"></i> Remove Type
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Remove a type of asset from the list.</span>
                        </div>
                    </div>

                    <div class="btn-container">
                        <button type="button" id="btnLostAsset" class="btn-add-type">
                            <i class="bi bi-exclamation-circle"></i> Lost Asset
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Report a lost asset.</span>
                        </div>
                    </div>

                    <div class="btn-container">
                        <button id="reportButton" class="btn-add-type d-flex align-items-center justify-content-center">
                            <i class="bi bi-file-earmark-text me-2"></i> <span>Asset archive</span>
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">View the asset archive.</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Inventory Table -->
            <div class="table-container">
                <table id="data-table">
                    <thead>
                        <tr>
                            <th>
                                <input type="text" class="search-input" placeholder="Search...">
                                <label id="room-number-header">Room Number</label>
                            </th>

                            <th>
                                <input type="text" class="search-input" placeholder="Search...">
                                <label id="room-number-assets">Number of assets</label>
                            </th>
                        </tr>
                    </thead>

                    <% if (inventory) { %>
                        <tbody id="tableBody">
                            <% inventory.forEach(function(item) { %>
                                <tr class="data-room" id="<%= item.id %>">

                                    <td>
                                        <%= item.name %>
                                    </td>

                                    <td>
                                        <%= item.quantity %>
                                    </td>

                                    <% }); %>
                                </tr>
                        </tbody>
                        <% }; %>
                </table>
            </div>

            <nav aria-label="Table pagination">
                <ul id="pagination" class="pagination justify-content-center"></ul>
            </nav>
        </div>
    </div>

    <div id="assetsModal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>

            <h2>List of Assets
                <div class="btn-container">
                    <button type="button" class="btn btn-outline-success btn-sm rounded-circle fw-bold" id="addAsset"><i
                            class="bi bi-plus"></i></button>
                    <div class="tooltip-custom">
                        <i class="bi bi-question-circle"></i>
                        <span class="tooltiptext">Add a new asset to the list.</span>
                    </div>
                </div>
                <div class="btn-container">
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-circle fw-bold"
                        id="removeAsset"><i class="bi bi-dash"></i></button>
                    <div class="tooltip-custom">
                        <i class="bi bi-question-circle"></i>
                        <span class="tooltiptext">Remove an asset from the list.</span>
                    </div>
                </div>
            </h2>

            <div class="table-container">
                <table id="assetTable">
                    <thead>
                        <tr>
                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-code-header">Asset code</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-name-header">Asset name</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-type-header">Asset type</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-location-header">Asset location</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-description-header">Description</label>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="tableBodyModal">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="editAssetsModal" class="modal">
        <form class="modal-content" method="POST" action="/assets/editAsset" id="form1">
            <span class="close-btn">&times;</span>

            <h2 class="mb-4">Asset information</h2>

            <div class="row">
                <div class="col-md-4 mb-3 search-container" id="search-assert-container">
                    <label for="assetSearch" class="form-label">Assert code <span class="text-danger">*</span></label>
                    <input type="text" id="assetSearch" class="form-control" placeholder="Asset code">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="assetDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedAssetId" name="assetId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <div class="col-md-4 mb-3">
                    <label for="assetName" class="form-label">Assert name <span class="text-danger">*</span></label>
                    <input type="text" id="assetName" class="form-control" placeholder="Asset name"
                        pattern="^[a-zA-Z0-9\s]+$">
                </div>

                <div class="col-md-4 mb-3 search-container" id="search-type-container">
                    <label for="typeSearch" class="form-label">Assert type <span class="text-danger">*</span></label>
                    <input type="text" id="typeSearch" class="form-control" placeholder="Asset type">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="typeDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedTypeId" name="typeId" value="">
                    <!-- To store the selected soldier ID -->
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3 search-container" id="search-location-container">
                    <label for="locationSearch" class="form-label">Assert location <span
                            class="text-danger">*</span></label>
                    <input type="text" id="locationSearch" class="form-control" placeholder="Asset location">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="locationDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedLocationId" name="locationId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <div class="col-md-4 mb-3 search-container" id="search-sub-location-container">
                    <label for="subLocationSearch" class="form-label">Associated key</label>
                    <input type="text" id="subLocationSearch" class="form-control" placeholder="Associated key">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="subLocationDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedSubLocationId" name="subLocationId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <div class="col-md-4 mb-3">
                    <label for="categorie" class="form-label">Asset categories <span
                            class="text-danger">*</span></label>
                    <input type="text" id="categorie" class="form-control" placeholder="Asset categories"
                        pattern="^[a-zA-Z\s]+$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="quantity" class="form-label">Assert quantity <span class="text-danger">*</span></label>
                    <input type="number" id="quantity" class="form-control" placeholder="Asset quantity" min="1"
                        value="1">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-4 mb-3">
                    <label for="mrah" class="form-label">MRAH <span class="text-danger">*</span></label>
                    <input type="text" id="mrah" class="form-control" placeholder="MRAH" pattern="^[a-zA-Z\s]+$"
                        value="Global RTS">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-4 mb-3">
                    <label for="owner" class="form-label">Assert owner <span class="text-danger">*</span></label>
                    <input type="text" id="owner" class="form-control" placeholder="Asset owner" pattern="^[a-zA-Z\s]+$"
                        value="Global RTS">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="status" class="form-label">Status <span class="text-danger">*</span></label>
                    <input type="number" id="status" class="form-control" placeholder="Status" min="1" max="3"
                        value="1">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-6 mb-3">
                    <label for="expandable" class="form-label">Expandable <span class="text-danger">*</span></label>
                    <select id="expandable" class="form-control">
                        <option value="Expandable">Expandable</option>
                        <option value="Non Expandable" selected>Non Expandable</option>
                    </select>
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label for="description" class="form-label">Asset description</label>
                    <textarea id="description" class="form-control" placeholder="Asset description" rows="5"
                        style="max-height: 120px;"></textarea>
                </div>
            </div>

            <button type="submit" class="modal-button" id="edit-button">
                <i class="bi bi-pencil-square"></i> Edit
            </button>


        </form>
    </div>

    <div id="addAssetsModal" class="modal">
        <form class="modal-content" method="POST" action="/assets/addAsset" id="form2">
            <span class="close-btn">&times;</span>

            <h2 class="mb-4">Add asset</h2>

            <div class="row">
                <div class="col-md-4 mb-3" id="assert-epc-container">
                    <label for="assetEpc" class="form-label">Asset EPC code <span class="text-danger">*</span></label>
                    <input type="text" id="assetEpc" class="form-control" placeholder="Asset EPC code"
                        pattern="^[a-zA-Z0-9]+$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-4 mb-3" id="assert-code-container">
                    <label for="assetCodeSearch" class="form-label">Assert code <span
                            class="text-danger">*</span></label>
                    <input type="text" id="assetCodeSearch" class="form-control" placeholder="Asset code"
                        pattern="^[a-zA-Z0-9]+$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-4 mb-3">
                    <label for="assetAddName" class="form-label">Assert name <span class="text-danger">*</span></label>
                    <input type="text" id="assetAddName" class="form-control" placeholder="Asset name"
                        pattern="^[a-zA-Z0-9\s]+$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <div class="row">

                <div class="col-md-4 mb-3 search-container" id="search-add-type-container">
                    <label for="addTypeSearch" class="form-label">Assert type <span class="text-danger">*</span></label>
                    <input type="text" id="addTypeSearch" class="form-control" placeholder="Asset type">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="addTypeDropdown" class="list-group"></ul>
                    <input type="hidden" id="selectedAddTypeId" name="typeId" value="">
                </div>

                <div class="col-md-4 mb-3 search-container" id="search-add-location-container">
                    <label for="addLocationSearch" class="form-label">Assert location <span
                            class="text-danger">*</span></label>
                    <input type="text" id="addLocationSearch" class="form-control" placeholder="Asset location">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="addLocationDropdown" class="list-group"></ul>
                    <input type="hidden" id="selectedAddLocationId" name="locationId" value="">
                </div>

                <div class="col-md-4 mb-3 search-container" id="search-add-sub-location-container">
                    <label for="addSubLocationSearch" class="form-label">Associated key</label>
                    <input type="text" id="addSubLocationSearch" class="form-control" placeholder="Associated key">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="addSubLocationDropdown" class="list-group"></ul>
                    <input type="hidden" id="selectedAddSubLocationId" name="subLocationId" value="">
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="addCategorie" class="form-label">Asset categories <span
                            class="text-danger">*</span></label>
                    <input type="text" id="addCategorie" class="form-control" placeholder="Asset categories"
                        pattern="^[a-zA-Z\s]+$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-4 mb-3">
                    <label for="assetQuantity" class="form-label">Assert quantity <span
                            class="text-danger">*</span></label>
                    <input type="number" id="assetQuantity" class="form-control" placeholder="Asset quantity" min="1"
                        value="1">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-4 mb-3">
                    <label for="assetAddMrah" class="form-label">MRAH <span class="text-danger">*</span></label>
                    <input type="text" id="assetAddMrah" class="form-control" placeholder="MRAH" pattern="^[a-zA-Z\s]+$"
                        value="Global RTS">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <div class="row">

                <div class="col-md-4 mb-3">
                    <label for="assetAddOwner" class="form-label">Assert owner <span
                            class="text-danger">*</span></label>
                    <input type="text" id="assetAddOwner" class="form-control" placeholder="Asset owner"
                        pattern="^[a-zA-Z\s]+$" value="Global RTS">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-4 mb-3">
                    <label for="assetStatus" class="form-label">Status <span class="text-danger">*</span></label>
                    <input type="number" id="assetStatus" class="form-control" placeholder="Status" min="1" max="3"
                        value="1">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-4 mb-3">
                    <label for="assetAddExpandable" class="form-label">Expandable <span
                            class="text-danger">*</span></label>
                    <select id="assetAddExpandable" class="form-control">
                        <option value="Expandable">Expandable</option>
                        <option value="Non Expandable" selected>Non Expandable</option>
                    </select>
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label for="assetAddDescription" class="form-label">Asset description</label>
                    <textarea id="assetAddDescription" class="form-control" placeholder="Asset description" rows="5"
                        style="max-height: 120px;"></textarea>
                </div>

                <button type="submit" class="modal-button" id="add-button">
                    <i class="bi bi-plus-circle"></i> Add Asset
                </button>
            </div>

        </form>
    </div>

    <div id="addAssetsTypeModal" class="modal">
        <form class="modal-content" method="POST" , action="/assets/addTypeAsset" id="form3">
            <span class="close-btn">&times;</span>

            <h2 class="mb-4">Add asset type</h2>

            <div class="mb-3" id="assert-type-container">
                <label for="assetType" class="form-label">Asset type <span class="text-danger">*</span></label>
                <input type="text" id="assetType" class="form-control" placeholder="Asset type" ,
                    pattern="^[a-zA-Z\s]+$">
                <div class="invalid-feedback"></div>
                <div class="valid-feedback"></div>
            </div>

            <button type="submit" class="modal-button" id="edit-button">
                <i class="bi bi-plus-circle"></i> Add Type
            </button>

        </form>
    </div>

    <div id="removeAssetsTypeModal" class="modal">
        <form class="modal-content" method="POST" , action="/assets/removeTypeAsset" id="form4">
            <span class="close-btn">&times;</span>

            <h2 class="mb-4">Remove asset type</h2>

            <div class="mb-3 search-container" id="search-remove-type-container">
                <label for="removeAssetTypeSearch" class="form-label">Asset type <span
                        class="text-danger">*</span></label>
                <input type="text" id="removeAssetTypeSearch" class="form-control" placeholder="Asset type">
                <div class="invalid-feedback"></div>
                <div class="valid-feedback"></div>
                <ul id="removeAssetTypeDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                <input type="hidden" id="selectedRemoveAssetId" name="removeAssetTypeId" value="">
                <!-- To store the selected soldier ID -->
            </div>

            <button type="submit" class="modal-button" id="edit-button">
                <i class="bi bi-dash-circle"></i> Remove type
            </button>

        </form>
    </div>

    <div id="lostAssetsModal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>

            <h2 class="mb-4">Lost Asset</h2>

            <div class="modal-body">

                <form class="form-section" method="POST" action="/assets/lostItem" id="form5">
                    <div class="mb-3 search-container">
                        <label class="form-label" for="lostAssetName">Item code <span
                                class="text-danger">*</span></label>
                        <input type="text" id="lostAssetName" name="lostAssetName" class="form-control"
                            placeholder="Item code" aria-label="Item code">
                        <div class="invalid-feedback"></div>
                        <div class="valid-feedback"></div>
                        <ul id="lostAssetNameDropdown" class="list-group"></ul>
                        <!-- Custom dropdown for search -->
                        <input type="hidden" id="selectedLostAssetNameId" name="lostAssetNameId" value="">
                    </div>

                    <div class="mb-3 form-group">
                        <label class="form-label" for="assetDescription">Description</label>
                        <textarea id="assetDescription" name="assetDescription" class="form-control" rows="5"
                            placeholder="Description..."></textarea>
                        <div class="invalid-feedback"></div>
                        <div class="valid-feedback"></div>
                    </div>

                    <div class="mb-3 search-container">
                        <label class="form-label" for="assetLocation">Last Known Person <span
                                class="text-danger">*</span></label>
                        <input type="text" id="assetLocation" name="assetLocation" class="form-control"
                            placeholder="Last Known Person">
                        <div class="invalid-feedback"></div>
                        <div class="valid-feedback"></div>
                        <ul id="assetLocationDropdown" class="list-group"></ul>
                        <!-- Custom dropdown for search -->
                        <input type="hidden" id="selectedAssetLocationId" name="assetLocationId" value="">
                    </div>

                    <div class="mb-3">
                        <label for="lostAssetQuantity" class="form-label">Assert quantity <span
                                class="text-danger">*</span></label>
                        <input type="number" id="lostAssetQuantity" class="form-control" placeholder="Asset quantity"
                            min="1">
                        <div class="invalid-feedback"></div>
                        <div class="valid-feedback"></div>
                    </div>

                    <button type="submit" class="modal-button">Save</button>
                </form>

                <div class="table-section">
                    <table id="lostItemsTable">
                        <thead>
                            <tr>
                                <th><input type="text" class="lost-item-search-input" placeholder="Search...">Item Name
                                </th>
                                <th><input type="text" class="lost-item-search-input" placeholder="Search...">Last Known
                                    Person</th>
                                <th><input type="text" class="lost-item-search-input"
                                        placeholder="Search...">Description</th>
                                <th><input type="text" class="lost-item-search-input" placeholder="Search...">Lost
                                    Quantity</th>
                            </tr>
                        </thead>
                        <tbody id="lostItemsTableBody">
                            <!-- Lost items will be dynamically added here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- The Modal for Reports -->
    <div id="reportModal" class="modal">
        <div class="modal-content-multi-calendar">
            <span class="close-btn">&times;</span>
            <h3 class="header-modal-report">Archive - Select Date Range (From/To Date)
            </h3>

            <!-- Container for two side-by-side calendars -->
            <div class="calendar-container">
                <div class="calendar" id="calendar1">
                    <header>
                        <h3></h3>
                        <nav>
                            <button type="button" id="prev"></button>
                            <button type="button" id="next"></button>
                        </nav>
                    </header>
                    <section>
                        <ul class="days">
                            <li>Sun</li>
                            <li>Mon</li>
                            <li>Tue</li>
                            <li>Wed</li>
                            <li>Thu</li>
                            <li>Fri</li>
                            <li>Sat</li>
                        </ul>
                        <ul class="dates"></ul>
                    </section>
                </div>

                <div class="calendar" id="calendar2">
                    <header>
                        <h3></h3>
                        <nav>
                            <button type="button" id="prev"></button>
