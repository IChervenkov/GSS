<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/icon/logoPage.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style/styleAssets.css">
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

</head>

<body>

    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="isFirstTime" value="false">
    <input type="hidden" id="totalCount" value="<%= totalCount %>">
    <input type="hidden" id="numBuild" value="">

    <!-- Horizontal Navigation Bar -->
    <div class="horizontal-nav">
        <button type="button" class="menu-toggle" aria-label="Toggle horizontal navigation">&#9776; Menu</button>
        <ul id="nav-links">
            <% horizontalNavItems.forEach(item=> { %>
                <li>
                    <a href="<%= item.href %>">
                        <% if (item.name.toLowerCase()==='bicycles' ) { %>
                            <i class="bi bi-bicycle"></i>
                            <% } else if (item.name.toLowerCase()==='main page' ) { %>
                                <i class="bi bi-house-door"></i>
                                <% } else if (item.name.toLowerCase()==='assets' ) { %>
                                    <i class="bi bi-box"></i>
                                    <% } else if (item.name.toLowerCase()==='laundry' ) { %>
                                        <i class="bi bi-water"></i>
                                        <% } else if (item.name.toLowerCase()==='gym' ) { %>
                                            <i class="bi bi-activity"></i>
                                            <% } else if (item.name.toLowerCase()==='accommodation and keys' ) { %>
                                                <i class="bi bi-key"></i>
                                                <% } else if (item.name.toLowerCase()==='logout' ) { %>
                                                    <i class="bi bi-box-arrow-right"></i>
                                                    <% } %>
                                                        <span>
                                                            <%= item.name %>
                                                        </span>
                    </a>
                </li>
                <% }); %>
        </ul>
    </div>

    <div id="loadingIndicator" class="loading-overlay" style="display: none;">
        <div class="spinner"></div>
    </div>

    <div class="main-content">

        <button type="button" id="menu-toggle-left" class="menu-toggle-left" aria-label="Toggle sidebar navigation">
            <span id="arrow">&#9651;</span> Setting parameters
        </button>

        <div class="left-nav">
            <ul>
                <% navItems.forEach(function(item) { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <button id="<%= item.id %>" class="flex-grow-1 text-decoration-none full-back">
                            <%= item.name %>
                        </button>
                    </li>
                    <% }); %>
            </ul>
        </div>

        <div class="content">

            <div class="visualization-header">
                <div class="row align-items-center gap-4">
                    <!-- Title and Count Beds Column -->
                    <div class="col-md-auto">
                        <h3 class="mb-0">
                            <!-- Title Row -->
                            <div>
                                <%= title %>
                            </div>
                        </h3>
                    </div>
                </div>

                <div class="virtual-warehouse-labels">

                    <div class="col-md">
                        <!-- Soldier Selection with Custom Search -->
                        <div class="search-container" id="search-all-asset-container">

                            <input type="text" id="allAssetSearch" class="form-control" placeholder="Search...">

                            <ul id="allAssetDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                            <input type="hidden" id="selectedAllAssetId" name="allAssetSelectId" value="">
                            <!-- To store the selected soldier ID -->
                        </div>
                    </div>

                    <div class="btn-container" <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Asset type'))) { %> style="cursor: not-allowed" <% } %>>
                            <button
                                class="btn-add-type dropdown-toggle <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Asset type'))) { %> disabled-button <% } %>"
                                type="button" id="typeDropdownMenuButton" aria-expanded="false">
                                <i class="bi bi-gear"></i> Asset Type
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="typeDropdownMenuButton" id="selectTypeDropdown">
                                <li id="btnAddTypeAsset">Add Type</li>
                                <li id="btnRemoveTypeAsset">Remove Type</li>
                            </ul>
                    </div>

                    <div class="btn-container" <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Lost asset'))) { %> style="cursor: not-allowed" <% } %>>
                            <button type="button" id="btnLostAsset"
                                class="btn-add-type <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Lost asset'))) { %> disabled-button <% } %>">
                                <i class="bi bi-exclamation-circle"></i> Lost Asset
                            </button>
                            <div class="tooltip-custom">
                                <i class="bi bi-question-circle"></i>
                                <span class="tooltiptext">Report a lost asset.</span>
                            </div>
                    </div>

                    <div class="btn-container" <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Cleaning items'))) { %> style="cursor: not-allowed" <% } %>>
                            <button type="button" id="btnCleaningItem"
                                class="btn-add-type <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Cleaning items'))) { %> disabled-button <% } %>">
                                <i class="bi bi-bucket"></i> Cleaning Items
                            </button>
                            <div class="tooltip-custom">
                                <i class="bi bi-question-circle"></i>
                                <span class="tooltiptext">List with all cleaning item</span>
                            </div>
                    </div>

                    <div class="btn-container">
                        <button id="inventoryButton" class="btn-add-type">
                            <i class="bi bi-list-check"></i> <span>Inventory</span>
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Track the inventory process.</span>
                        </div>
                    </div>

                    <div class="btn-container">
                        <button id="reportButton" class="btn-add-type">
                            <i class="bi bi-file-earmark-text"></i> <span>Asset archive</span>
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">View the asset archive.</span>
                        </div>
                    </div>

                    <div class="button-container-report" <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Download asset app'))) { %> style="cursor: not-allowed;" <% }
                            %>>
                            <button type="button"
                                class="download-btn <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Download asset app'))) { %> disabled-button <% } %>"
                                id="downloadRFIDAppBtnAsset">
                                <i class="bi bi-download"></i> Download App
                            </button>
                    </div>

                </div>
            </div>

            <!-- Inventory Table -->
            <div class="table-container">
                <table id="data-table">
                    <thead>
                        <tr>
                            <th>
                                <input type="text" class="search-input" placeholder="Search...">
                                <label id="room-number-header">Room Number</label>
                            </th>

                            <th>
                                <input type="text" class="search-input" placeholder="Search...">
                                <label id="room-number-assets">Number of assets</label>
                            </th>
                        </tr>
                    </thead>

                    <% if (inventory) { %>
                        <tbody id="tableBody">
                            <% inventory.forEach(function(item) { %>
                                <tr class="data-room" id="<%= item.id %>">

                                    <td>
                                        <%= item.name %>
                                    </td>

                                    <td>
                                        <%= item.quantity %>
                                    </td>

                                    <% }); %>
                                </tr>
                        </tbody>
                        <% }; %>
                </table>
            </div>

            <nav aria-label="Table pagination">
                <ul id="pagination" class="pagination justify-content-center"></ul>
            </nav>
        </div>
    </div>

    <div id="assetsModal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>

            <h2>List of Assets
                <div class="btn-container" <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Add asset'))) { %> style="cursor: not-allowed;" <% } %>>
                        <button type="button"
                            class="btn btn-outline-success btn-sm rounded-circle fw-bold <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Add asset'))) { %> disabled-button <% } %>"
                            id="addAsset"><i class="bi bi-plus"></i></button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Add a new asset to the list.</span>
                        </div>
                </div>
                <div class="btn-container" <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Edit multi assets'))) { %> style="cursor: not-allowed;" <% } %>>
                        <button type="button"
                            class="btn btn-outline-primary btn-sm rounded-circle fw-bold <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Edit multi assets'))) { %> disabled-button <% } %>"
                            id="multiEditAsset"><i class="bi bi-pencil"></i></button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Edit multiple assets at once.</span>
                        </div>
                </div>
                <div class="btn-container" <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Remove asset'))) { %> style="cursor: not-allowed;" <% } %>>
                        <button type="button"
                            class="btn btn-outline-danger btn-sm rounded-circle fw-bold <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Remove asset'))) { %> disabled-button <% } %>"
                            id="removeAsset"><i class="bi bi-dash"></i></button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Remove an asset from the list.</span>
                        </div>
                </div>
            </h2>

            <div class="d-flex justify-content-end">
                <button type="button" id="prevBtnSecond"></button>
                <span id="pageNumberSecond"></span>
                <button type="button" id="nextBtnSecond"></button>
            </div>

            <div class="table-container">
                <table id="assetTable">
                    <thead>
                        <tr>
                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-code-header">Asset code</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-name-header">Asset name</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-type-header">Asset type</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-location-header">Asset location</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-description-header">Description</label>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="tableBodyModal">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="editAssetsModal" class="modal">
        <form class="modal-content" method="PATCH" action="/web/assets/editAsset" id="form1">
            <span class="close-btn">&times;</span>

            <h2 class="mb-4">Asset information</h2>

            <div class="row">
                <div class="col-md-2 mb-3 search-container" id="search-assert-container">
                    <label for="assetSearch" class="form-label">Asset code <span class="text-danger">*</span></label>
                    <input type="text" id="assetSearch" class="form-control" placeholder="Asset code">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="assetDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedAssetId" name="assetId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <div class="col-md-2 mb-3">
                    <label for="assetName" class="form-label">Asset name <span class="text-danger">*</span></label>
                    <input type="text" id="assetName" class="form-control" placeholder="Asset name"
                        pattern="^[a-zA-Z0-9\s]+$">
                </div>

                <div class="col-md-2 mb-3 search-container" id="search-type-container">
                    <label for="typeSearch" class="form-label">Asset type <span class="text-danger">*</span></label>
                    <input type="text" id="typeSearch" class="form-control" placeholder="Asset type">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="typeDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedTypeId" name="typeId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <div class="col-md-2 mb-3 search-container" id="search-location-container">
                    <label for="locationSearch" class="form-label">Asset location <span
                            class="text-danger">*</span></label>
                    <input type="text" id="locationSearch" class="form-control" placeholder="Asset location">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="locationDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedLocationId" name="locationId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <div class="col-md-2 mb-3 search-container" id="search-sub-location-container">
                    <label for="subLocationSearch" class="form-label">Associated key</label>
                    <input type="text" id="subLocationSearch" class="form-control" placeholder="Associated key">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="subLocationDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedSubLocationId" name="subLocationId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <div class="col-md-2 mb-3">
                    <label for="categorie" class="form-label">Asset categories</label>
                    <input type="text" id="categorie" class="form-control" placeholder="Asset categories"
                        pattern="^[a-zA-Z\s]*$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <div class="row">

                <div class="col-md-2 mb-3">
                    <label for="quantity" class="form-label">Asset quantity <span class="text-danger">*</span></label>
                    <input type="number" id="quantity" class="form-control" placeholder="Asset quantity" min="1"
                        value="1">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="mrah" class="form-label">MRAH</label>
                    <input type="text" id="mrah" class="form-control" placeholder="MRAH" pattern="^[a-zA-Z\s]*$"
                        value="Global RTS">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="owner" class="form-label">Asset owner</label>
                    <input type="text" id="owner" class="form-control" placeholder="Asset owner" pattern="^[a-zA-Z\s]*$"
                        value="Global RTS">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="status" class="form-label">Status</label>
                    <input id="status" class="form-control" placeholder="Status" value="New">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="expandable" class="form-label">Expandable</label>
                    <select id="expandable" class="form-control">
                        <option value="Expandable">Expandable</option>
                        <option value="Non Expandable" selected>Non Expandable</option>
                    </select>
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="service" class="form-label">Asset service</label>
                    <input type="text" id="service" class="form-control" placeholder="Asset service"
                        pattern="^[a-zA-Z\s]*$" value="Billeting">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

            </div>

            <div class="row">
                <div class="col-md-2 mb-3">
                    <label for="m2_inside" class="form-label">M2 Inside</label>
                    <input id="m2_inside" class="form-control" placeholder="M2 Inside" pattern="^([0-9]+,[0-9]+)?$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="date_purchase" class="form-label">Date Purchase</label>
                    <input type="date" id="date_purchase" class="form-control" placeholder="Date Purchase">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="date_written_off" class="form-label">Date Written Off</label>
                    <input type="date" id="date_written_off" class="form-control" placeholder="Date Written Off">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mt-3 d-flex align-items-center justify-content-center">
                    <input type="checkbox" id="is_fixed" class="me-2 column-toggle" value="false">
                    <label for="is_fixed" class="mb-0">Is Fixed</label>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="purchase_price" class="form-label">Purchase Price</label>
                    <input id="purchase_price" class="form-control" placeholder="Purchase Price"
                        pattern="^([0-9]+,[0-9]+)?$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="comments" class="form-label">Comments</label>
                    <input type="text" id="comments" class="form-control" placeholder="Comments"
                        pattern="^[a-zA-Z0-9\s]*$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

            </div>

            <div class="row">
                <div class="col-md-2 mb-3">
                    <label for="replaced_off" class="form-label">Replaced Off</label>
                    <input type="text" id="replaced_off" class="form-control" placeholder="Replaced Off"
                        pattern="^[a-zA-Z0-9\s]*$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="year_of_life_cycle" class="form-label">Year of Life Cycle</label>
                    <input type="number" id="year_of_life_cycle" class="form-control" placeholder="Year of Life Cycle"
                        min="1" value="1">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="rest_of_life_cycle" class="form-label">Rest of Life Cycle</label>
                    <input type="number" id="rest_of_life_cycle" class="form-control" placeholder="Rest of Life Cycle"
                        min="1" value="1">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="replaced_by" class="form-label">Replaced by</label>
                    <input type="text" id="replaced_by" class="form-control" placeholder="Replaced by"
                        pattern="^[a-zA-Z0-9\s]*$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="rest_value" class="form-label">Rest Value</label>
                    <input type="number" id="rest_value" class="form-control" placeholder="Rest Value" min="1"
                        value="1">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label for="description" class="form-label">Asset description</label>
                    <textarea id="description" class="form-control" placeholder="Asset description" rows="5"
                        style="max-height: 120px;"></textarea>
                </div>
            </div>

            <div <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Edit singel asset'))) { %> style="cursor: not-allowed;" <% } %>>
                    <button type="submit" class="modal-button <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Edit singel asset'))) { %> disabled-button <% } %>"
                        id="edit-button">
                        <i class="bi bi-pencil-square"></i> Edit
                    </button>
            </div>

        </form>
    </div>

    <div id="addAssetsModal" class="modal">
        <form class="modal-content" method="POST" action="/web/assets/addAsset" id="form2">
            <span class="close-btn">&times;</span>

            <h2 class="mb-4">Add asset</h2>

            <div class="row">
                <div class="col-md-2 mb-3" id="assert-epc-container">
                    <label for="assetEpc" class="form-label">Asset EPC code <span class="text-danger">*</span></label>
                    <input type="text" id="assetEpc" class="form-control" placeholder="Asset EPC code"
                        pattern="^[a-zA-Z0-9]+$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3" id="assert-code-container">
                    <label for="assetCodeSearch" class="form-label">Asset code <span
                            class="text-danger">*</span></label>
                    <input type="text" id="assetCodeSearch" class="form-control" placeholder="Asset code"
                        pattern="^[a-zA-Z0-9]+$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3">
                    <label for="assetAddName" class="form-label">Asset name <span class="text-danger">*</span></label>
                    <input type="text" id="assetAddName" class="form-control" placeholder="Asset name"
                        pattern="^[a-zA-Z0-9\s]+$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>

                <div class="col-md-2 mb-3 search-container" id="search-add-type-container">
                    <label for="addTypeSearch" class="form-label">Asset type <span class="text-danger">*</span></label>
                    <input type="text" id="addTypeSearch" class="form-control" placeholder="Asset type">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="addTypeDropdown" class="list-group"></ul>
                    <input type="hidden" id="selectedAddTypeId" name="typeId" value="">
                </div>

                <div class="col-md-2 mb-3 search-container" id="search-add-location-container">
                    <label for="addLocationSearch" class="form-label">Asset location <span
                            class="text-danger">*</span></label>
                    <input type="text" id="addLocationSearch" class="form-control" placeholder="Asset location">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="addLocationDropdown" class="list-group"></ul>
                    <input type="hidden" id="selectedAddLocationId" name="locationId" value="">
                </div>

                <div class="col-md-2 mb-3 search-container" id="search-add-sub-location-container">
                    <label for="addSubLocationSearch" class="form-label">Associated key</label>
                    <input type="text" id="addSubLocationSearch" class="form-control" placeholder="Associated key">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                    <ul id="addSubLocationDropdown" class="list-group"></ul>
                    <input type="hidden" id="selectedAddSubLocationId" name="subLocationId" value="">
                </div>
            </div>

            <div class="row">

                <div class="col-md-2 mb-3">
