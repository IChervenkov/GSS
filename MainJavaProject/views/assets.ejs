                            <label><input type="checkbox" class="column-toggle" data-column="asset-expandable-header"
                                    checked> Asset expandable</label>
                            <label><input type="checkbox" class="column-toggle" data-column="asset-description-header"
                                    checked> Asset description</label>
                        </div>
                    </div>
                </div>
            </h2>

            <!-- Left and Right Navigation Buttons -->
            <div class="d-flex justify-content-end mt-2 mb-2">
                <button type="button" id="prevBtn"></button>
                <span id="pageNumber"></span>
                <button type="button" id="nextBtn"></button>
            </div>

            <div class="table-container">
                <table id="assetsTable">
                    <thead>
                        <tr>
                            <th class="asset-rfid-header">
                                <input name="assetRfid" type="text" class="search-input-view-assets" placeholder="Search...">
                                <label>RFID</label>
                            </th>
                            <th class="asset-code-header">
                                <input name="assetCode" type="text" class="search-input-view-assets" placeholder="Search...">
                                <label>Asset code</label>
                            </th>
                            <th class="asset-name-header">
                                <input name="assetName" type="text" class="search-input-view-assets" placeholder="Search...">
                                <label>Asset Name</label>
                            </th>
                            <th class="asset-type-header">
                                <input name="assetType" type="text" class="search-input-view-assets" placeholder="Search...">
                                <label>Asset type</label>
                            </th>
                            <th class="asset-building-header">
                                <input name="assetBuilding" type="text" class="search-input-view-assets" placeholder="Search...">
                                <label>Building</label>
                            </th>
                            <th class="asset-room-header">
                                <input name="assetRoom" type="text" class="search-input-view-assets" placeholder="Search...">
