                            </th>
                            <th class="asset-category-header">
                                <input name="assetCategory" type="text" class="search-input-view-assets" placeholder="Search...">
                                <label>Asset category</label>
                            </th>
                            <th class="asset-quantity-header">
                                <input name="assetQuantity" type="text" class="search-input-view-assets" placeholder="Search...">
