<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/icon/logoPage.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/style/styleAssets.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
</head>

<body>

    <input type="hidden" id="numBuild" value="<%= numSelectBuild %>">

    <!-- Horizontal Navigation Bar -->
    <div class="horizontal-nav">
        <ul id="nav-links">
            <% horizontalNavItems.forEach(function(item) { %>
                <li><a href="<%= item.href %>">
                        <%= item.name %>
                    </a></li>
                <% }); %>
        </ul>
    </div>

    <div class="main-content">

        <div class="left-nav">
            <ul>
                <% navItems.forEach(function(item) { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a href="<%= item.href %>" class="flex-grow-1 text-decoration-none full-back">
                            <%= item.name %>
                        </a>
                    </li>
                    <% }); %>
            </ul>
        </div>

        <div class="content">

            <div class="visualization-header">
                <div class="row align-items-center gap-4">
                    <!-- Title and Count Beds Column -->
                    <div class="col-md-auto">
                        <h3 class="mb-0">
                            <!-- Title Row -->
                            <div>
                                <%= title %>
                            </div>
                        </h3>
                    </div>
                </div>

                <div class="virtual-warehouse-labels">
                    <button type="button" id="btnAddTypeAsset" class="btn-add-type">Add type</button>
                    <button type="button" id="btnRemoveTypeAsset" class="btn-add-type">Remove type</button>
                </div>
            </div>

            <!-- Inventory Table -->
            <div class="table-container">
                <table id="data-table">
                    <thead>
                        <tr>
                            <th>
                                <input type="text" class="search-input" placeholder="Search...">
                                <label id="room-number-header">Room Number</label>
                            </th>

                            <th>
                                <input type="text" class="search-input" placeholder="Search...">
                                <label id="room-number-assets">Number of assets</label>
                            </th>
                        </tr>
                    </thead>

                    <% if (inventory) { %>
                        <tbody id="tableBody">
                            <% inventory.forEach(function(item) { %>
                                <tr class="data-room" id="<%= item.id %>">

                                    <td>
                                        <%= item.name %>
                                    </td>

                                    <td>
                                        <%= item.quantity %>
                                    </td>

                                    <% }); %>
                                </tr>
                        </tbody>
                        <% }; %>
                </table>
            </div>

            <nav aria-label="Table pagination">
                <ul id="pagination" class="pagination justify-content-center"></ul>
            </nav>
        </div>
    </div>

    <div id="assetsModal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>

            <h2>List of Assets
                <button type="button" class="btn btn-outline-success btn-sm rounded-circle fw-bold" id="addAsset"><i
                        class="bi bi-plus"></i></button>
                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle fw-bold" id="removeAsset"><i
                        class="bi bi-dash"></i></button>
            </h2>

            <div class="table-container">
                <table id="assetTable">
                    <thead>
                        <tr>
                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-code-header">Asset code</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-name-header">Asset name</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-type-header">Asset type</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-location-header">Asset location</label>
                            </th>

                            <th>
                                <input type="text" class="asset-search-input" placeholder="Search...">
                                <label id="asset-sub-location-header">Associated key</label>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="tableBodyModal">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="editAssetsModal" class="modal">
        <form class="modal-content" method="POST", action="/assets/editAsset" id="form1">
            <span class="close-btn">&times;</span>

            <h2 class="mb-4">Asset information</h2>

            <div class="mb-3 search-container" id="search-assert-container">
                <label for="assetSearch" class="form-label">Assert code:</label>
                <div class="input-group">
                    <input type="text" id="assetSearch" class="form-control" placeholder="Asset code">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
                <ul id="assetDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                <input type="hidden" id="selectedAssetId" name="assetId" value="">
                <!-- To store the selected soldier ID -->
            </div>

            <div class="mb-3">
                <label for="assetName" class="form-label">Assert name:</label>
                <div class="input-group">
                    <input type="text" id="assetName" class="form-control" placeholder="Asset name" pattern="^[a-zA-Z0-9\s]+$">
                </div>
            </div>

            <div class="mb-3 search-container" id="search-type-container">
                <label for="typeSearch" class="form-label">Assert type:</label>
                <div class="input-group">
                    <input type="text" id="typeSearch" class="form-control" placeholder="Asset type">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
                <ul id="typeDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                <input type="hidden" id="selectedTypeId" name="typeId" value="">
                <!-- To store the selected soldier ID -->
            </div>

            <div class="mb-3 search-container" id="search-location-container">
                <label for="locationSearch" class="form-label">Assert location:</label>
                <div class="input-group">
                    <input type="text" id="locationSearch" class="form-control" placeholder="Asset location">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
                <ul id="locationDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                <input type="hidden" id="selectedLocationId" name="locationId" value="">
                <!-- To store the selected soldier ID -->
            </div>

            <div class="mb-3 search-container" id="search-sub-location-container">
                <label for="subLocationSearch" class="form-label">Associated key:</label>
                <div class="input-group">
                    <input type="text" id="subLocationSearch" class="form-control" placeholder="Associated key">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
                <ul id="subLocationDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                <input type="hidden" id="selectedSubLocationId" name="subLocationId" value="">
                <!-- To store the selected soldier ID -->
            </div>

            <button type="submit" class="modal-button" id="edit-button">Edit</button>

        </form>
    </div>

    <div id="addAssetsModal" class="modal">
        <form class="modal-content" method="POST", action="/assets/addAsset" id="form2">
            <span class="close-btn">&times;</span>

            <h2 class="mb-4">Add asset</h2>

            <div class="mb-3" id="assert-epc-container">
                <label for="assetEpc" class="form-label">Asset EPC code:</label>
                <div class="input-group">
                    <input type="text" id="assetEpc" class="form-control" placeholder="Asset EPC code", pattern="^[a-zA-Z0-9]+$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <div class="mb-3" id="assert-code-container">
                <label for="assetCodeSearch" class="form-label">Assert code:</label>
                <div class="input-group">
                    <input type="text" id="assetCodeSearch" class="form-control" placeholder="Asset code", pattern="^[a-zA-Z0-9]+$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <div class="mb-3">
                <label for="assetAddName" class="form-label">Assert name:</label>
                <div class="input-group">
                    <input type="text" id="assetAddName" class="form-control" placeholder="Asset name" pattern="^[a-zA-Z0-9\s]+$">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <div class="mb-3 search-container" id="search-add-type-container">
                <label for="addTypeSearch" class="form-label">Assert type:</label>
                <div class="input-group">
                    <input type="text" id="addTypeSearch" class="form-control" placeholder="Asset type">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
                <ul id="addTypeDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                <input type="hidden" id="selectedAddTypeId" name="typeId" value="">
                <!-- To store the selected soldier ID -->
            </div>

            <div class="mb-3 search-container" id="search-add-location-container">
                <label for="addLocationSearch" class="form-label">Assert location:</label>
                <div class="input-group">
                    <input type="text" id="addLocationSearch" class="form-control" placeholder="Asset location">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
                <ul id="addLocationDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                <input type="hidden" id="selectedAddLocationId" name="locationId" value="">
                <!-- To store the selected soldier ID -->
            </div>

            <div class="mb-3 search-container" id="search-add-sub-location-container">
                <label for="addSubLocationSearch" class="form-label">Associated key:</label>
                <div class="input-group">
                    <input type="text" id="addSubLocationSearch" class="form-control" placeholder="Associated key">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
                <ul id="addSubLocationDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                <input type="hidden" id="selectedAddSubLocationId" name="subLocationId" value="">
                <!-- To store the selected soldier ID -->
            </div>

            <button type="submit" class="modal-button" id="edit-button">Edit</button>

        </form>
    </div>

    <!-- The Modal Message -->
    <div id="myMessage" class="modal">
        <div class="modal-content-mess">
            <span class="close-btn">&times;</span>

            <img src="/icon/information.png" alt="Confirmation Image" class="modal-image" id="mess-icon">
            <p id="mess-text"></p>
        </div>
    </div>

</body>

<script src="/java/autoSearch.js"></script>
<script src="/java/pageNumber.js"></script>
<script src="/java/assetsInventory.js"></script>

</html>