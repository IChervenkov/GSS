                <span id="pageNumberDate"></span>
                <button type="button" id="nextBtnDate"></button>
            </div>

            <div class="table-container">
                <table id="assetDateTable">
                    <thead>
                        <tr>
                            <th><input name="date" type="text" class="search-input-view-assets-second" placeholder="Search...">Date
                            </th>
                            <th><input name="totalAsset" type="text" class="search-input-view-assets-second" placeholder="Search...">Total
                                Assets</th>
                            <th><input name="totalNewAsset" type="text" class="search-input-view-assets-second" placeholder="Search...">Total
                                New Assets</th>
                            <th><input name="totalUpdateAsset" type="text" class="search-input-view-assets-second" placeholder="Search...">Total
                                Update Assets</th>
                            <th><input name="totalRemoveAsset" type="text" class="search-input-view-assets-second" placeholder="Search...">Total
                                Remove Assets</th>
                            <th><input name="totalMissingAsset" type="text" class="search-input-view-assets-second" placeholder="Search...">Total
                                Missing Assets</th>
