                            </th>
                            <th class="asset-owner-header">
                                <input name="assetOwner" type="text" class="search-input-view-assets" placeholder="Search...">
                                <label>Asset owner</label>
                            </th>
                            <th class="asset-status-header">
                                <input name="assetStatus" type="text" class="search-input-view-assets" placeholder="Search...">
                                <label>Asset status</label>
                            </th>
                            <th class="asset-expandable-header">
                                <input name="assetExpandable" type="text" class="search-input-view-assets" placeholder="Search...">
