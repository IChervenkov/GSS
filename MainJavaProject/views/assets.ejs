                        <div class="dropdown-content">
                            <label><input type="checkbox" class="column-toggle" data-column="asset-rfid-header" checked>
                                RFID</label>
                            <label><input type="checkbox" class="column-toggle" data-column="asset-code-header" checked>
                                Asset code</label>
                            <label><input type="checkbox" class="column-toggle" data-column="asset-name-header" checked>
                                Asset name</label>
                            <label><input type="checkbox" class="column-toggle" data-column="asset-type-header" checked>
                                Asset type</label>
                            <label><input type="checkbox" class="column-toggle" data-column="asset-building-header"
