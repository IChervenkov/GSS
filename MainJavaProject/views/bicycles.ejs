<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bicycles</title>
  <link rel="stylesheet" href="/style/stylesBicycles.css" />
  <link rel="icon" href="/icon/logoPage.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

</head>

<body>
  <!-- Horizontal Navigation Bar -->
  <div class="horizontal-nav">
    <button type="button" class="menu-toggle" aria-label="Toggle horizontal navigation">&#9776; Menu</button>
    <ul id="nav-links">
      <% horizontalNavItems.forEach(item=> { %>
        <li>
          <a href="<%= item.href %>">
            <% if (item.name.toLowerCase()==='bicycles' ) { %>
              <i class="bi bi-bicycle"></i>
              <% } else if (item.name.toLowerCase()==='main page' ) { %>
                <i class="bi bi-house-door"></i>
                <% } else if (item.name.toLowerCase()==='assets' ) { %>
                  <i class="bi bi-box"></i>
                  <% } else if (item.name.toLowerCase()==='laundry' ) { %>
                    <i class="bi bi-water"></i>
                    <% } else if (item.name.toLowerCase()==='gym' ) { %>
                      <i class="bi bi-activity"></i>
                      <% } else if (item.name.toLowerCase()==='accommodation and keys' ) { %>
                        <i class="bi bi-key"></i>
                        <% } else if (item.name.toLowerCase()==='logout' ) { %>
                          <i class="bi bi-box-arrow-right"></i>
                          <% } %>
                            <span>
                              <%= item.name %>
                            </span>
          </a>
        </li>
        <% }); %>
    </ul>
  </div>

  <div id="loadingIndicator" class="loading-overlay" style="display: none;">
    <div class="spinner"></div>
  </div>

  <div class="main-content">

    <button type="button" id="menu-toggle-left" class="menu-toggle-left" aria-label="Toggle sidebar navigation">
      <span id="arrow">&#9651;</span> Setting parameters
    </button>

    <div class="left-nav">

      <!-- Bike Selection with Custom Search -->
      <div class="mb-3 search-container">
        <label for="bikeSearch" class="form-label">Bike </label>
        <div class="input-group">
          <input type="text" id="bikeSearch" class="form-control" placeholder="Search for a bike...">
          <div class="btn-container">
            <button class="btn btn-outline-secondary" type="button" id="searchButtonBike">
              <i class="fas fa-search"></i> <!-- Font Awesome search icon -->
            </button>
            <div class="tooltip-custom">
              <i class="bi bi-question-circle"></i>
              <span class="tooltiptext">Search<br>by<br>bike name</span>
            </div>
          </div>
        </div>
        <ul id="bikeDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
        <input type="hidden" id="selectedBikeId" name="bikeId" value=""> <!-- To store the selected bike ID -->
      </div>


      <!-- Client Selection with Custom Search -->
      <div class="mb-3 search-container">
        <label for="clientSearch" class="form-label">Client </label>
        <div class="input-group">
          <input type="text" id="clientSearch" class="form-control" placeholder="Search for a client...">
          <div class="btn-container">
            <button class="btn btn-outline-secondary" type="button" id="searchButtonClient">
              <i class="fas fa-search"></i> <!-- Font Awesome search icon -->
            </button>
            <div class="tooltip-custom">
              <i class="bi bi-question-circle"></i>
              <span class="tooltiptext">Search<br>by soldier<br>name</span>
            </div>
          </div>
        </div>
        <ul id="clientDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
        <input type="hidden" id="selectedClientId" name="clientId" value=""> <!-- To store the selected bike ID -->
      </div>

      <div class="calendar" id="calendarMain">
        <header>
          <h3></h3>
          <nav>
            <button type="button" id="prev"></button>
            <button type="button" id="next"></button>
          </nav>
        </header>
        <section>
          <ul class="days">
            <li>Sun</li>
            <li>Mon</li>
            <li>Tue</li>
            <li>Wed</li>
            <li>Thu</li>
            <li>Fri</li>
            <li>Sat</li>
          </ul>
          <ul class="dates"></ul>
        </section>
        <input class="show-date" id="selectedDateMail" value="None">
      </div>

      <!-- Buttons below the calendar -->
      <div class="button-container">
        <div class="btn-container w-100 w-md-auto">
          <button type="button" class="login-btn w-100 w-md-auto" id="rentBtn">
            <i class="bi bi-bag"></i> Rent
          </button>
          <div class="tooltip-custom">
            <i class="bi bi-question-circle"></i>
            <span class="tooltiptext">Rent a bike</span>
          </div>
        </div>
        <div class="btn-container w-100 w-md-auto">
          <button type="button" class="login-btn w-100 w-md-auto" id="returnBtn">
            <i class="bi bi-arrow-return-left"></i> Return
          </button>
          <div class="tooltip-custom">
            <i class="bi bi-question-circle"></i>
            <span class="tooltiptext">Return a bike</span>
          </div>
        </div>

        <input type="hidden" id="action" name="actionId" value="">
        <input type="hidden" id="date" name="dateId" value="">
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="content">
      <!-- Data Visualization Table -->
      <div class="visualization-header">
        <h3 class="d-flex align-items-center gap-2">
          <%= startMessage %>
            <div class="btn-container">
              <button type="button" class="btn btn-outline-success btn-sm rounded-circle fw-bold" id="addBike"><i
                  class="bi bi-plus"></i></button>
              <div class="tooltip-custom">
                <i class="bi bi-question-circle"></i>
                <span class="tooltiptext">Add a bike</span>
              </div>
            </div>
            <div class="btn-container">
              <button type="button" class="btn btn-outline-danger btn-sm rounded-circle fw-bold" id="removeBike"><i
                  class="bi bi-dash"></i></button>
              <div class="tooltip-custom">
                <i class="bi bi-question-circle"></i>
                <span class="tooltiptext">Remove a bike</span>
              </div>
            </div>
        </h3>

        <div class="virtual-warehouse-labels"> <label class="virtual-warehouse-label"
            style="pointer-events: none;">Total Bike: <%= totalBike %></label>

          <div class="btn-container">
            <label id="rentedBike" class="virtual-warehouse-label w-100 w-md-auto text-center">Rented: <%= rentedBike %>
            </label>
            <div class="tooltip-custom">
              <i class="bi bi-question-circle"></i>
              <span class="tooltiptext">Number and list <br> of rented bikes</span>
            </div>
          </div>
          <div class="btn-container">
            <label id="availableBike" class="virtual-warehouse-label w-100 w-md-auto text-center">Available: <%=
                availableBike %></label>
            <div class="tooltip-custom">
              <i class="bi bi-question-circle"></i>
              <span class="tooltiptext">Number and list <br> of available bikes</span>
            </div>
          </div>
          <div class="btn-container">
            <label id="repairBike" class="virtual-warehouse-label w-100 w-md-auto text-center">Repair: <%= repairBike %>
            </label>
            <div class="tooltip-custom">
              <i class="bi bi-question-circle"></i>
              <span class="tooltiptext">Number and list <br> of bikes under repair</span>
            </div>
          </div>
          <div class="btn-container">
            <label id="lateBike" class="virtual-warehouse-label w-100 w-md-auto text-center">Late: <%= lateBike %>
            </label>
            <div class="tooltip-custom">
              <i class="bi bi-question-circle"></i>
              <span class="tooltiptext">Number and list <br> of late bikes</span>
            </div>
          </div>
          <div class="btn-container">
            <label id="longTermBike" class="virtual-warehouse-label w-100 w-md-auto text-center">Long Term: <%=
                longTermBike %></label>
            <div class="tooltip-custom">
              <i class="bi bi-question-circle"></i>
              <span class="tooltiptext">Number and list <br> of long-term bikes</span>
            </div>
          </div>

          <div class="btn-container">
            <button type="button" id="btnReport" class="login-btn-report">
              <i class="bi bi-file-earmark-text"></i> Reports
            </button>
            <div class="tooltip-custom">
              <i class="bi bi-question-circle"></i>
              <span class="tooltiptext">Generate reports</span>
            </div>
          </div>
        </div>
        <div class="button-container-report">
          <button type="button" id="btnReportPhone" class="login-btn-report"><i class="bi bi-file-earmark-text"></i>
            Reports</button>
          <button type="button" class="download-btn <% if(username == 'guest') { %> disabled-button <% } %>"
            id="downloadBtn"><i class="bi bi-download"></i> Download App</button>
        </div>
      </div>

      <div class="table-container">
        <table id="mainTable">
          <thead>
            <tr>
              <th>Bike Name</th>
              <th>Status</th>
              <th>Hired by</th>
              <th>Date From</th>
            </tr>
          </thead>
          <% if (data) { %>
            <tbody id="tableBody">
              <% data.forEach(function(item) { %>
                <tr class="data-bike">
                  <td>
                    <%= item.name %>
                  </td>
                  <td data-status="<%= item.status %>">
                    <% if(item.status=="Available" ) { %>
                      <img src="/icon/available.png" alt="Available" class="table-icon">
                      <% } %>

                        <% if(item.status=="Rented" ) { %>
                          <img src="/icon/unavailable.png" alt="Rented" class="table-icon">
                          <% } %>

                            <% if(item.status=="Repair" ) { %>
                              <img src="/icon/repire.png" alt="Repair" class="table-icon">
                              <% } %>

                                <% if(item.status=="Late" ) { %>
                                  <img src="/icon/timeout.png" alt="Late" class="table-icon">
                                  <% } %>

                                    <% if(item.status=="Long term" ) { %>
                                      <img src="/icon/long-term.png" alt="Long-term" class="table-icon">
                                      <% } %>
                  </td>
                  <td>
                    <%= item.hiredby %>
                  </td>
                  <td>
                    <%= item.datefrom %>
                  </td>
                </tr>
                <% }); } %>
            </tbody>
        </table>
      </div>

      <nav aria-label="Table pagination">
        <ul id="pagination" class="pagination justify-content-center"></ul>
      </nav>

    </div>
  </div>

  <!-- The Modal -->
  <div id="myModal" class="modal">
    <div class="modal-content">
      <span class="close">&times;</span>
      <label>Select Date:</label>
      <p name="modalText" id="modalText">None</p>

      <!-- Bike and Client Labels Inside the Modal -->
      <div class="bike-client-selection">
        <div class="mb-3">
          <label class="form-label">Bike:</label>
          <label class="none-selected" id="modalBikeLabel">None</label> <!-- Default set to "None" -->
        </div>

        <div class="mb-3">
          <label id="labelClient" class="form-label">Client:</label>
          <label class="none-selected" id="modalClientLabel">None</label> <!-- Default set to "None" -->
        </div>
      </div>

      <!-- Hour and Minute Select Fields Inside the Modal -->
      <div class="time-selection">
        <div class="mb-3">
          <label for="hourSelect" class="form-label">Hour <span class="text-danger">*</span></label>
          <select name="hourSelectId" class="form-select" id="hourSelect" aria-label="Select Hour">
            <option selected>Select Hour</option>
            <% optionHour.forEach(function(item) { %>
              <option value="<%= item.value %>">
                <%= item.name %>
              </option>
              <% }); %>
          </select>
        </div>

        <div class="mb-3">
          <label for="minuteSelect" class="form-label">Minutes <span class="text-danger">*</span></label>
          <select name="minuteSelect" class="form-select" id="minuteSelect" aria-label="Select Minutes">
            <option selected>Select Minutes</option>
            <% optionMinute.forEach(function(item) { %>
              <option value="<%= item.value %>">
                <%= item.name %>
              </option>
              <% }); %>
          </select>
        </div>
      </div>

      <!-- Checkbox and "Check" Button -->
      <div class="checkbox-container">
        <input type="checkbox" id="confirmationCheckbox">
        <label class="form-check-label" for="confirmationCheckbox" id="confirmationCheckboxLabel"></label>

        <input type="checkbox" id="longTermCheckbox" name="ltstatus" value="false">
        <label class="form-check-label" for="longTermCheckbox" id="longTermCheckboxLabel">Long term</label>
      </div>

      <!-- "Check" Button in New Line -->
      <div class="button-container " <% if(username=='guest' ) { %> style="cursor: not-allowed" <% } %>>
          <button type="button" id="checkBtn" class="login-btn <% if(username == 'guest') { %> disabled-button <% } %>">
            <i class="bi bi-save"></i> Save
          </button>
      </div>
    </div>
  </div>


  <!-- The Modal Message -->
  <form action="/bikeAction" method="POST" id="form1">
    <div id="myMessage" class="modal">
      <div class="modal-content-mess">
        <span class="close">&times;</span>

        <img src="/icon/information.png" alt="Confirmation Image" class="modal-image" id="mess-icon">
        <p id="mess-text">Are you sure you want to proceed?</p>
        <div class="button-container-mess">
          <button id="btnYes" type="submit" class="login-btn-mess confirm-btn">Ok</button>
        </div>
      </div>
    </div>

  </form>

  <!-- The Modal for Reports -->
  <div id="reportModal" class="modal">
    <div class="modal-content-multi-calendar">
      <span class="close">&times;</span>
      <h3 class="header-modal-report">Reports - Select Date Range (From/To Date)</h3>

      <!-- Container for two side-by-side calendars -->
      <div class="calendar-container">
        <div class="calendar" id="calendar1">
          <header>
            <h3></h3>
            <nav>
              <button type="button" id="prev"></button>
              <button type="button" id="next"></button>
            </nav>
          </header>
          <section>
            <ul class="days">
              <li>Sun</li>
              <li>Mon</li>
              <li>Tue</li>
              <li>Wed</li>
              <li>Thu</li>
              <li>Fri</li>
              <li>Sat</li>
            </ul>
            <ul class="dates"></ul>
          </section>
        </div>

        <div class="calendar" id="calendar2">
          <header>
            <h3></h3>
            <nav>
              <button type="button" id="prev"></button>
              <button type="button" id="next"></button>
            </nav>
          </header>
          <section>
            <ul class="days">
              <li>Sun</li>
              <li>Mon</li>
              <li>Tue</li>
              <li>Wed</li>
              <li>Thu</li>
              <li>Fri</li>
              <li>Sat</li>
            </ul>
            <ul class="dates"></ul>
          </section>
        </div>
      </div>

      <!-- Buttons for confirming the selection -->
      <div class="button-container">
        <button id="confirmReportBtn" class="login-btn">View Report</button>
      </div>
    </div>
  </div>

  <!-- The Modal for Reports View -->
  <div id="reportViewModal" class="modal">
    <form class="modal-content-view" action="/bicycles/report" method="POST" id="form2">
      <span class="close">&times;</span>
      <h3 class="header-modal-report">Reports View</h3>

      <!-- Left and Right Navigation Buttons -->
      <div class="d-flex justify-content-end mt-2 mb-2">
        <button type="button" id="prevBtn"></button>
        <span id="pageNumber"></span>
        <button type="button" id="nextBtn"></button>
      </div>

      <div class="table-container">
        <table id="bikeUsageTable">
          <thead>
            <tr>
              <th><input name="namebike" type="text" class="search-input-view-bike" placeholder="Search...">Bike Name</th>
              <th><input name="namesoldier" type="text" class="search-input-view-bike" placeholder="Search...">Soldier Name</th>
              <th><input name="date_from" type="text" class="search-input-view-bike" placeholder="Search...">Date From</th>
              <th><input name="date_to" type="text" class="search-input-view-bike" placeholder="Search...">Date To</th>
              <th><input name="duration" type="text" class="search-input-view-bike" placeholder="Search...">Duration</th>
            </tr>
          </thead>
          <tbody>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-end mt-2 mb-2">
        <button type="button" id="prevBtnDate"></button>
        <span id="pageNumberDate"></span>
        <button type="button" id="nextBtnDate"></button>
      </div>

      <div class="table-container">
        <table id="bikeTotalsTable">
          <thead>
            <tr>
              <th>
                <div class="header-cell"><input name="date" type="text" class="search-input-view-total-bike"
                    placeholder="Search..."><span>Date</span></div>
              </th>
              <th>
                <div class="header-cell"><input name="total_bikes" type="text" class="search-input-view-total-bike"
                    placeholder="Search..."><span>Total Bikes Used</span></div>
              </th>
            </tr>
          </thead>
          <tbody>
          </tbody>
        </table>
      </div>

      <input name="selectedDate1" class="show-date" id="selectedDate1" value="None">
      <input name="selectedDate2" class="show-date" id="selectedDate2" value="None">

      <!-- Buttons for confirming the selection -->
      <div class="button-container">
        <button type="submit" class="login-btn">Generate Report</button>
      </div>

    </form>
  </div>

  <!-- The Modal for Reports -->
  <div id="totalRentBikeModal" class="modal">
    <div class="modal-content-total-info">
      <span class="close">&times;</span>
      <h3 class="header-modal-report">All Rented Bike</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Id</th>
              <th>Bike Name</th>
              <th>Hired by</th>
            </tr>
          </thead>
          <% if (data) { %>
            <tbody>
              <% data.forEach(function(item, index) { if (item.status==="Rented" ) {%>
                <tr>
                  <td>
                    <%= index + 1 %>
                  </td>
                  <td>
                    <%= item.name %>
                  </td>
                  <td>
                    <%= item.hiredby %>
                  </td>
                </tr>
                <% } %>
                  <% }); } %>
            </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- The Modal for Reports -->
  <div id="totalAvailableBikeModal" class="modal">
    <div class="modal-content-total-info">
      <span class="close">&times;</span>
      <h3 class="header-modal-report">All Available Bike</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Id</th>
              <th>Bike Name</th>
              <th>Hired by</th>
            </tr>
          </thead>
          <% if (data) { %>
            <tbody>
              <% data.forEach(function(item, index) { if (item.status==="Available" ) {%>
                <tr>
                  <td>
                    <%= index + 1 %>
                  </td>
                  <td>
                    <%= item.name %>
                  </td>
                  <td>
                    <%= item.hiredby %>
                  </td>
                </tr>
                <% } %>
                  <% }); } %>
            </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- The Modal for Reports -->
  <div id="totalRepireBikeModal" class="modal">
    <div class="modal-content-total-info">
      <span class="close">&times;</span>
      <h3 class="header-modal-report">All Repire Bike</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Id</th>
              <th>Bike Name</th>
              <th>Hired by</th>
            </tr>
          </thead>
          <% if (data) { %>
            <tbody>
              <% data.forEach(function(item, index) { if (item.status==="Repair" ) {%>
                <tr>
                  <td>
                    <%= index + 1 %>
                  </td>
                  <td>
                    <%= item.name %>
                  </td>
                  <td>
                    <%= item.hiredby %>
                  </td>
                </tr>
                <% } %>
                  <% }); } %>
            </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- The Modal for Reports -->
  <div id="totalLateBikeModal" class="modal">
    <div class="modal-content-total-info">
      <span class="close">&times;</span>
      <h3 class="header-modal-report">All Late Bike</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Id</th>
              <th>Bike Name</th>
              <th>Hired by</th>
            </tr>
          </thead>
          <% if (data) { %>
            <tbody>
              <% data.forEach(function(item, index) { if (item.status==="Late" ) {%>
                <tr>
                  <td>
                    <%= index + 1 %>
                  </td>
                  <td>
                    <%= item.name %>
                  </td>
                  <td>
                    <%= item.hiredby %>
                  </td>
                </tr>
                <% } %>
                  <% }); } %>
            </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- The Modal for Reports -->
  <div id="totalLongTermBikeModal" class="modal">
    <div class="modal-content-total-info">
      <span class="close">&times;</span>
      <h3 class="header-modal-report">All Long Term Bike</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Id</th>
              <th>Bike Name</th>
              <th>Hired by</th>
            </tr>
          </thead>
          <% if (data) { %>
            <tbody>
              <% data.forEach(function(item, index) { if (item.status==="Long term" ) {%>
                <tr>
                  <td>
                    <%= index + 1 %>
                  </td>
                  <td>
                    <%= item.name %>
                  </td>
                  <td>
                    <%= item.hiredby %>
                  </td>
                </tr>
                <% } %>
                  <% }); } %>
            </tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="searchBikeModal" class="modal">
    <div class="modal-content-total-info">
      <span class="close">&times;</span>
      <h3 class="header-modal-report">History of the bike</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Client Name</th>
              <th>Date From</th>
              <th>Date To</th>
            </tr>
          </thead>
        </table>
      </div>
    </div>
  </div>

  <div id="searchClientModal" class="modal">
    <div class="modal-content-total-info">
      <span class="close">&times;</span>
      <h3 class="header-modal-report">History of the soldier</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Bike Name</th>
              <th>Date From</th>
              <th>Date To</th>
            </tr>
          </thead>
        </table>
      </div>
    </div>
  </div>

  <!-- The Modal for Add Soldier -->
  <div id="addBikeModal" class="modal">
    <form class="modal-content" action="/bicycles/addBike" method="POST" id="form3">
      <span class="close">&times;</span>

      <h2>Add bike</h2>

      <div class="mb-3">
        <label for="bike-number" class="form-label">Bike Number <span class="text-danger">*</span></label>
        <input type="text" id="bike-number" name="bikeAddId" class="form-control"
          placeholder="Bike number (e.g., AB1234)" pattern="^[A-Za-z0-9]+$">
        <div class="invalid-feedback"></div>
        <div class="valid-feedback"></div>
      </div>

      <div class="mb-3">
        <label for="bike-name" class="form-label">Bike Name <span class="text-danger">*</span></label>
        <input type="text" id="bike-name" name="bikeName" class="form-control"
          placeholder="Bike name (e.g., 123/Bike Model)" pattern="^[0-9]+\/[A-Za-z\s]+$">
        <div class="invalid-feedback"></div>
        <div class="valid-feedback"></div>
      </div>

      <!-- Buttons for confirming the selection -->
      <div class="button-container" <% if(username=='guest' ) { %> style="cursor: not-allowed" <% } %>>
          <button type="submit" id="confirmAddBikeBtn"
            class="login-btn <% if(username == 'guest') { %> disabled-button <% } %>">
            <i class="bi bi-plus-circle"></i> Add bicycle
          </button>
          <button type="button" id="confirmAddMultiBikeBtn"
            class="login-btn <% if(username == 'guest') { %> disabled-button <% } %>">
            <i class="bi bi-plus-circle"></i> Add multiple bicycles
          </button>
      </div>

    </form>
  </div>

  <!-- The Modal for Add Soldier -->
  <div id="removeBikeModal" class="modal">
    <form class="modal-content" action="/bicycles/removeBike" method="POST" id="form4">
      <span class="close">&times;</span>

      <h2>Remove bike</h2>

      <!-- Bike Selection with Custom Search -->
      <div class="mb-3 search-container">
        <label for="removeBikeSearch" class="form-label">Bike Name <span class="text-danger">*</span></label>
        <input type="text" id="removeBikeSearch" class="form-control" placeholder="Bike Name">
        <div class="invalid-feedback"></div>
        <div class="valid-feedback"></div>
        <ul id="removeBikeDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
        <input type="hidden" id="selectedRemoveBikeId" name="removeBikeId" value="">
        <!-- To store the selected bike ID -->
      </div>

      <!-- Buttons for confirming the selection -->
      <div class="button-container" <% if(username=='guest' ) { %> style="cursor: not-allowed" <% } %>>
          <button type="submit" id="confirmRemoveBikeBtn"
            class="login-btn <% if(username == 'guest') { %> disabled-button <% } %>">
            <i class="bi bi-trash"></i> Remove bicycle
          </button>
      </div>

    </form>
  </div>

  <!-- Modal Structure -->
  <div id="addMultiBikeModal" class="modal">
    <div class="modal-content">
      <span class="close">&times;</span>

      <h2>Add multiple bicycles <a href="/bicycles/multiBike/download"><i class="bi bi-download"></i></a></h2>

      <div class="mb-3">
        <label for="fileInputBike" class="form-label">Upload File <span class="text-danger">*</span></label>
        <input type="file" id="fileInputBike" class="form-control" accept=".xlsx">
        <!-- Accept specific file types -->
      </div>

      <div class="progress-bar">
        <div class="custom-progress" id="progress-multi-bike">
        </div>
      </div>

      <button type="button" id="upload-multi-bike-btn" class="login-btn">
        <i class="bi bi-upload"></i> Upload
      </button>
    </div>
  </div>

  <div id="bikeEditModal" class="modal">
    <form action="/bicycles/editBike" method="POST" class="modal-content" id="form5">
      <span class="close">&times;</span>

      <h2>Edit Bike</h2>

      <!-- Bike Selection with Custom Search -->
      <div class="mt-3 mb-3 search-container" id="search-bike-container">
        <p id="editBikeSearch" class="form-label text-start d-block">Bike Name:</p>
      </div>

      <!-- Bag Selection with Custom Search -->
      <div class="mb-3">
        <label for="statusSelect" class="form-label text-start d-block">Status <span
            class="text-danger">*</span></label>
        <select name="statusSelectId" class="form-select" id="statusSelect" aria-label="Select Status">
          <option selected>Select Status</option>
          <option value="Rented">Rented</option>
          <option value="Repair">Repair</option>
          <option value="Late">Late</option>
          <option value="Long term">Long term</option>
        </select>
        <div class="invalid-feedback"></div>
        <div class="valid-feedback"></div>
      </div>

      <!-- Soldier Selection with Custom Search -->
      <div class="mt-3 mb-3 search-container" id="search-Soldier-container">
        <label class="form-label text-start d-block">Soldier Name <span class="text-danger">*</span></label>
        <input type="text" id="editSoldierSearch" class="form-control" placeholder="Soldier Name">
        <ul id="editSoldierDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
        <input type="hidden" id="selectedEditSoldierId" name="editSoldierId" value="">
        <!-- To store the selected Soldier ID -->
      </div>

      <!-- Soldier Selection with Custom Search -->
      <div class="mt-3 mb-3 search-container">
        <label for="editDateFrom" class="form-label text-start d-block">Date From <span
            class="text-danger">*</span></label>
        <input type="datetime-local" id="editDateFrom" class="form-control" placeholder="Date From">
      </div>

      <!-- Label for Country -->
      <p class="modal-labal-info" id="modal-country"></p>
      <input type="hidden" id="country-value" name="countryId" value="">

      <input type="hidden" id="isAccommodation" value="false">

      <button type="submit" class="login-btn" id="save-button">
        <i class="bi bi-save"></i> Save
      </button>
    </form>
  </div>
  </div>

  <div id="myMessageReport" class="modal">
    <div class="modal-content-mess">
      <span class="close">&times;</span>

      <img src="/icon/information.png" alt="Confirmation Image" class="modal-image" id="mess-icon-rep">
      <p id="mess-text-rep">Are you sure you want to proceed?</p>
      <div class="button-container-mess">
        <button id="btnMess" class="login-btn-mess confirm-btn">Ok</button>
      </div>
    </div>
  </div>

  <% if(username !='guest' ) { %>
    <div id="pinned-message" class="pinned-message" style="display: none;">
      <p id="pinned-message-text"></p>
      <button id="close-pinned-message">✖</button>
    </div>
    <% } %>

</body>

<script src="/java/autoSearch.js"></script>
<script src="/java/pageNumber.js"></script>
<script src="/java/downloald-app.js"></script>
<script src="/java/modal_wind.js"></script>
<script src="/java/calendar.js" defer></script>
<script src="/java/phoneMenu.js"></script>

<% if(username !='guest' ) { %>
  <script src="/java/showPinMessage.js"></script>
  <% } %>

</html>