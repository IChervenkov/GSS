<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" href="/icon/logoPage.png">
    <link rel="stylesheet" href="/style/styleAccommodation.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

</head>

<body>

    <input type="hidden" id="curent-dest" value="<%= numBuild %>">

    <!-- Horizontal Navigation Bar -->
    <div class="horizontal-nav">
        <button type="button" class="menu-toggle" aria-label="Toggle horizontal navigation">&#9776; Menu</button>
        <ul id="nav-links">
            <% horizontalNavItems.forEach(item=> { %>
                <li>
                    <a href="<%= item.href %>">
                        <% if (item.name.toLowerCase()==='bicycles' ) { %>
                            <i class="bi bi-bicycle"></i>
                            <% } else if (item.name.toLowerCase()==='main page' ) { %>
                                <i class="bi bi-house-door"></i>
                                <% } else if (item.name.toLowerCase()==='assets' ) { %>
                                    <i class="bi bi-box"></i>
                                    <% } else if (item.name.toLowerCase()==='laundry' ) { %>
                                        <i class="bi bi-water"></i>
                                        <% } else if (item.name.toLowerCase()==='gym' ) { %>
                                            <i class="bi bi-activity"></i>
                                            <% } else if (item.name.toLowerCase()==='accommodation and keys' ) { %>
                                                <i class="bi bi-key"></i>
                                                <% } else if (item.name.toLowerCase()==='logout' ) { %>
                                                    <i class="bi bi-box-arrow-right"></i>
                                                    <% } %>
                                                        <span>
                                                            <%= item.name %>
                                                        </span>
                    </a>
                </li>
                <% }); %>
        </ul>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">

        <button type="button" id="menu-toggle-left" class="menu-toggle-left" aria-label="Toggle sidebar navigation">
            <span id="arrow">&#9651;</span> Setting parameters
        </button>

        <!-- Left Navigation Bar -->
        <div class="left-nav">
            <div class="title-container mb-2 sticky-top w-100 bg-light" <% if(username !='helpDeskNikolay' && username
                !='helpDeskAngel' && username !='admin' ) { %> style="cursor: not-allowed" <% } %>>
                    <div class="btn-container" style="width: 100%;">
                        <button type="button" id="btnAddDestination"
                            class="btn-add-destination w-100 <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin') { %> disabled-button <% } %>">
                            <i class="bi bi-plus-circle"></i> Add Destination
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Add building to the list of destinations</span>
                        </div>
                    </div>
            </div>
            <ul>
                <% navItems.forEach(function(item) { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <button id="<%= item.id %>" class="flex-grow-1 text-decoration-none full-back main-button">
                            <%= item.name %>
                                <span class="name-add d-block">
                                    <%= item.nameAdd %>
                                </span>
                        </button>
                        <div class="button-group" <% if(username !='helpDeskNikolay' && username !='helpDeskAngel' &&
                            username !='admin' ) { %>
                            style="cursor: not-allowed" <% } %>>
                                <button type="button"
                                    class="btn btn-success btn-sm me-1 btn-add <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin') { %> disabled-button <% } %>"
                                    numberBuild="<%= item.nameBuilding %>" name="<%= item.numBuild %>"><i
                                        class="bi bi-plus"></i></button>
                                <button type="button"
                                    class="btn btn-danger btn-sm btn-remove <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin') { %> disabled-button <% } %>"
                                    name="<%= item.numBuild %>"><i class="bi bi-dash"></i></button>
                                <% if(item.numBuild) { %>
                                    <button type="button"
                                        class="btn btn-outline-secondary btn-sm <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin') { %> disabled-button <% } %>"
                                        name="<%= item.numBuild %>" data-name-room="<%= item.name %>">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <% } %>
                        </div>
                    </li>
                    <% }); %>
            </ul>
        </div>

        <!-- Main Content Area -->
        <div class="content">

            <div class="visualization-header">
                <div class="row align-items-center gap-4">
                    <!-- Title and Count Beds Column -->
                    <div class="col-md-auto">
                        <h3 class="mb-0">
                            <!-- Title Row -->
                            <div>
                                <%= titlePage %>
                            </div>

                            <div class="name-add">
                                <!-- Count Beds Row -->
                                <% if(countBeds) { %>
                                    (<%= countBeds %> free beds)
                                        <% }; %>
                            </div>
                        </h3>
                    </div>

                </div>

                <div class="virtual-warehouse-labels">
                    <!-- Search Column -->
                    <div class="col-md">
                        <!-- Soldier Selection with Custom Search -->
                        <div class="search-container" id="search-all-key-container">

                            <input type="text" id="allKeySearch" class="form-control" placeholder="Search...">

                            <ul id="allKeyDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                            <input type="hidden" id="selectedAllKeyId" name="allKeySelectId" value="">
                            <!-- To store the selected soldier ID -->
                        </div>
                    </div>

                    <label class="virtual-warehouse-label">Free Beds: <%= totalFreeBeds %></label>
                    <label class="virtual-warehouse-label">Occupied Beds: <%= totalOccupiedBeds %></label>

                    <div <% if(username !='helpDeskNikolay' && username !='helpDeskAngel' && username !='admin' &&
                        username !='helpDeskElena' ) { %>
                        style="cursor: not-allowed" <% } %>>
                            <div class="btn-container w-100 w-md-auto">
                                <button type="button" id="btnListSoldier"
                                    class="btn-add-soldier <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin' && username !='helpDeskElena') { %> disabled-button <% } %>">
                                    <i class="bi bi-person"></i> List of soldier
                                </button>
                                <div class="tooltip-custom">
                                    <i class="bi bi-question-circle"></i>
                                    <span class="tooltiptext">List of soldiers in the system</span>
                                </div>
                            </div>
                    </div>
                    <div <% if(username !='helpDeskNikolay' && username !='helpDeskAngel' && username !='admin' &&
                        username !='helpDeskElena' ) { %>
                        style="cursor: not-allowed" <% } %>>
                            <div class="btn-container w-100 w-md-auto">
                                <button type="button" id="btnAccommSoldier"
                                    class="btn-add-soldier <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin' && username !='helpDeskElena') { %> disabled-button <% } %>">
                                    <i class="bi bi-person-fill"></i> Accommodation soldiers
                                </button>
                                <div class="tooltip-custom">
                                    <i class="bi bi-question-circle"></i>
                                    <span class="tooltiptext">Accommodation multiple of soldiers</span>
                                </div>
                            </div>
                    </div>
                    <div <% if(username !='helpDeskNikolay' && username !='helpDeskAngel' && username !='admin' &&
                        username !='helpDeskElena' ) { %>
                        style="cursor: not-allowed" <% } %>>
                            <div class="btn-container w-100 w-md-auto">
                                <button type="button" id="btnFreeAllRoom"
                                    class="btn-free-soldier <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin') { %> disabled-button <% } %>">
                                    <i class="bi bi-building"></i> Release building
                                </button>
                                <div class="tooltip-custom">
                                    <i class="bi bi-question-circle"></i>
                                    <span class="tooltiptext">Release all rooms in selected building</span>
                                </div>
                            </div>
                    </div>
                    <div class="btn-container">
                        <button type="button" id="btnReport" class="btn-report">
                            <i class="bi bi-file-earmark-text"></i> Reports
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Generate reports</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Visualization Table -->

            <% if(headerTable) { %>
                <div class="table-container">
                    <table id="data-table">
                        <thead>
                            <tr>
                                <th>
                                    <input type="text" class="search-input" placeholder="Search...">
                                    <label id="room-number-header">Room Number</label>
                                </th>

                                <th>
                                    <input type="text" class="search-input" placeholder="Search...">
                                    <label id="room-status-header">Room Status</label>
                                </th>

                                <th>
                                    <input type="text" class="search-input" placeholder="Search...">
                                    <label id="count-free-beds-header">Count Free Beds</label>
                                </th>
                            </tr>
                        </thead>

                        <% if (nameroomSetCount) { %>
                            <tbody id="tableBody">
                                <% nameroomSetCount.forEach(function(item) { %>
                                    <tr class="data-room">

                                        <td>
                                            <%= item.nameroom %>
                                        </td>

                                        <td class="<%= item.countFreeBeds != 0 ? 'undefined-data' : '' %>">
                                            <%= item.countFreeBeds !=0 ? 'Free' : 'Occupied' %>
                                        </td>

                                        <td>
                                            <%= item.countFreeBeds %>
                                        </td>

                                    </tr>
                                    <% }); %>
                            </tbody>
                    </table>
                </div>

                <nav aria-label="Table pagination">
                    <ul id="pagination" class="pagination justify-content-center"></ul>
                </nav>

                <% } } %>

        </div>
    </div>

    <input type="hidden" id="typeBuild" value="<%= type %>">
    <input type="hidden" id="previewTypeBuild" value="<%= type %>">
    <input type="hidden" id="numBuild" value="<%= numBuild %>">

    <!-- The Modal for Reports View -->
    <div id="keyModal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>

            <h2>List of Keys
                <div class="btn-container" <% if(username !='helpDeskNikolay' && username !='helpDeskAngel' && username
                    !='admin' && username !='helpDeskElena' ) { %>
                    style="cursor: not-allowed" <% } %>>
                        <button type="button"
                            class="btn btn-outline-success btn-sm rounded-circle fw-bold <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin' && username !='helpDeskElena') { %> disabled-button <% } %>"
                            id="addKey"><i class="bi bi-plus"></i></button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Add key</span>
                        </div>
                </div>
                <div class="btn-container" <% if(username !='helpDeskNikolay' && username !='helpDeskAngel' && username
                    !='admin' && username !='helpDeskElena' ) { %>
                    style="cursor: not-allowed" <% } %>>
                        <button type="button"
                            class="btn btn-outline-primary btn-sm rounded-circle fw-bold <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin' && username !='helpDeskElena') { %> disabled-button <% } %>"
                            id="removeKey"><i class="bi bi-arrow-repeat"></i></button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Reload keys</span>
                        </div>
                </div>
            </h2>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <% headerTable.forEach(function(item) { %>
                                <th>
                                    <%= item.name %>
                                </th>
                                <% }); %>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <form id="form1" action="/saveKey" method="post">

        <!-- Modal Structure -->

        <div id="roomModal" class="modal">
            <div class="modal-content mt-0">
                <span class="close-btn">&times;</span>

                <h2>Room Information</h2>

                <!-- Label for Key Number -->
                <p class="modal-labal-info" id="modal-keynum"></p>

                <!-- Label for Key Number -->
                <p class="modal-labal-info" id="modal-keycode"></p>
                <input type="hidden" id="key-code-value" name="keyCodeId" value="">

                <!-- Soldier Selection with Custom Search -->
                <div class="mb-3 search-container" id="search-soldier-container">
                    <label for="soldierSearch" class="form-label">Soldier Name:</label>

                    <input type="text" id="soldierSearch" class="form-control" placeholder="Soldier Name">

                    <ul id="soldierDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedSoldierId" name="soldierId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <!-- Bag Selection with Custom Search -->
                <div class="mb-3 search-container" id="search-laundry-bag-container">
                    <label for="laundryBagSearch" class="form-label">Laundry Bag:</label>

                    <input type="text" id="laundryBagSearch" class="form-control" placeholder="Laundry Bag">

                    <ul id="bagDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedBagId" name="bagId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <div class="mb-3" id="input-meal-card">
                    <label for="meal-card-value" class="form-label">Meal card:</label>

                    <input type="text" id="meal-card-value" name="mealCardId" class="form-control"
                        placeholder="Meal card" value="">

                </div>

                <!-- Label for Country -->
                <p class="modal-labal-info" id="modal-country"></p>
                <input type="hidden" id="country-value" name="countryId" value="">

                <input type="hidden" id="isAccommodation" value="false">

                <div class="btn-container" <% if(username !='helpDeskNikolay' && username !='helpDeskAngel' && username
                    !='admin' && username !='helpDeskElena' ) { %>
                    style="cursor: not-allowed" <% } %>>
                        <button type="submit"
                            class="modal-button <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin' && username !='helpDeskElena') { %> disabled-button <% } %>"
                            id="save-button">
                            <i class="bi bi-save"></i> Save
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Save soldier to the room</span>
                        </div>
                </div>
                <div class="btn-container" <% if(username !='helpDeskNikolay' && username !='helpDeskAngel' && username
                    !='admin' && username !='helpDeskElena' ) { %>
                    style="cursor: not-allowed" <% } %>>
                        <button type="button"
                            class="modal-button <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin' && username !='helpDeskElena') { %> disabled-button <% } %>"
                            id="move-button">
                            <i class="bi bi-arrows-move"></i> Move Soldier
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Move soldier to another room</span>
                        </div>
                </div>
                <div class="btn-container" <% if(username !='helpDeskNikolay' && username !='helpDeskAngel' && username
                    !='admin' && username !='helpDeskElena' ) { %>
                    style="cursor: not-allowed" <% } %>>
                        <button type="button"
                            class="modal-button <% if(username != 'helpDeskNikolay' && username != 'helpDeskAngel' && username != 'admin' && username !='helpDeskElena') { %> disabled-button <% } %>"
                            id="addtional-item-button">
                            <i class="bi bi-plus-circle"></i> Add Additional Item
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Add additional items or bags to the soldier</span>
                        </div>
                </div>
            </div>
        </div>
    </form>

    <div id="reportModal" class="modal">
        <div class="modal-content-multi-calendar">
            <span class="close-btn">&times;</span>
            <h3 class="header-modal-report mb-3">Archive - Select Date Range (From/To Date)
            </h3>

            <!-- Container for two side-by-side calendars -->
            <div class="calendar-container">
                <div class="calendar" id="calendar1">
                    <header>
                        <h3></h3>
                        <nav>
                            <button type="button" id="prev"></button>
                            <button type="button" id="next"></button>
                        </nav>
                    </header>
                    <section>
                        <ul class="days">
                            <li>Sun</li>
                            <li>Mon</li>
                            <li>Tue</li>
                            <li>Wed</li>
                            <li>Thu</li>
                            <li>Fri</li>
                            <li>Sat</li>
                        </ul>
                        <ul class="dates"></ul>
                    </section>
                </div>

                <div class="calendar" id="calendar2">
                    <header>
                        <h3></h3>
                        <nav>
                            <button type="button" id="prev"></button>
                            <button type="button" id="next"></button>
                        </nav>
                    </header>
                    <section>
                        <ul class="days">
                            <li>Sun</li>
                            <li>Mon</li>
                            <li>Tue</li>
                            <li>Wed</li>
                            <li>Thu</li>
                            <li>Fri</li>
                            <li>Sat</li>
                        </ul>
                        <ul class="dates"></ul>
                    </section>
                </div>
            </div>

            <!-- Buttons for confirming the selection -->
            <div class="button-container">
                <button id="confirmReportBtn" class="modal-button">View
                    Report</button>
            </div>

            <input name="selectedDate1" class="show-date" id="selectedDate1" value="">
            <input name="selectedDate2" class="show-date" id="selectedDate2" value="">
        </div>
    </div>

    <!-- The Modal for Reports View -->
    <div id="reportViewModal" class="modal">
        <form class="modal-content-view" action="/accommodation/report" method="POST" id="form2">
            <span class="close-btn">&times;</span>
            <h2>Reports View</h2>

            <!-- Left and Right Navigation Buttons -->
            <div class="d-flex justify-content-end mt-2 mb-2">
                <button type="button" id="prevBtn"></button>
                <span id="pageNumber"></span>
                <button type="button" id="nextBtn"></button>
            </div>

            <div class="table-container">
                <table id="soldierUsageTable">
                    <thead>
                        <tr>
                            <th><input name="roomNumber" type="text" class="search-input-view"
                                    placeholder="Search...">Room Number
                            </th>
                            <th><input name="soldierName" type="text" class="search-input-view"
                                    placeholder="Search...">Soldier Name
                            </th>
                            <th><input name="country" type="text" class="search-input-view"
                                    placeholder="Search...">Country</th>
                            <th><input name="dateIn" type="text" class="search-input-view"
                                    placeholder="Search...">Accommodation
                                Date
                            </th>
                            <th><input name="dateOut" type="text" class="search-input-view"
                                    placeholder="Search...">Release Date
                            </th>
                            <th><input name="mealCard" type="text" class="search-input-view"
                                    placeholder="Search...">Meal card</th>
                            <th><input name="laundryBag" type="text" class="search-input-view"
                                    placeholder="Search...">Laundry bag
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end mt-2 mb-2">
                <button type="button" id="prevBtnDate"></button>
                <span id="pageNumberDate"></span>
                <button type="button" id="nextBtnDate"></button>
            </div>

            <div class="table-container">
                <table id="soldierMoveTable">
                    <thead>
                        <tr>
                            <th><input name="oldRoom" type="text" class="search-input-view-second"
                                    placeholder="Search...">Previous
                                Key</th>
                            <th><input name="newRoom" type="text" class="search-input-view-second"
                                    placeholder="Search...">New Key
                            </th>
                            <th><input name="soldierName" type="text" class="search-input-view-second"
                                    placeholder="Search...">Soldier</th>
                            <th><input name="dateRelock" type="text" class="search-input-view-second"
                                    placeholder="Search...">Date
                                Relocation
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>

            <!-- Buttons for confirming the selection -->
            <div class="button-container">
                <button id="confirmReportBtnReport" class="modal-button">Generate Report</button>
            </div>

        </form>
    </div>

    <!-- The Modal for Move -->
    <div id="moveModal" class="modal">
        <form class="modal-content" action="/accommodation/moveSoldier" method="POST" id="form3">
            <span class="close-btn">&times;</span>
            <h2>Move soldier</h2>

            <div class="modal-grid">

                <!-- Label for Room 1 -->
                <label class="move-label" id="modal-move-room-1"></label>
                <input type="hidden" id="previewKey" name="keyId" value="">

                <!-- Label for Soldier 1 -->
                <label class="move-label" id="modal-soldier-1"></label>
                <input type="hidden" id="previewSoldier" name="soldId">

            </div>

            <div class="modal-grid">
                <!-- Round Symbol -->
                <p class="round-symbol">⇅</p>
            </div>

            <div class="modal-grid">

                <!-- Soldier Selection with Custom Search -->
                <div class="mb-3 search-container" id="search-soldier-container-move">

                    <input type="text" id="soldierSearchMove" class="form-control" placeholder="Key Number">
                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>

                    <ul id="soldierDropdownMove" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedKeyMoveId" name="keyMoveId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <!-- Label for Room 1 -->
                <label id="modal-soldier-2">Soldier: Undefined</label>
                <input type="hidden" id="selectedSoldMoveId" name="soldMoveId">

            </div>

            <!-- Buttons for confirming the selection -->
            <div class="button-container">
                <button id="confirmReportBtnMove" class="modal-button">Move</button>
            </div>
        </form>
    </div>

    <div id="soldierListModal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>

            <h2>List of Soldiers
                <div class="btn-container">
                    <button type="button" class="btn btn-outline-success btn-sm rounded-circle fw-bold"
                        id="addSoldier"><i class="bi bi-plus"></i></button>
                    <div class="tooltip-custom">
                        <i class="bi bi-question-circle"></i>
                        <span class="tooltiptext">Add soldier to the system</span>
                    </div>
                </div>
                <div class="btn-container">
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-circle fw-bold"
                        id="removeSoldier"><i class="bi bi-dash"></i></button>
                    <div class="tooltip-custom">
                        <i class="bi bi-question-circle"></i>
                        <span class="tooltiptext">Remove soldier to the system</span>
                    </div>
                </div>
                <div class="btn-container">
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-circle fw-bold"
                        id="listUpcomingSoldierAction"><i class="bi bi-person-lines-fill"></i></button>
                    <div class="tooltip-custom">
                        <i class="bi bi-question-circle"></i>
                        <span class="tooltiptext">Shows all soldiers for whom actions are pending</span>
                    </div>
                </div>
            </h2>

            <div class="d-flex justify-content-end mt-2 mb-2">
                <button type="button" id="prevBtnSecond"></button>
