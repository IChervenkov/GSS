<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" href="/icon/logoPage.png">
    <link rel="stylesheet" href="/style/styleAccommodation.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
</head>

<body>

    <input type="hidden" id="curent-dest" value="<%= numBuild %>">

    <!-- Horizontal Navigation Bar -->
    <div class="horizontal-nav">
        <button type="button" class="menu-toggle" aria-label="Toggle horizontal navigation">&#9776; Menu</button>
        <ul id="nav-links">
            <% horizontalNavItems.forEach(function(item) { %>
                <li><a href="<%= item.href %>">
                        <%= item.name %>
                    </a></li>
                <% }); %>
        </ul>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">

        <button type="button" id="menu-toggle-left" class="menu-toggle-left" aria-label="Toggle sidebar navigation">
            <span id="arrow">&#9651;</span> Setting parameters
        </button>

        <!-- Left Navigation Bar -->
        <div class="left-nav">
            <div class="title-container mb-2 sticky-top p-3 w-100 transparent-bg" <% if(username !='helpDeskNikolay' &&
                username !='admin' ) { %> style="cursor: not-allowed" <% } %>>
                    <button type="button" id="btnAddDestination"
                        class="btn-add-destination w-100 <% if(username != 'helpDeskNikolay' && username != 'admin') { %> disabled-button <% } %>">Add
                        Destination</button>
            </div>
            <ul>
                <% navItems.forEach(function(item) { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a href="<%= item.href %>" class="flex-grow-1 text-decoration-none full-back">
                            <%= item.name %>
                                <span class="name-add d-block">
                                    <%= item.nameAdd %>
                                </span>
                        </a>
                        <div class="button-group" <% if(username !='helpDeskNikolay' && username !='admin' ) { %>
                            style="cursor: not-allowed" <% } %>>
                                <button type="button"
                                    class="btn btn-success btn-sm me-1 btn-add <% if(username != 'helpDeskNikolay' && username != 'admin') { %> disabled-button <% } %>"
                                    name="<%= item.numBuild %>">+</button>
                                <button type="button"
                                    class="btn btn-danger btn-sm btn-remove <% if(username != 'helpDeskNikolay' && username != 'admin') { %> disabled-button <% } %>"
                                    name="<%= item.numBuild %>">−</button>
                                <% if(item.numBuild) { %>
                                    <button type="button"
                                        class="btn btn-outline-secondary btn-sm <% if(username != 'helpDeskNikolay' && username != 'admin') { %> disabled-button <% } %>"
                                        name="<%= item.numBuild %>" data-name-room="<%= item.name %>">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <% } %>
                        </div>
                    </li>
                    <% }); %>
            </ul>
        </div>

        <!-- Main Content Area -->
        <div class="content">

            <div class="visualization-header">
                <div class="row align-items-center gap-4">
                    <!-- Title and Count Beds Column -->
                    <div class="col-md-auto">
                        <h3 class="mb-0">
                            <!-- Title Row -->
                            <div>
                                <%= titlePage %>
                            </div>

                            <!-- Count Beds Row -->
                            <% if(countBeds) { %>
                                <div class="name-add">
                                    (<%= countBeds %> free beds)
                                </div>
                                <% }; %>
                        </h3>
                    </div>

                    <!-- Search Column -->
                    <div class="col-md">
                        <!-- Soldier Selection with Custom Search -->
                        <div class="search-container" id="search-all-key-container">
                            <div class="input-group">
                                <input type="text" id="allKeySearch" class="form-control" placeholder="Search...">
                            </div>
                            <ul id="allKeyDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                            <input type="hidden" id="selectedAllKeyId" name="allKeySelectId" value="">
                            <!-- To store the selected soldier ID -->
                        </div>
                    </div>
                </div>

                <div class="virtual-warehouse-labels">
                    <label class="virtual-warehouse-label">Free Beds: <%= totalFreeBeds %></label>
                    <label class="virtual-warehouse-label">Occupied Beds: <%= totalOccupiedBeds %></label>

                    <div <% if(username !='helpDeskNikolay' && username !='admin' && username !='helpDeskElena' ) { %>
                        style="cursor: not-allowed" <% } %>>
                            <button type="button" id="btnAddSoldier"
                                class="btn-add-soldier <% if(username != 'helpDeskNikolay' && username != 'admin' && username !='helpDeskElena') { %> disabled-button <% } %>">Add
                                soldier</button>
                    </div>
                    <div <% if(username !='helpDeskNikolay' && username !='admin' && username !='helpDeskElena' ) { %>
                        style="cursor: not-allowed" <% } %>>
                            <button type="button" id="btnAccommSoldier"
                                class="btn-add-soldier <% if(username != 'helpDeskNikolay' && username != 'admin' && username !='helpDeskElena') { %> disabled-button <% } %>">Accommodation
                                soldiers</button>
                    </div>
                    <div <% if(username !='helpDeskNikolay' && username !='admin' && username !='helpDeskElena' ) { %>
                        style="cursor: not-allowed" <% } %>>
                            <button type="button" id="btnFreeAllRoom"
                                class="btn-free-soldier <% if(username != 'helpDeskNikolay' && username != 'admin') { %> disabled-button <% } %>">Release
                                all
                                rooms</button>
                    </div>
                    <button type="button" id="btnReport" class="btn-report">Reports</button>
                </div>
            </div>

            <!-- Data Visualization Table -->

            <% if(headerTable) { %>
                <div class="table-container">
                    <table id="data-table">
                        <thead>
                            <tr>
                                <th>
                                    <input type="text" class="search-input" placeholder="Search...">
                                    <label id="room-number-header">Room Number</label>
                                </th>

                                <th>
                                    <input type="text" class="search-input" placeholder="Search...">
                                    <label id="room-status-header">Room Status</label>
                                </th>

                                <th>
                                    <input type="text" class="search-input" placeholder="Search...">
                                    <label id="count-free-beds-header">Count Free Beds</label>
                                </th>
                            </tr>
                        </thead>

                        <% if (nameroomSetCount) { %>
                            <tbody id="tableBody">
                                <% nameroomSetCount.forEach(function(item) { %>
                                    <tr class="data-room">

                                        <td>
                                            <%= item.nameroom %>
                                        </td>

                                        <td class="<%= item.countFreeBeds != 0 ? 'undefined-data' : '' %>">
                                            <%= item.countFreeBeds !=0 ? 'Free' : 'Occupied' %>
                                        </td>

                                        <td>
                                            <%= item.countFreeBeds %>
                                        </td>

                                    </tr>
                                    <% }); %>
                            </tbody>
                    </table>
                </div>

                <nav aria-label="Table pagination">
                    <ul id="pagination" class="pagination justify-content-center"></ul>
                </nav>

                <% } } %>

        </div>
    </div>

    <input type="hidden" id="typeBuild" value="<%= type %>">
    <input type="hidden" id="previewTypeBuild" value="<%= type %>">
    <input type="hidden" id="numBuild" value="<%= numBuild %>">

    <!-- The Modal for Reports View -->
    <div id="keyModal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>

            <h2>List of Keys
                <button type="button" class="btn btn-outline-success btn-sm rounded-circle fw-bold"
                    id="addKey">+</button>
                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle fw-bold"
                    id="removeKey">−</button>
            </h2>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <% headerTable.forEach(function(item) { %>
                                <th>
                                    <%= item.name %>
                                </th>
                                <% }); %>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <form id="form1" action="/saveKey" method="post">

        <!-- Modal Structure -->

        <div id="roomModal" class="modal">
            <div class="modal-content">
                <span class="close-btn">&times;</span>

                <h2>Room Information</h2>

                <!-- Label for Key Number -->
                <p class="modal-labal-info" id="modal-keynum"></p>

                <!-- Label for Key Number -->
                <p class="modal-labal-info" id="modal-keycode"></p>
                <input type="hidden" id="key-code-value" name="keyCodeId" value="">

                <!-- Soldier Selection with Custom Search -->
                <div class="mb-3 search-container" id="search-soldier-container">
                    <label for="soldierSearch" class="form-label">Soldier Name:</label>
                    <div class="input-group">
                        <input type="text" id="soldierSearch" class="form-control" placeholder="Soldier Name">
                    </div>
                    <ul id="soldierDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedSoldierId" name="soldierId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <!-- Bag Selection with Custom Search -->
                <div class="mb-3 search-container" id="search-laundry-bag-container">
                    <label for="laundryBagSearch" class="form-label">Laundry Bag:</label>
                    <div class="input-group">
                        <input type="text" id="laundryBagSearch" class="form-control" placeholder="Laundry Bag">
                    </div>
                    <ul id="bagDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedBagId" name="bagId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <div class="mb-3" id="input-meal-card">
                    <label for="meal-card-value" class="form-label">Meal card:</label>
                    <div class="input-group">
                        <input type="text" id="meal-card-value" name="mealCardId" class="form-control"
                            placeholder="Meal card" value="">
                    </div>
                </div>

                <!-- Label for Country -->
                <p class="modal-labal-info" id="modal-country"></p>
                <input type="hidden" id="country-value" name="countryId" value="">

                <input type="hidden" id="isAccommodation" value="false">

                <button type="button" class="modal-button" id="save-button">Save</button>
                <button type="button" class="modal-button" id="move-button">Move Soldier</button>
            </div>
        </div>

        <!-- The Modal Message -->
        <div id="myMessage" class="modal">
            <div class="modal-content-mess">
                <span class="close-btn">&times;</span>

                <img src="../icon/information.png" alt="Confirmation Image" class="modal-image" id="mess-icon">
                <p id="mess-text"></p>
                <div class="button-container-mess">
                    <button id="btnYes" type="submit" class="login-btn-mess confirm-btn">Ok</button>
                </div>
            </div>
        </div>
    </form>

    <!-- The Modal for Reports View -->
    <div id="reportViewModal" class="modal">
        <form class="modal-content-view" action="/accommodation/report" method="POST" id="form2">
            <span class="close-btn">&times;</span>
            <h2>Reports View</h2>

            <div class="table-container">
                <table id="soldierUsageTable">
                    <thead>
                        <tr>
                            <th><input type="text" class="search-input-view" placeholder="Search...">Room Number
                            </th>
                            <th><input type="text" class="search-input-view" placeholder="Search...">Soldier Name
                            </th>
                            <th><input type="text" class="search-input-view" placeholder="Search...">Country</th>
                            <th><input type="text" class="search-input-view" placeholder="Search...">Accommodation
                                Date
                            </th>
                            <th><input type="text" class="search-input-view" placeholder="Search...">Release Date
                            </th>
                            <th><input type="text" class="search-input-view" placeholder="Search...">Meal card</th>
                            <th><input type="text" class="search-input-view" placeholder="Search...">Laundry bag
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>

            <div class="table-container">
                <table id="soldierMoveTable">
                    <thead>
                        <tr>
                            <th><input type="text" class="search-input-view-second" placeholder="Search...">Previous
                                Room</th>
                            <th><input type="text" class="search-input-view-second" placeholder="Search...">New Room
                            </th>
                            <th><input type="text" class="search-input-view-second" placeholder="Search...">Soldier</th>
                            <th><input type="text" class="search-input-view-second" placeholder="Search...">Date
                                Relocation
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>

            <!-- Buttons for confirming the selection -->
            <div class="button-container">
                <button id="confirmReportBtnReport" class="modal-button">Generate Report</button>
            </div>

        </form>
    </div>

    <!-- The Modal for Move -->
    <div id="moveModal" class="modal">
        <form class="modal-content" action="/accommodation/moveSoldier" method="POST" id="form3">
            <span class="close-btn">&times;</span>
            <h2>Move soldier</h2>

            <div class="modal-grid">

                <!-- Label for Room 1 -->
                <label class="move-label" id="modal-move-room-1"></label>
                <input type="hidden" id="previewKey" name="keyId" value="">

                <!-- Label for Soldier 1 -->
                <label class="move-label" id="modal-soldier-1"></label>
                <input type="hidden" id="previewSoldier" name="soldId">

            </div>

            <div class="modal-grid">
                <!-- Round Symbol -->
                <p class="round-symbol">⇅</p>
            </div>

            <div class="modal-grid">

                <!-- Soldier Selection with Custom Search -->
                <div class="mb-3 search-container" id="search-soldier-container-move">
                    <div class="input-group">
                        <input type="text" id="soldierSearchMove" class="form-control" placeholder="Key Number">
                        <div class="invalid-feedback">
                            Please choose a key number
                        </div>
                        <div class="valid-feedback"></div>
                    </div>
                    <ul id="soldierDropdownMove" class="list-group"></ul> <!-- Custom dropdown for search -->
                    <input type="hidden" id="selectedKeyMoveId" name="keyMoveId" value="">
                    <!-- To store the selected soldier ID -->
                </div>

                <!-- Label for Room 1 -->
                <label id="modal-soldier-2">Soldier: Undefined</label>
                <input type="hidden" id="selectedSoldMoveId" name="soldMoveId">

            </div>

            <!-- Buttons for confirming the selection -->
            <div class="button-container">
                <button id="confirmReportBtnMove" class="modal-button">Move</button>
            </div>
        </form>
    </div>

    <!-- The Modal for Add Soldier -->
    <div id="addSoldierModal" class="modal">
        <form class="modal-content" action="/accommodation/addSoldier" method="POST" id="form4">
            <span class="close-btn">&times;</span>

            <h2>Add soldier</h2>

            <div class="mb-3">
                <label for="soldier-number" class="form-label">Soldier Number:</label>
                <div class="input-group">
                    <input type="text" id="soldier-number" name="soldierId" class="form-control"
                        placeholder="Soldier Number" pattern="^[A-Za-z0-9]+$">

                    <div class="invalid-feedback">
                        Please enter a valid soldier number (only letters and numbers)
                    </div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <div class="mb-3">
                <label for="soldier-name" class="form-label">Soldier Name:</label>
                <div class="input-group">
                    <input type="text" id="soldier-name" name="soldierName" class="form-control"
                        placeholder="Soldier Name" pattern="^[0-9]+ [A-Za-z0-9\s\-éÉàÀèÈùÙâÂêÊîÎôÔûÛçÇ]+$">

                    <div class="invalid-feedback">
                        Please enter a valid soldier name (only letters, numbers, space and dash)
                    </div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <div class="mb-3">
                <label for="soldier-country" class="form-label">Soldier Country:</label>
                <div class="input-group">
                    <input type="text" id="soldier-country" name="soldierCountry" class="form-control"
                        placeholder="Soldier Country" pattern="^[A-Za-z\s]+$">

                    <div class="invalid-feedback">
                        Please enter a valid soldier country (only letters and space)
                    </div>
                    <div class="valid-feedback"></div>
                </div>
            </div>

            <!-- Buttons for confirming the selection -->
            <div class="button-container">
                <button type="submit" id="confirmReportBtnAddSoldier" class="modal-button">Add soldier</button>
                <button type="button" id="confirmReportBtnAddMultiSoldier" class="modal-button">Add multiple
                    soldiers</button>
            </div>

        </form>
    </div>

    <!-- Modal Structure -->
    <div id="uploadModal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>

            <h2>Add multiple soldiers <a href="/accommodation/uploadSoldier/download"><i class="bi bi-download"></i></a>
            </h2>

            <div class="mb-3">
                <label for="fileInput" class="form-label">Upload File:</label>
                <input type="file" id="fileInput" class="form-control" accept=".xlsx">
                <!-- Accept specific file types -->
            </div>

            <div class="progress-bar">
                <div class="custom-progress" id="progress">
                </div>
            </div>

            <button type="button" id="upload-btn" class="modal-button">Upload</button>
        </div>
    </div>

    <!-- Modal Structure -->
    <div id="accommodattionModal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>

            <h2>Accommodation multiple soldiers <a href="/accommodation/multiSoldier/download"><i
                        class="bi bi-download"></i></a></h2>

            <div class="mb-3">
                <label for="fileInputSoldier" class="form-label">Upload File:</label>
                <input type="file" id="fileInputSoldier" class="form-control" accept=".xlsx">
                <!-- Accept specific file types -->
            </div>

            <div class="progress-bar">
                <div class="custom-progress" id="progress-multi-soldier">
                </div>
            </div>

            <button type="button" id="upload-multi-soldier-btn" class="modal-button">Upload</button>
        </div>
    </div>

    <!-- Modal Structure -->
    <div id="deleteModal" class="modal">
        <form class="modal-content" action="/accommodation/deleteSoldier" method="get" id="form5">
            <span class="close-btn">&times;</span>

            <h2>⚠ Release all rooms ⚠</h2>

            <p>To release all rooms you need to enter <span id="randomText" class="code-style"></span> in the field
                below</p>
            <input type="hidden" id="randomTextValue" value="">

            <div class="mb-3 search-container" id="search-delete-soldier-container">
                <div class="input-group">
                    <input type="text" id="buildSearch" class="form-control" placeholder="Building number">

                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
                <ul id="buildDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                <input type="hidden" id="selectedBuildId" name="roomSelectId" value="">
                <!-- To store the selected soldier ID -->
            </div>

            <div class="mb-3">
                <input type="text" id="deleteCode" class="form-control" placeholder="Enter special characters here">

                <div class="invalid-feedback"></div>
                <div class="valid-feedback"></div>
            </div>

            <button type="submit" id="delete-soldier-btn" class="modal-button-release">Release</button>
        </form>
    </div>

    <!-- Modal Structure -->
    <div id="destinationModal" class="modal">
        <form class="modal-content" action="/accommodation/addDestination" method="post" id="form6">
            <span class="close-btn">&times;</span>

            <h2>Add destination</h2>

            <div class="mb-3">
                <label for="build-id" class="form-label">Building Number:</label>
                <input type="text" id="build-id" name="buildId" class="form-control" placeholder="Building Number">

                <div class="invalid-feedback">
                    Please enter a build number
                </div>
                <div class="valid-feedback"></div>
            </div>

            <div class="mb-3">
                <label for="build-name" class="form-label">Building Name:</label>
                <input type="text" id="build-name" name="buildName" class="form-control" placeholder="Building Name">

                <div class="invalid-feedback">
                    Please enter a build name
                </div>
                <div class="valid-feedback"></div>
            </div>

            <div class="mb-3">
                <label for="build-type" class="form-label">Building Type:</label>
                <input type="text" id="build-type" name="buildType" class="form-control" placeholder="Building Type">

                <div class="invalid-feedback">
                    Please enter a build type
                </div>
                <div class="valid-feedback"></div>
            </div>

            <button type="submit" id="add-destination-btn" class="modal-button">Add destination</button>

        </form>
    </div>

    <!-- Modal Structure -->
    <div id="roomAddModal" class="modal">
        <form class="modal-content" action="/accommodation/addRoomToDestination" method="post" id="form7">
            <span class="close-btn">&times;</span>

            <h2>Add Room</h2>

            <div class="mb-3">
                <label for="room-id" class="form-label">Room Number:</label>
                <input type="text" id="room-id" name="roomId" class="form-control" placeholder="Room Number">

                <div class="invalid-feedback">
                    Please enter a room number
                </div>
                <div class="valid-feedback"></div>
            </div>

            <div class="mb-3">
                <label for="room-name" class="form-label">Room Name:</label>
                <input type="text" id="room-name" name="roomName" class="form-control" pattern="^[^\/]+\/.+$"
                    placeholder="Room Name">

                <div class="invalid-feedback">
                    Please enter a valid room nama (format: build number/room number)
                </div>
                <div class="valid-feedback">
                    Valid room nama
                </div>
            </div>

            <input type="hidden" id="click-build" name="clickBuild">

            <button type="submit" id="add-room-btn" class="modal-button">Add room</button>

        </form>
    </div>

    <!-- Modal Structure -->
    <div id="roomRemoveModal" class="modal">
        <form class="modal-content" action="/accommodation/removeRoomToDestination" method="post" id="form8">
            <span class="close-btn">&times;</span>

            <h2>Remove Room</h2>

            <!-- Room Selection with Custom Search -->
            <div class="mb-3 search-container" id="search-room-container">
                <label for="roomSearch" class="form-label">Room Name:</label>
                <div class="input-group">
                    <input type="text" id="roomSearch" class="form-control" placeholder="Room Name">

                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
                <ul id="roomDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                <input type="hidden" id="selectedRoomId" name="roomSelectId" value="">
                <!-- To store the selected soldier ID -->
            </div>

            <input type="hidden" id="click-build" name="clickBuild">

            <button type="submit" id="add-room-btn" class="modal-button">Remove room</button>

        </form>
    </div>

    <!-- Modal Structure -->
    <div id="keyAddModal" class="modal">
        <form class="modal-content" action="/accommodation/addKeyToRoom" method="post" id="form9">
            <span class="close-btn">&times;</span>

            <h2>Add Key</h2>

            <div class="mb-3">
                <label for="key-id" class="form-label">Key Number:</label>
                <input type="text" id="key-id" name="keyId" class="form-control" placeholder="Key Number">

                <div class="invalid-feedback">
                    Please enter a key number
                </div>
                <div class="valid-feedback"></div>
            </div>

            <div class="mb-3">
                <label for="key-name" class="form-label">Key Name:</label>
                <input type="text" id="key-name" name="keyName" class="form-control" pattern="^[^\/]+\/[^\/]+\/.+$"
                    placeholder="Key Name">

                <div class="invalid-feedback">
                    Please enter a valid key name (format: build number/room number/key number)
                </div>
                <div class="valid-feedback">
                    Valid key name
                </div>
            </div>

            <input type="hidden" id="selected-room-for-key" name="selectedRoomForKey">

            <button type="submit" id="add-room-btn" class="modal-button">Add key</button>

        </form>
    </div>

    <!-- Modal Structure -->
    <div id="keyRemoveModal" class="modal">
        <form class="modal-content" action="/accommodation/removeKeyToRoom" method="post" id="form10">
            <span class="close-btn">&times;</span>

            <h2>Replace Key</h2>

            <div class="mb-3 search-container" id="search-key-container">
                <label for="keySearch" class="form-label">Old key name:</label>
                <div class="input-group">
                    <input type="text" id="keySearch" class="form-control" placeholder="Key name">

                    <div class="invalid-feedback"></div>
                    <div class="valid-feedback"></div>
                </div>
                <ul id="keyDropdown" class="list-group"></ul> <!-- Custom dropdown for search -->
                <input type="hidden" id="selectedKeyId" name="keySelectId" value="">
                <!-- To store the selected soldier ID -->
            </div>

            <label for="newKeyName" class="form-label">New key code:</label>
            <div class="input-group">
                <input type="text" id="newKeyName" class="form-control" placeholder="Key code">

                <div class="invalid-feedback"></div>
                <div class="valid-feedback"></div>
            </div>

            <button type="submit" id="remove-room-btn" class="modal-button">Replace key</button>

        </form>
    </div>

    <!-- The Modal Message -->
    <div id="myGlobalMessage" class="modal">
        <div class="modal-content-mess">
            <span class="close-btn">&times;</span>

            <img src="/icon/information.png" alt="Confirmation Image" class="modal-image" id="mess-global-icon">
            <p id="mess-global-text"></p>
        </div>
    </div>

    <div id="pinned-message" class="pinned-message" style="z-index: 1050;">
        <p id="pinned-message-text"></p>
        <button id="close-pinned-message">✖</button>
    </div>

</body>

<script src="/java/autoSearch.js"></script>
<script src="/java/soldier_modal.js"></script>
<script src="/java/pageNumber.js"></script>
<script src="/java/showPinMessage.js"></script>
<script src="/java/phoneMenu.js"></script>

</html>