<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/icon/logoPage.png">
  <link rel="stylesheet" href="/style/stylesLogIn.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
  <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">

  <title>
    <%= title %>
  </title>
</head>

<body class="bg-light">

  <div id="loadingIndicator" class="loading-overlay" style="display: none;">
    <div class="spinner"></div>
  </div>

  <!-- Centered login box -->
  <div class="d-flex align-items-center justify-content-center vh-100">
    <div class="login-box bg-white p-5 rounded-4 shadow-lg" style="width: 100%; max-width: 400px;">
      
      <!-- Logo -->
      <div class="text-center mb-4">
        <img src="/icon/logoPage.png" alt="img/png" class="logo-login">
        <h3 class="fw-bold mt-5"><%= title %></h3>
        <p class="text-muted">Welcome back to GSS!</p>
        <p class="text-muted">Please log in.</p>
      </div>

      <!-- Login form -->
      <form id="loginForm" action="/web/login" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Username -->
        <div class="mb-3">
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
            <input type="text" class="form-control" id="username" name="username" placeholder="Enter username">
          </div>
          <div class="invalid-feedback"></div>
          <div class="valid-feedback"></div>
        </div>

        <!-- Password -->
        <div class="mb-4">
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
            <input type="password" class="form-control" id="password" name="password" placeholder="Enter password">
          </div>
          <div class="invalid-feedback"></div>
          <div class="valid-feedback"></div>
        </div>

        <!-- Login button -->
        <div class="d-grid mb-3">
          <button type="submit" class="login-btn">
            <i class="bi bi-box-arrow-in-right"></i> Login
          </button>
        </div>

        <!-- Change password link -->
        <div class="text-center">
          <a class="btn btn-link text-decoration-none" href="/web/changePassword">
            <i class="bi bi-shield-lock-fill"></i> Change Password
          </a>
        </div>

        <!-- Error message -->
        <p id="errorMessage" class="error-message text-danger text-center mt-3"></p>
      </form>
    </div>
  </div>

  <script src="/java/logIn.js"></script>
</body>

</html>