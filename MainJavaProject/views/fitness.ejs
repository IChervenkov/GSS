<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" href="/icon/logoPage.png">
    <link rel="stylesheet" href="/style/styleFitness.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

</head>

<body>

    <!-- Horizontal Navigation Bar -->
    <div class="horizontal-nav">
        <button type="button" class="menu-toggle" aria-label="Toggle horizontal navigation">&#9776; Menu</button>
        <ul id="nav-links">
            <% horizontalNavItems.forEach(item => { %>
                <li>
                    <a href="<%= item.href %>">
                        <% if (item.name.toLowerCase() === 'bicycles') { %>
                            <i class="bi bi-bicycle"></i>
                        <% } else if (item.name.toLowerCase() === 'main page') { %>
                            <i class="bi bi-house-door"></i>
                        <% } else if (item.name.toLowerCase() === 'assets') { %>
                            <i class="bi bi-box"></i>
                        <% } else if (item.name.toLowerCase() === 'laundry') { %>
                            <i class="bi bi-water"></i>
                        <% } else if (item.name.toLowerCase() === 'gym') { %>
                            <i class="bi bi-activity"></i>
                        <% } else if (item.name.toLowerCase() === 'accommodation and keys') { %>
                            <i class="bi bi-key"></i>
                        <% } else if (item.name.toLowerCase() === 'logout') { %>
                            <i class="bi bi-box-arrow-right"></i>
                        <% } %>
                        <span><%= item.name %></span>
                    </a>
                </li>
            <% }); %>
        </ul>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">

        <button type="button" id="menu-toggle-left" class="menu-toggle-left" aria-label="Toggle sidebar navigation">
            <span id="arrow">&#9651;</span> Setting parameters
        </button>

        <!-- Left Navigation Bar -->
        <div class="left-nav">
            <button type="button" id="btnFiltering" class="modal-btn w-100">
                <i class="bi bi-funnel"></i> Filtering
            </button>

            <!-- Container for two side-by-side calendars -->
            <div class="calendar-container">
                <div class="calendar" id="calendar1">
                    <header>
                        <h3></h3>
                        <nav>
                            <button type="button" id="prev"></button>
                            <button type="button" id="next"></button>
                        </nav>
                    </header>
                    <section>
                        <ul class="days">
                            <li>Sun</li>
                            <li>Mon</li>
                            <li>Tue</li>
                            <li>Wed</li>
                            <li>Thu</li>
                            <li>Fri</li>
                            <li>Sat</li>
                        </ul>
                        <ul class="dates"></ul>
                    </section>
                    <input name="selectedDate1" class="show-date" id="selectedDate1" value="">
                </div>
            </div>

            <div class="calendar-container">
                <div class="calendar" id="calendar2">
                    <header>
                        <h3></h3>
                        <nav>
                            <button type="button" id="prev"></button>
                            <button type="button" id="next"></button>
                        </nav>
                    </header>
                    <section>
                        <ul class="days">
                            <li>Sun</li>
                            <li>Mon</li>
                            <li>Tue</li>
                            <li>Wed</li>
                            <li>Thu</li>
                            <li>Fri</li>
                            <li>Sat</li>
                        </ul>
                        <ul class="dates"></ul>
                    </section>
                    <input name="selectedDate2" class="show-date" id="selectedDate2" value="">
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="content">
            <!-- Data Visualization Table -->
            <div class="visualization-header">
                <h3 class="d-flex align-items-center gap-2">
                    <%= title %>
                </h3>

                <div class="virtual-warehouse-labels">
                    <label id="percentSad" class="virtual-warehouse-label">Total Sad (😞): <%= dataPerEmj.percent_sad %>
                            </label>
                    <label id="percentNeutral" class="virtual-warehouse-label">Total Neutral (😐): <%=
                            dataPerEmj.percent_neutral %></label>
                    <label id="percentVeryHappy" class="virtual-warehouse-label">Total Very Happy (😁): <%=
                            dataPerEmj.percent_very_happy %></label>

                    <button type="button" id="btnReport" class="btn-report">
                        <i class="bi bi-file-earmark-text"></i> Report
                    </button>
                </div>
            </div>

            <div class="table-container">
                <table id="mainTable">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Average rating</th>
                            <th>Number of visits</th>
                        </tr>
                    </thead>

                    <% if (data) { %>
                        <tbody id="tableBody">
                            <% data.forEach(function(item) { %>
                                <tr>
                                    <td>
                                        <%= new Date(item.created_date).toLocaleDateString('en-US', { year: 'numeric' ,
                                            month: 'long' , day: 'numeric' ,}) %>
                                    </td>

                                    <td>
                                        <%= item.average_emoji %>
                                    </td>

                                    <td>
                                        <%= item.soldier_count %>
                                    </td>
                                </tr>
                                <% }); } %>
                        </tbody>
                </table>
            </div>

            <nav aria-label="Table pagination">
                <ul id="pagination" class="pagination justify-content-center"></ul>
            </nav>

        </div>

    </div>

    <div id="pinned-message" class="pinned-message" style="display: none;">
        <p id="pinned-message-text"></p>
        <button id="close-pinned-message">✖</button>
    </div>

</body>

<script src="/java/calendar.js" defer></script>
<script src="/java/pageNumber.js"></script>
<script src="/java/showSpecialRow.js"></script>
<script src="/java/showPinMessage.js"></script>
<script src="/java/phoneMenu.js"></script>

</html>