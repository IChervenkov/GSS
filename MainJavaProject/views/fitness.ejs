<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" href="/icon/logoPage.png">
    <link rel="stylesheet" href="/style/styleFitness.css">
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

</head>

<body>

    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="isFirstTime" value="false">
    <input type="hidden" id="totalCount" value="<%= totalCount %>">
    <input type="hidden" id="numBuild" value="">

    <!-- Horizontal Navigation Bar -->
    <div class="horizontal-nav">
        <button type="button" class="menu-toggle" aria-label="Toggle horizontal navigation">&#9776; Menu</button>
        <ul id="nav-links">
            <% horizontalNavItems.forEach(item=> { %>
                <li>
                    <a href="<%= item.href %>">
                        <% if (item.name.toLowerCase()==='bicycles' ) { %>
                            <i class="bi bi-bicycle"></i>
                            <% } else if (item.name.toLowerCase()==='main page' ) { %>
                                <i class="bi bi-house-door"></i>
                                <% } else if (item.name.toLowerCase()==='assets' ) { %>
                                    <i class="bi bi-box"></i>
                                    <% } else if (item.name.toLowerCase()==='laundry' ) { %>
                                        <i class="bi bi-water"></i>
                                        <% } else if (item.name.toLowerCase()==='gym' ) { %>
                                            <i class="bi bi-activity"></i>
                                            <% } else if (item.name.toLowerCase()==='accommodation and keys' ) { %>
                                                <i class="bi bi-key"></i>
                                                <% } else if (item.name.toLowerCase()==='logout' ) { %>
                                                    <i class="bi bi-box-arrow-right"></i>
                                                    <% } %>
                                                        <span>
                                                            <%= item.name %>
                                                        </span>
                    </a>
                </li>
                <% }); %>
        </ul>
    </div>

    <div id="loadingIndicator" class="loading-overlay" style="display: none;">
        <div class="spinner"></div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">

        <button type="button" id="menu-toggle-left" class="menu-toggle-left" aria-label="Toggle sidebar navigation">
            <span id="arrow">&#9651;</span> Setting parameters
        </button>

        <!-- Left Navigation Bar -->
        <div class="left-nav">
            <div class="title-container mb-2 sticky-top w-100 bg-light">
                <div class="btn-container w-100 w-md-auto">
                    <button type="button" id="btnFiltering" class="modal-btn w-100 w-md-auto">
                        <i class="bi bi-funnel"></i> Filtering
                    </button>
                    <div class="tooltip-custom">
                        <i class="bi bi-question-circle"></i>
                        <span class="tooltiptext">Filtering by date</span>
                    </div>
                </div>
            </div>
            <!-- Container for two side-by-side calendars -->
            <div class="calendar-container">
                <div class="calendar" id="calendar1">
                    <header>
                        <h3></h3>
                        <nav>
                            <button type="button" id="prev"></button>
                            <button type="button" id="next"></button>
                        </nav>
                    </header>
                    <section>
                        <ul class="days">
                            <li>Sun</li>
                            <li>Mon</li>
                            <li>Tue</li>
                            <li>Wed</li>
                            <li>Thu</li>
                            <li>Fri</li>
                            <li>Sat</li>
                        </ul>
                        <ul class="dates"></ul>
                    </section>
                    <input name="selectedDate1" class="show-date" id="selectedDate1" value="">
                </div>
            </div>

            <div class="calendar-container">
                <div class="calendar" id="calendar2">
                    <header>
                        <h3></h3>
                        <nav>
                            <button type="button" id="prev"></button>
                            <button type="button" id="next"></button>
                        </nav>
                    </header>
                    <section>
                        <ul class="days">
                            <li>Sun</li>
                            <li>Mon</li>
                            <li>Tue</li>
                            <li>Wed</li>
                            <li>Thu</li>
                            <li>Fri</li>
                            <li>Sat</li>
                        </ul>
                        <ul class="dates"></ul>
                    </section>
                    <input name="selectedDate2" class="show-date" id="selectedDate2" value="">
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="content">
            <!-- Data Visualization Table -->
            <div class="visualization-header">
                <h3 class="d-flex align-items-center gap-2">
                    <%= title %>
                </h3>

                <div class="virtual-warehouse-labels">
                    <label id="percentSad" class="virtual-warehouse-label">Total Sad (😞): <%= dataPerEmj.percent_sad %>
                    </label>
                    <label id="percentNeutral" class="virtual-warehouse-label">Total Neutral (😐): <%=
                            dataPerEmj.percent_neutral %></label>
                    <label id="percentVeryHappy" class="virtual-warehouse-label">Total Very Happy (😁): <%=
                            dataPerEmj.percent_very_happy %></label>

                    <div class="btn-container">
                        <button type="button" id="btnReport" class="btn-report w-100 w-md-auto">
                            <i class="bi bi-file-earmark-text"></i> Report
                        </button>
                        <div class="tooltip-custom">
                            <i class="bi bi-question-circle"></i>
                            <span class="tooltiptext">Download report</span>
                        </div>
                    </div>

                    <div class="button-container-report" <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Download fitness app'))) { %> style="cursor: not-allowed;" <% }
                            %>>
                            <button type="button"
                                class="download-btn <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Download fitness app'))) { %> disabled-button <% } %>"
                                id="downloadTabletAppBtn">
                                <i class="bi bi-download"></i> Download App
                            </button>
                    </div>

                </div>
            </div>

            <div class="table-container">
                <table id="mainTable">

                    <thead>
                        <tr>
                            <th>
                                <input name="date" type="text" class="search-input" placeholder="Search...">Date
                            </th>
                            <th>
                                <input name="date" type="text" class="search-input" placeholder="Search...">Average
                                rating
                            </th>
                            <th> <input name="date" type="text" class="search-input" placeholder="Search...">Number
                                of visits</th>
                        </tr>
                    </thead>

                    <% if (data) { %>
                        <tbody id="tableBody">
                            <% data.forEach(function(item) { %>
                                <tr>
                                    <td>
                                        <%= new Date(item.created_date).toISOString().slice(0, 10) %>
                                    </td>

                                    <td>
                                        <%= item.average_emoji %>
                                    </td>

                                    <td>
                                        <%= item.soldier_count %>
                                    </td>
                                </tr>
                                <% }); } %>
                        </tbody>
                </table>
            </div>

            <nav aria-label="Table pagination">
                <ul id="pagination" class="pagination justify-content-center"></ul>
            </nav>

        </div>

    </div>

    <!-- The Modal Message -->
    <div id="myMessage" class="modal">
        <div class="modal-content-mess">
            <span class="close">&times;</span>

            <img src="/icon/information.png" alt="Confirmation Image" class="modal-image" id="mess-icon">
            <p id="mess-text"></p>
        </div>
    </div>

    <%- include('partials/toastGlobalMessage') %>

</body>

<script src="/java/calendar.js" defer></script>
<script src="/java/showSpecialRow.js"></script>
<script src="/java/phoneMenu.js"></script>
<script src="/java/downloald-app.js"></script>

<% if(permissions && !(permissions.some(p => p.permission_name === 'Guest'))) { %>
    <script src="/java/showPinMessage.js"></script>
    <% } %>

</html>