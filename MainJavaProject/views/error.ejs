<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link rel="icon" href="/icon/logoPage.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= statusCode %> | Error
    </title>
    <link href="/style/error.css" rel="stylesheet">
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="d-flex justify-content-center align-items-center vh-100 bg-light">

    <div class="text-center p-4 bg-white rounded shadow">
        <!-- Animated SVG for global error -->
        <svg class="floating" width="200" height="200" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
            <circle cx="256" cy="256" r="200" fill="#f8d7da" />
            <line x1="176" y1="176" x2="336" y2="336" stroke="#721c24" stroke-width="24" stroke-linecap="round" />
            <line x1="336" y1="176" x2="176" y2="336" stroke="#721c24" stroke-width="24" stroke-linecap="round" />
        </svg>

        <!-- Error code and message -->
        <h1 class="display-1 text-danger">
            <%= statusCode %>
        </h1>
        <p class="lead mb-4">
            <%= message %>
        </p>

        <!-- Error details if present -->
        <% if (details && details.length) { %>
            <div class="alert alert-warning text-start" role="alert">
                <h5 class="alert-heading">Details:</h5>
                <ul class="mb-0">
                    <% details.forEach(detail=> { %>
                        <li>
                            <%= detail %>
                        </li>
                        <% }); %>
                </ul>
            </div>
            <% } %>

                <!-- Home button -->
                <a href="/logout" class="btn btn-success btn-lg mt-3">Go Back To LogIn Again</a>
    </div>

</body>

</html>