<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/icon/logoPage.png">
    <link rel="stylesheet" href="/style/stylesLogIn.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Verification</title>
</head>

<body>
    <div class="login-container">
        <div class="login-box">
            <h3 class="mb-3">Verification Code</h3>
            <img src="<%= qrCodeDataURL %>" alt="QR Code">
            <p class="text-muted">Enter the 6-digit code use QR code</p>
            <form action="/verify" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="input-group mb-3">
                    <span class="input-group-text" id="addon">
                        <i class="bi bi-shield-lock"></i>
                    </span>
                    <input type="password" class="form-control" name="code" placeholder="Your code"
                        aria-label="code" aria-describedby="addon" required>
                </div>
                <button type="submit" class="login-btn">Verify</button>
            </form>
            <% if (errorMessage) { %>
                <p class="error-message">
                    <%= errorMessage %>
                </p>
                <% } %>
        </div>
    </div>
</body>

</html>