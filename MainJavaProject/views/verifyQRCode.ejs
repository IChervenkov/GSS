<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/icon/logoPage.png">
    <link rel="stylesheet" href="/style/stylesLogIn.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <title>Verification</title>
</head>

<body class="bg-light">

    <div id="loadingIndicator" class="loading-overlay" style="display: none;">
        <div class="spinner"></div>
    </div>

    <!-- Centered verification box -->
    <div class="d-flex align-items-center justify-content-center vh-100">
        <div class="login-box text-center">

            <!-- Title -->
            <h3 class="fw-bold mb-3">Verification Code</h3>

            <!-- QR Code -->
            <img src="<%= qrCodeDataURL %>" alt="QR Code" class="qr-image mb-3">

            <p class="text-muted mb-4">Scan the QR code and enter the 6-digit code below</p>

            <!-- Verification form -->
            <form id="checkForm" action="/verify" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" id="code" name="code">

                <div class="code-inputs mb-3">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="form-control code-box">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="form-control code-box">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="form-control code-box">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="form-control code-box">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="form-control code-box">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="form-control code-box">
                </div>
            </form>

            <!-- Error message -->
            <p id="errorMessage" class="error-message text-danger text-center mt-3"></p>
        </div>
    </div>
</body>

<script src="/java/checkQRCode.js"></script>

</html>