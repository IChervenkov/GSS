<div id="<%= id %>Modal" class="modal">
    <form class="modal-content" action="<%= destination %>" method="POST" id="<%= formId %>">
        <span class="close-btn">&times;</span>
        <h2 style="margin-bottom: 25px;">
            <%= title %>
        </h2>

        <div class="mb-3 search-container" id="<%= searchId %>">
            <label for="<%= inputSearchId %>" class="form-label"><%= labelSearch %>:</label>
                <input type="text" id="<%= inputSearchId %>" class="form-control" placeholder="<%= labelSearch %>...">
                <div class="invalid-feedback"></div>
                <div class="valid-feedback"></div>
            <ul id="<%= dropDownSearchId %>" class="list-group"></ul> <!-- Custom dropdown for search -->
            <input type="hidden" id="<%= selectSearchId %>" value="">
            <!-- To store the selected soldier ID -->
        </div>

        <input type="hidden" id="destination" value="">
        <input type="hidden" id="prev_destination" value="">

        <button type="submit" id="<%= buttonId %>" class="modal-button"><%= buttonText %></button>
    </form>
</div>