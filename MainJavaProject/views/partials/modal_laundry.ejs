<div id="<%= id %>Modal" class="modal">
    <div class="modal-content">
        <span class="close-btn">&times;</span>
        <h2>
            <%= title %>
                <div class="group-button">
                    <button type="button" class="btn btn-outline-success btn-sm rounded-circle fw-bold ml-3" id="addBag"
                        data-destination="<%= destination %>" data-preview="<%= previewDestination %>">+</button>
                    <% if(id != 'readyToPickUp') { %>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-circle fw-bold mx-2"
                        id="moveBag" data-destination="<%= destination %>"
                        data-preview="<%= previewDestination %>">↔</button> <% } %>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-circle fw-bold" id="removeBag"
                        data-destination="<%= destination %>" data-preview="<%= previewDestination %>">−</button>
                </div>
        </h2>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <% headerTable.forEach(item=> { %>
                            <th>
                                <%= item.name %>
                            </th>
                            <% }); %>
                    </tr>
                </thead>
                <tbody id="<%= id %>TableBody"></tbody>
            </table>
        </div>
    </div>
</div>