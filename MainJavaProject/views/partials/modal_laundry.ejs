<div id="<%= id %>Modal" class="modal">
    <div class="modal-content">
        <span class="close-btn">&times;</span>
        <h2>
            <%= title %>
                <div class="group-button d-flex align-items-center">

                    <!-- Add Bag -->
                    <div class="btn-container" <% if (permissions && !(permissions.some(p=> p.permission_name === 'Full permission' || p.permission_name === 'Add status bag'))) { %>
                        style="cursor: not-allowed"
                        <% } %>>
                            <button type="button"
                                class="btn btn-outline-success btn-sm rounded-circle fw-bold ms-3 <% if (permissions && !(permissions.some(p => p.permission_name === 'Full permission' || p.permission_name === 'Add status bag'))) { %> disabled-button <% } %>"
                                id="addBag" data-destination="<%= destination %>"
                                data-preview="<%= previewDestination %>">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                            <div class="tooltip-custom">
                                <i class="bi bi-question-circle"></i>
                                <span class="tooltiptext">Add bag in this section</span>
                            </div>
                    </div>

                    <!-- Move Bag -->
                    <% if (id !='readyToPickUp' ) { %>
                        <div class="btn-container" <% if (permissions && !(permissions.some(p=> p.permission_name ===
                            'Full permission' || p.permission_name === 'Move status bag'))) { %>
                            style="cursor: not-allowed"
                            <% } %>>
                                <button type="button"
                                    class="btn btn-outline-primary btn-sm rounded-circle fw-bold mx-2 <% if (permissions && !(permissions.some(p => p.permission_name === 'Full permission' || p.permission_name === 'Move status bag'))) { %> disabled-button <% } %>"
                                    id="moveBag" data-destination="<%= destination %>"
                                    data-preview="<%= previewDestination %>">
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                                <div class="tooltip-custom">
                                    <i class="bi bi-question-circle"></i>
                                    <span class="tooltiptext">Move bag to another section</span>
                                </div>
                        </div>
                        <% } %>

                            <!-- Remove Bag -->
                            <div class="btn-container" <% if (permissions && !(permissions.some(p=> p.permission_name
                                === 'Full permission' || p.permission_name === 'Remove status bag'))) { %>
                                style="cursor: not-allowed"
                                <% } %>>
                                    <button type="button"
                                        class="btn btn-outline-danger btn-sm rounded-circle fw-bold <% if(id == 'readyToPickUp') { %> mx-2 <% } %> <% if (permissions && !(permissions.some(p => p.permission_name === 'Full permission' || p.permission_name === 'Remove status bag'))) { %> disabled-button <% } %>"
                                        id="removeBag" data-destination="<%= destination %>"
                                        data-preview="<%= previewDestination %>">
                                        <i class="bi bi-dash-lg"></i>
                                    </button>
                                    <div class="tooltip-custom">
                                        <i class="bi bi-question-circle"></i>
                                        <span class="tooltiptext">Remove bag from this section</span>
                                    </div>
                            </div>

                            <!-- Linen Exchange -->
                            <div class="btn-container" <% if (permissions && !(permissions.some(p=> p.permission_name
                                === 'Full permission' || p.permission_name === 'Linen exchange'))) { %>
                                style="cursor: not-allowed"
                                <% } %>>
                                    <button type="button"
                                        class="btn btn-outline-warning btn-sm rounded-circle fw-bold <% if(id != 'readyToPickUp') { %> mx-2 <% } %> <% if (permissions && !(permissions.some(p => p.permission_name === 'Full permission' || p.permission_name === 'Linen exchange'))) { %> disabled-button <% } %>"
                                        id="linenExchange" data-destination="<%= destination %>"
                                        data-preview="<%= previewDestination %>">
                                        <i class="bi bi-recycle"></i>
                                    </button>
                                    <div class="tooltip-custom">
                                        <i class="bi bi-question-circle"></i>
                                        <span class="tooltiptext">Linen Exchange Service</span>
                                    </div>
                            </div>

                </div>
        </h2>

        <div class="d-flex justify-content-end mt-2 mb-2">
            <button type="button" id="prevBtn<%= id %>"></button>
            <span id="pageNumber<%= id %>"></span>
            <button type="button" id="nextBtn<%= id %>"></button>
        </div>

        <div class="table-container">
            <table id="<%= id %>Table">
                <thead>
                    <tr>
                        <% headerTable.forEach(item=> { %>
                            <th>
                                <div <% if (headerTable.length - 1===headerTable.indexOf(item)) { %> style="cursor:
                                    not-allowed;" <% } %>>
                                        <input type="text"
                                            class="<%= id %>-search-input<% if (headerTable.length - 1 === headerTable.indexOf(item)) { %> disabled-button<% } %>"
                                            placeholder="Search...">
                                </div>
                                <%= item.name %>
                            </th>
                            <% }); %>
                    </tr>
                </thead>
                <tbody id="<%= id %>TableBody"></tbody>
            </table>
        </div>
    </div>
</div>