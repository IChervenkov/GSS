<!doctype html>
<html lang="en">
<%- await include('../../../../shared/views/partials/workspace/head', {
  title,
  pageStyles: ['/assets/bicycles/css/bicycles-page.css']
}) %>

<body class="main-workspace" data-page="bicycles-page" data-current-camp-id="<%= campId || '' %>" data-can-download-bike-mobile-app="<%= canDownloadBikeMobileApp ? 'true' : 'false' %>">
  <%- await include('../../../../shared/views/partials/common/a11y-primitives') %>
  <%- await include('../../../../shared/views/partials/workspace/icons') %>
  <%- await include('../../../../shared/views/partials/common/page-data', { pageData: { pageKey: 'bicycles-page', campId: campId || '', currentNav: 'Bicycles' } }) %>

  <input type="hidden" id="csrf-token" value="<%= csrfToken %>" />

  <%- await include('../../../../shared/views/partials/workspace/topbar', {
    navItems: horizontalNavItems,
    currentNav: 'Bicycles',
    csrfToken
  }) %>

  <main class="workspace-shell" id="main-content" data-state-root="true">
    <section class="hero-card">
      <div class="hero-card__content">
        <span class="hero-card__eyebrow">Bike desk</span>
        <h1 class="hero-card__title"><%= title %></h1>
        <p class="hero-card__text">Track camp bicycles, paired helmets, rider assignments, and return follow-up from one operating view.</p>
        <div class="hero-card__meta">
          <span class="hero-chip"><svg class="icon" aria-hidden="true">
              <use href="#icon-bicycle"></use>
            </svg><span>Fleet status</span></span>
          <span class="hero-chip"><svg class="icon" aria-hidden="true">
              <use href="#icon-helmet"></use>
            </svg><span>Helmet pairings</span></span>
          <span class="hero-chip"><svg class="icon" aria-hidden="true">
              <use href="#icon-clock-history"></use>
            </svg><span>Return checks</span></span>
        </div>
        <div class="hero-card__actions hero-card__actions--mobile-download">
          <button class="btn btn-primary hero-card__mobile-download-button" id="download-bike-mobile-app-button" type="button" data-download-url="<%= bikeMobileAppDownloadUrl %>" <%= canDownloadBikeMobileApp ? '' : 'disabled aria-disabled="true"' %> title="<%= canDownloadBikeMobileApp ? 'Download the bicycle mobile app.' : 'You do not have permission to download the bicycle mobile app.' %>">
            <svg class="icon" aria-hidden="true">
              <use href="#icon-download"></use>
            </svg>
            <span>Download bicycle mobile app</span>
          </button>
        </div>
      </div>
    </section>

    <section class="summary-grid" aria-label="Bicycle summary">
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Available</span><svg class="icon" aria-hidden="true">
            <use href="#icon-check-circle"></use>
          </svg></div>
        <div class="summary-card__value" id="bike-count-available">-</div>
        <p class="summary-card__text">Bikes available for issue at the selected camp.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Rented</span><svg class="icon" aria-hidden="true">
            <use href="#icon-bicycle"></use>
          </svg></div>
        <div class="summary-card__value" id="bike-count-rented">-</div>
        <p class="summary-card__text">Short-term rentals currently checked out to soldiers.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Repair</span><svg class="icon" aria-hidden="true">
            <use href="#icon-refresh"></use>
          </svg></div>
        <div class="summary-card__value" id="bike-count-repair">-</div>
        <p class="summary-card__text">Bikes held back for repair, inspection, or cleanup.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Late</span><svg class="icon" aria-hidden="true">
            <use href="#icon-clock-history"></use>
          </svg></div>
        <div class="summary-card__value" id="bike-count-late">-</div>
        <p class="summary-card__text">Rentals that need return confirmation or follow-up.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Long term</span><svg class="icon" aria-hidden="true">
            <use href="#icon-helmet"></use>
          </svg></div>
        <div class="summary-card__value" id="bike-count-long-term">-</div>
        <p class="summary-card__text">Long-term assignments that stay visible in the fleet count.</p>
      </article>
    </section>

    <section class="workspace-panels" aria-label="Bicycle workspace">
      <div class="tab-bar" role="tablist" aria-label="Bicycle sections">
        <button class="tab-pill is-active" type="button" role="tab" data-tab-trigger="overview" aria-selected="true">Overview</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="bikes" aria-selected="false">Bikes</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="helmets" aria-selected="false">Helmets</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="report" aria-selected="false">Report</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="guide" aria-selected="false">Guide</button>
      </div>

      <section class="tab-panel is-active" id="tab-overview" data-tab-panel="overview" role="tabpanel" hidden>
        <div class="panel-card">
          <div class="panel-card__header">
            <div>
              <span class="panel-card__eyebrow">Operational overview</span>
              <h2 class="panel-card__title">Fleet pressure and return follow-up</h2>
            </div>
            <div class="panel-card__actions">
              <button class="btn btn-secondary" type="button" id="refresh-bicycles-button">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-refresh"></use>
                </svg>
                <span>Refresh</span>
              </button>
            </div>
          </div>
          <div class="overview-grid">
            <article class="mini-card">
              <h3 class="mini-card__title">Total tracked bikes</h3>
              <p class="bicycles-metric" id="bike-count-total">0</p>
            </article>
            <article class="mini-card">
              <h3 class="mini-card__title">Helmet pairings</h3>
              <p class="bicycles-metric" id="helmet-pairing-count">0</p>
            </article>
            <article class="mini-card">
              <h3 class="mini-card__title">Needs attention</h3>
              <p class="bicycles-metric" id="bike-count-attention">0</p>
            </article>
          </div>
        </div>
      </section>

      <section class="tab-panel" id="tab-bikes" data-tab-panel="bikes" role="tabpanel">
        <div class="panel-card">
          <div class="panel-card__header">
            <div>
              <span class="panel-card__eyebrow">Bike fleet</span>
              <h2 class="panel-card__title">Bikes by assignment and condition</h2>
            </div>
            <div class="panel-card__actions">
              <button class="btn btn-primary" type="button" id="open-add-bicycle-modal">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-plus-circle"></use>
                </svg>
                <span>Add bike</span>
              </button>
              <button class="btn btn-secondary" type="button" id="open-bulk-bicycle-import-modal">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-download"></use>
                </svg>
                <span>Bulk update</span>
              </button>
              <button class="btn btn-secondary" type="button" id="refresh-bikes-table-button">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-refresh"></use>
                </svg>
                <span>Refresh</span>
              </button>
            </div>
          </div>
          <div class="table-shell">
            <table class="data-table">
              <thead>
                <tr>
                  <th id="bicycle-id-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="bicycle-search-id-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="bicycle-search-id-input" type="search" placeholder="Search identifier" autocomplete="off" data-bicycle-filter-column="id" /></label>
                      <button class="sort-header-button" type="button" data-bicycle-sort-column="id" aria-label="Sort by identifier">
                        <span>Identifier</span>
                        <span class="sort-header-button__indicator" data-bicycle-sort-indicator="id" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="bicycle-name-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="bicycle-search-name-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="bicycle-search-name-input" type="search" placeholder="Search bicycle" autocomplete="off" data-bicycle-filter-column="name" /></label>
                      <button class="sort-header-button" type="button" data-bicycle-sort-column="name" aria-label="Sort by bicycle">
                        <span>Bicycle</span>
                        <span class="sort-header-button__indicator" data-bicycle-sort-indicator="name" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="bicycle-nfc-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="bicycle-search-nfc-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="bicycle-search-nfc-input" type="search" placeholder="Search NFC" autocomplete="off" data-bicycle-filter-column="nfcCode" /></label>
                      <button class="sort-header-button" type="button" data-bicycle-sort-column="nfcCode" aria-label="Sort by NFC code">
                        <span>NFC code</span>
                        <span class="sort-header-button__indicator" data-bicycle-sort-indicator="nfcCode" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="bicycle-status-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="bicycle-search-status-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="bicycle-search-status-input" type="search" placeholder="Search status" autocomplete="off" data-bicycle-filter-column="status" /></label>
                      <button class="sort-header-button" type="button" data-bicycle-sort-column="status" aria-label="Sort by status">
                        <span>Status</span>
                        <span class="sort-header-button__indicator" data-bicycle-sort-indicator="status" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="bicycle-soldier-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="bicycle-search-soldier-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="bicycle-search-soldier-input" type="search" placeholder="Search soldier" autocomplete="off" data-bicycle-filter-column="assignedSoldier" /></label>
                      <button class="sort-header-button" type="button" data-bicycle-sort-column="assignedSoldier" aria-label="Sort by assigned soldier">
                        <span>Assigned soldier</span>
                        <span class="sort-header-button__indicator" data-bicycle-sort-indicator="assignedSoldier" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="bicycle-helmet-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="bicycle-search-helmet-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="bicycle-search-helmet-input" type="search" placeholder="Search helmet" autocomplete="off" data-bicycle-filter-column="helmetCode" /></label>
                      <button class="sort-header-button" type="button" data-bicycle-sort-column="helmetCode" aria-label="Sort by helmet">
                        <span>Helmet</span>
                        <span class="sort-header-button__indicator" data-bicycle-sort-indicator="helmetCode" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="bicycle-rented-at-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="bicycle-search-rented-at-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="bicycle-search-rented-at-input" type="search" placeholder="Search rental date" autocomplete="off" data-bicycle-filter-column="rentedAt" /></label>
                      <button class="sort-header-button" type="button" data-bicycle-sort-column="rentedAt" aria-label="Sort by rental date and time">
                        <span>Rental date</span>
                        <span class="sort-header-button__indicator" data-bicycle-sort-indicator="rentedAt" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th class="table-action-col">Action</th>
                </tr>
              </thead>
              <tbody id="bicycles-table-body">
                <tr>
                  <td colspan="8" class="table-empty">Bike records will appear here after the fleet overview loads.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="pagination-row">
            <button class="btn btn-ghost" type="button" id="bikes-prev-button">Previous</button>
            <span id="bikes-page-label" class="pagination-label">Page 1</span>
            <button class="btn btn-ghost" type="button" id="bikes-next-button">Next</button>
          </div>
        </div>
      </section>

      <section class="tab-panel" id="tab-helmets" data-tab-panel="helmets" role="tabpanel" hidden>
        <div class="panel-card">
          <div class="panel-card__header">
            <div>
              <span class="panel-card__eyebrow">Helmet tracking</span>
              <h2 class="panel-card__title">Helmets by assignment and availability</h2>
            </div>
            <div class="panel-card__actions">
              <button class="btn btn-primary" type="button" id="open-add-helmet-modal">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-plus-circle"></use>
                </svg>
                <span>Add helmet</span>
              </button>
              <button class="btn btn-secondary" type="button" id="open-bulk-helmet-import-modal">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-download"></use>
                </svg>
                <span>Bulk update</span>
              </button>
              <button class="btn btn-secondary" type="button" id="refresh-helmets-table-button">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-refresh"></use>
                </svg>
                <span>Refresh</span>
              </button>
            </div>
          </div>
          <div class="table-shell">
            <table class="data-table">
              <thead>
                <tr>
                  <th id="helmet-id-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="helmet-search-id-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="helmet-search-id-input" type="search" placeholder="Search identifier" autocomplete="off" data-helmet-filter-column="id" /></label>
                      <button class="sort-header-button" type="button" data-helmet-sort-column="id" aria-label="Sort by identifier">
                        <span>Identifier</span>
                        <span class="sort-header-button__indicator" data-helmet-sort-indicator="id" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="helmet-code-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="helmet-search-code-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="helmet-search-code-input" type="search" placeholder="Search helmet" autocomplete="off" data-helmet-filter-column="code" /></label>
                      <button class="sort-header-button" type="button" data-helmet-sort-column="code" aria-label="Sort by helmet code">
                        <span>Helmet</span>
                        <span class="sort-header-button__indicator" data-helmet-sort-indicator="code" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="helmet-nfc-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="helmet-search-nfc-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="helmet-search-nfc-input" type="search" placeholder="Search NFC" autocomplete="off" data-helmet-filter-column="nfcCode" /></label>
                      <button class="sort-header-button" type="button" data-helmet-sort-column="nfcCode" aria-label="Sort by helmet NFC code">
                        <span>NFC code</span>
                        <span class="sort-header-button__indicator" data-helmet-sort-indicator="nfcCode" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="helmet-bicycle-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="helmet-search-bicycle-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="helmet-search-bicycle-input" type="search" placeholder="Search bicycle" autocomplete="off" data-helmet-filter-column="bicycleName" /></label>
                      <button class="sort-header-button" type="button" data-helmet-sort-column="bicycleName" aria-label="Sort by linked bicycle">
                        <span>Linked bicycle</span>
                        <span class="sort-header-button__indicator" data-helmet-sort-indicator="bicycleName" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="helmet-soldier-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="helmet-search-soldier-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="helmet-search-soldier-input" type="search" placeholder="Search soldier" autocomplete="off" data-helmet-filter-column="assignedSoldier" /></label>
                      <button class="sort-header-button" type="button" data-helmet-sort-column="assignedSoldier" aria-label="Sort by assigned soldier">
                        <span>Assigned soldier</span>
                        <span class="sort-header-button__indicator" data-helmet-sort-indicator="assignedSoldier" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="helmet-status-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="helmet-search-status-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="helmet-search-status-input" type="search" placeholder="Search status" autocomplete="off" data-helmet-filter-column="status" /></label>
                      <button class="sort-header-button" type="button" data-helmet-sort-column="status" aria-label="Sort by status">
                        <span>Status</span>
                        <span class="sort-header-button__indicator" data-helmet-sort-indicator="status" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th class="table-action-col">Action</th>
                </tr>
              </thead>
              <tbody id="helmets-table-body">
                <tr>
                  <td colspan="7" class="table-empty">Helmet records will appear here after the fleet overview loads.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="pagination-row">
            <button class="btn btn-ghost" type="button" id="helmets-prev-button">Previous</button>
            <span id="helmets-page-label" class="pagination-label">Page 1</span>
            <button class="btn btn-ghost" type="button" id="helmets-next-button">Next</button>
          </div>
        </div>
      </section>

      <section class="tab-panel" id="tab-report" data-tab-panel="report" role="tabpanel" hidden>
        <div class="panel-card">
          <div class="panel-card">
            <div class="panel-card__header">
              <div>
                <span class="panel-card__eyebrow">Search information</span>
                <h2 class="panel-card__title">Search bicycles and helmets information</h2>
              </div>
            </div>
            <div class="report-tools-grid">
              <section class="report-section" aria-label="Selected bike or helmet rental history">
                <div class="report-section__header">
                  <h3 class="report-section__title">Bike / helmet lookup</h3>
                  <div class="segmented-control" role="group" aria-label="Asset type">
                    <label class="segmented-control__item" for="report-asset-type-bike">
                      <input id="report-asset-type-bike" type="radio" name="reportAssetType" value="bicycle" checked />
                      <span>Bike</span>
                    </label>
                    <label class="segmented-control__item" for="report-asset-type-helmet">
                      <input id="report-asset-type-helmet" type="radio" name="reportAssetType" value="helmet" />
                      <span>Helmet</span>
                    </label>
                  </div>
                </div>
                <input type="hidden" id="report-asset-id-input" />
                <div class="field lookup-field">
                  <label for="report-asset-search-input">Bike or helmet</label>
                  <div class="lookup-combobox" data-lookup-combobox>
                    <div class="lookup-combobox__control">
                      <svg class="icon" aria-hidden="true">
                        <use href="#icon-search"></use>
                      </svg>
                      <input id="report-asset-search-input" type="search" placeholder="Search bike" autocomplete="off" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" aria-controls="report-asset-options" />
                      <span class="lookup-combobox__chevron" aria-hidden="true"></span>
                    </div>
                    <div class="lookup-menu" id="report-asset-options" role="listbox" aria-label="Bike and helmet results" hidden></div>
                  </div>
                </div>
                <div class="table-shell">
                  <table class="data-table data-table--report">
                    <thead>
                      <tr>
                        <th>Rented at</th>
                        <th>Returned at</th>
                        <th>Status</th>
                        <th>Bicycle</th>
                        <th>Bicycle NFC</th>
                        <th>Soldier</th>
                        <th>Helmet</th>
                        <th>Helmet NFC</th>
                      </tr>
                    </thead>
                    <tbody id="report-asset-history-body">
                      <tr>
                        <td colspan="8" class="table-empty">Select a bike or helmet.</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </section>
              <section class="report-section" aria-label="Soldier active bicycle and helmet assignments">
                <div class="report-section__header">
                  <h3 class="report-section__title">Soldier in-use lookup</h3>
                </div>
                <input type="hidden" id="report-soldier-id-input" />
                <div class="field lookup-field">
                  <label for="report-soldier-search-input">Soldier</label>
                  <div class="lookup-combobox" data-lookup-combobox>
                    <div class="lookup-combobox__control">
                      <svg class="icon" aria-hidden="true">
                        <use href="#icon-search"></use>
                      </svg>
                      <input id="report-soldier-search-input" type="search" placeholder="Search soldier" autocomplete="off" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" aria-controls="report-soldier-options" />
                      <span class="lookup-combobox__chevron" aria-hidden="true"></span>
                    </div>
                    <div class="lookup-menu" id="report-soldier-options" role="listbox" aria-label="Soldier results" hidden></div>
                  </div>
                </div>
                <div class="table-shell">
                  <table class="data-table data-table--soldier-report">
                    <thead>
                      <tr>
                        <th>Bicycle</th>
                        <th>Bicycle NFC</th>
                        <th>Helmet</th>
                        <th>Helmet NFC</th>
                        <th>Status</th>
                        <th>Rented at</th>
                      </tr>
                    </thead>
                    <tbody id="report-soldier-active-body">
                      <tr>
                        <td colspan="6" class="table-empty">Select a soldier.</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </section>
            </div>
          </div>
          <div class="panel-card">
            <div class="panel-card__header">
              <div>
                <span class="panel-card__eyebrow">Rental history</span>
                <h2 class="panel-card__title">Bicycles and helmets rented by date</h2>
              </div>
            </div>
            <form class="report-filter-bar" id="bicycle-report-filter-form">
              <label class="field" for="bicycle-report-from-date-input">
                <span>From</span>
                <span class="input-icon-field">
