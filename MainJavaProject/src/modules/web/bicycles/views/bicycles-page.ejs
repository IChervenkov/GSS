          <use href="#icon-search"></use>
        </svg>
        <input id="rent-soldier-search-input" type="search" placeholder="Search soldier" autocomplete="off" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" aria-controls="rent-soldier-options" required />
        <span class="lookup-combobox__chevron" aria-hidden="true"></span>
      </div>
      <div class="lookup-menu" id="rent-soldier-options" role="listbox" aria-label="Soldier results" hidden></div>
    </div>
  </div>
  <div class="field lookup-field">
    <label for="rent-helmet-search-input">Helmet</label>
    <div class="lookup-combobox" data-lookup-combobox>
      <div class="lookup-combobox__control">
        <svg class="icon" aria-hidden="true">
          <use href="#icon-helmet"></use>
        </svg>
        <input id="rent-helmet-search-input" type="search" placeholder="Search helmet" autocomplete="off" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" aria-controls="rent-helmet-options" />
        <span class="lookup-combobox__chevron" aria-hidden="true"></span>
      </div>
      <div class="lookup-menu" id="rent-helmet-options" role="listbox" aria-label="Helmet results" hidden></div>
    </div>
  </div>
  <div class="field">
    <label for="rent-date-input">Rental date and time</label>
    <div class="input-icon-field">
      <svg class="icon" aria-hidden="true">
        <use href="#icon-calendar"></use>
      </svg>
      <input id="rent-date-input" name="rentedAt" type="datetime-local" required />
    </div>
  </div>
  <label class="check-field" for="rent-long-term-input">
    <input id="rent-long-term-input" name="longTerm" type="checkbox" />
    <span>Long-term status</span>
  </label>
  <div class="workspace-form__actions">
    <button type="submit" class="btn btn-primary" id="rent-bicycle-submit-button">Rent bike</button>
    <button type="button" class="btn btn-ghost" data-close-modal="true">Cancel</button>
  </div>
</form>`
  }) %>

