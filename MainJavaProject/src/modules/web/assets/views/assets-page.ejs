<!doctype html>
<html lang="en">
<%- await include('../../../../shared/views/partials/workspace/head', {
  title,
  pageStyles: ['/assets/assets/css/assets-page.css']
}) %>

<%
  const viewData = typeof locals !== 'undefined' ? locals : {};
  const resolvedHighlights = Array.isArray(viewData.highlights) ? viewData.highlights : [];
  const resolvedAllAssets = Array.isArray(viewData.allAssets) ? viewData.allAssets : [];
  const resolvedInventoryStatusRows = Array.isArray(viewData.inventoryStatusRows) ? viewData.inventoryStatusRows : [];
  const resolvedInventoryEvents = Array.isArray(viewData.inventoryEvents) ? viewData.inventoryEvents : [];
  const resolvedAssetTypes = Array.isArray(viewData.assetTypes) ? viewData.assetTypes : [];
  const resolvedCleanItems = Array.isArray(viewData.cleanItems) ? viewData.cleanItems : [];
  const visibleCleanItems = resolvedCleanItems.filter((item) => item.warehouse === 'large');
  const cleanItemSummary = viewData.cleanItemSummary && typeof viewData.cleanItemSummary === 'object' ? viewData.cleanItemSummary : {};
  const resolvedCanDownloadAssetsMobileApp = Boolean(viewData.canDownloadAssetsMobileApp);
  const resolvedAssetsMobileAppDownloadUrl = viewData.assetsMobileAppDownloadUrl || '/web/assets/mobile-app';
  const resolvedPermissionNames = new Set((Array.isArray(viewData.permissionNames) ? viewData.permissionNames : []).map((name) => String(name || '').trim()).filter(Boolean));
  const hasAssetsPermission = (...names) => resolvedPermissionNames.has('Full permission') || names.some((name) => resolvedPermissionNames.has(name));
  const canAddAsset = hasAssetsPermission('Add asset');
  const canEditAsset = hasAssetsPermission('Edit asset');
  const canDeleteAsset = hasAssetsPermission('Remove asset');
  const canBulkAssets = canAddAsset || canEditAsset;
  const canSaveInventory = hasAssetsPermission('Save inventory');
  const canAddAssetType = hasAssetsPermission('Add asset type');
  const canEditAssetType = hasAssetsPermission('Edit asset type');
  const canDeleteAssetType = hasAssetsPermission('Remove asset type');
  const canBulkAssetTypes = canAddAssetType || canEditAssetType;
  const canAddCleanItem = hasAssetsPermission('Add clean item');
  const canEditCleanItem = hasAssetsPermission('Edit clean item');
  const canMoveCleanItem = hasAssetsPermission('Move clean item');
  const canDeleteCleanItem = hasAssetsPermission('Remove clean item');
  const canBulkCleanItems = canAddCleanItem || canEditCleanItem;
  const assetTemplateDownloadAttrs = canBulkAssets ? '' : 'aria-disabled="true" tabindex="-1"';
  const assetTemplateInputAttrs = canBulkAssets ? '' : 'disabled';
  const assetTypeTemplateDownloadAttrs = canBulkAssetTypes ? '' : 'aria-disabled="true" tabindex="-1"';
  const assetTypeTemplateInputAttrs = canBulkAssetTypes ? '' : 'disabled';
  const cleanItemTemplateDownloadAttrs = canBulkCleanItems ? '' : 'aria-disabled="true" tabindex="-1"';
  const cleanItemTemplateInputAttrs = canBulkCleanItems ? '' : 'disabled';
  const tableMeta = viewData.tables && typeof viewData.tables === 'object' ? viewData.tables : {};
  const allAssetColumns = [
    { key: 'id', label: 'Identifier', search: 'Search identifier' },
    { key: 'code', label: 'Code', search: 'Search code' },
    { key: 'rfidCode', label: 'RFID code', search: 'Search RFID' },
    { key: 'name', label: 'Name', search: 'Search name' },
    { key: 'typeName', label: 'Type', search: 'Search type' },
    { key: 'location', label: 'Location', search: 'Search location' },
    { key: 'status', label: 'Status', search: 'Search status' },
    { key: 'inventoryStatus', label: 'Inventory', search: 'Search inventory' },
    { key: 'lastInventoryDate', label: 'Last inventory', search: 'Search date' },
    { key: 'owner', label: 'Owner', search: 'Search owner' },
    { key: 'category', label: 'Category', search: 'Search category' },
    { key: 'service', label: 'Service', search: 'Search service' },
    { key: 'expandable', label: 'Expandable', search: 'Search expandable' },
    { key: 'isFixedLabel', label: 'Fixed', search: 'Search fixed' },
    { key: 'isQuantitativeLabel', label: 'Quantitative', search: 'Search quantitative' },
    { key: 'description', label: 'Description', search: 'Search description' },
    { key: 'mrah', label: 'MRAH', search: 'Search MRAH' },
    { key: 'comments', label: 'Comments', search: 'Search comments' },
    { key: 'replacedOff', label: 'Replaced off', search: 'Search replaced off' },
    { key: 'replacedBy', label: 'Replaced by', search: 'Search replaced by' },
    { key: 'purchaseDate', label: 'Purchase date', search: 'Search purchase date' },
    { key: 'writtenOffDate', label: 'Written off', search: 'Search written off date' },
    { key: 'createdAt', label: 'Created', search: 'Search created date' },
    { key: 'updatedAt', label: 'Updated', search: 'Search updated date' },
    { key: 'm2Inside', label: 'M2 inside', searchable: false },
    { key: 'yearOfLifeCycle', label: 'Lifecycle year', searchable: false },
    { key: 'restOfLifeCycle', label: 'Lifecycle rest', searchable: false },
    { key: 'restValue', label: 'Rest value', searchable: false },
    { key: 'purchasePrice', label: 'Purchase price', searchable: false },
    { key: 'quantity', label: 'Quantity', searchable: false },
    { key: 'actions', label: 'Actions', searchable: false, sortable: false }
  ];
  const statusColumns = [
    { key: 'status', label: 'Status', search: 'Search status' },
    { key: 'lastInventoryDate', label: 'Last inventory', search: 'Search date' },
    { key: 'assetCount', label: 'Assets', searchable: false },
    { key: 'quantity', label: 'Quantity', searchable: false }
  ];
  const eventColumns = [
    { key: 'changedAt', label: 'Date', search: 'Search date' },
    { key: 'addedQuantity', label: 'Added', searchable: false },
    { key: 'removedQuantity', label: 'Removed', searchable: false },
    { key: 'lostQuantity', label: 'Lost', searchable: false },
    { key: 'modifiedQuantity', label: 'Updated', searchable: false }
  ];
  const typeColumns = [
    { key: 'id', label: 'Identifier', search: 'Search identifier' },
    { key: 'name', label: 'Type', search: 'Search type' },
    { key: 'assetCount', label: 'Assets', searchable: false },
    { key: 'notFoundCount', label: 'Not found', searchable: false },
    { key: 'completedCount', label: 'Completed', searchable: false },
    { key: 'actions', label: 'Actions', searchable: false, sortable: false }
  ];
  const cleanItemColumns = [
    { key: 'id', label: 'Identifier', search: 'Search identifier' },
    { key: 'itemName', label: 'Item', search: 'Search item' },
    { key: 'totalAmount', label: 'Total', searchable: false },
    { key: 'countGetItem', label: 'Checked out', searchable: false },
    { key: 'availableAmount', label: 'Available', searchable: false },
    { key: 'actions', label: 'Actions', searchable: false, sortable: false }
  ];
  const pageLabel = (meta) => {
    const total = Number(meta && meta.total) || 0;
    const page = Number(meta && meta.page) || 1;
    const totalPages = Number(meta && meta.totalPages) || 1;
    return total > 0 ? `Page ${page} of ${totalPages}` : 'Page 1 of 1';
  };
%>

<body class="main-workspace" data-page="<%= pageKey %>" data-current-camp-id="<%= campId || '' %>" data-can-download-assets-mobile-app="<%= resolvedCanDownloadAssetsMobileApp ? 'true' : 'false' %>">
  <%- await include('../../../../shared/views/partials/common/a11y-primitives') %>
  <%- await include('../../../../shared/views/partials/workspace/icons') %>
  <%- await include('../../../../shared/views/partials/common/page-data', { pageData: { pageKey, campId: campId || '', currentNav, permissionNames: Array.from(resolvedPermissionNames) } }) %>

  <input type="hidden" id="csrf-token" value="<%= csrfToken %>" />

  <%- await include('../../../../shared/views/partials/workspace/topbar', {
    navItems: horizontalNavItems,
    currentNav,
    csrfToken
  }) %>

  <main class="workspace-shell assets-page" id="main-content">
    <section class="hero-card">
      <div class="hero-card__content">
        <span class="hero-card__eyebrow"><%= eyebrow %></span>
        <h1 class="hero-card__title"><%= title %></h1>
        <p class="hero-card__text"><%= intro %></p>
        <div class="hero-card__meta">
          <% resolvedHighlights.forEach((item) => { %>
          <span class="hero-chip"><svg class="icon" aria-hidden="true">
              <use href="#icon-box"></use>
            </svg><span><%= item %></span></span>
          <% }) %>
        </div>
        <div class="hero-card__actions hero-card__actions--mobile-download">
          <button class="btn btn-primary hero-card__mobile-download-button" id="download-assets-mobile-app-button" type="button" data-download-url="<%= resolvedAssetsMobileAppDownloadUrl %>" <%= resolvedCanDownloadAssetsMobileApp ? '' : 'disabled' %> title="<%= resolvedCanDownloadAssetsMobileApp ? 'Download the assets mobile app.' : 'You do not have permission to download the assets mobile app.' %>">
            <svg class="icon" aria-hidden="true">
              <use href="#icon-download"></use>
            </svg>
            <span>Download assets mobile app</span>
          </button>
        </div>
      </div>
    </section>

    <% if (Boolean(viewData.campRequired)) { %>
    <section class="inline-banner" role="status">
      Select an active camp from the main page to load assets, inventory tracking, and type totals.
    </section>
    <% } %>

    <section class="summary-grid" aria-label="Asset summary">
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Assets</span><svg class="icon" aria-hidden="true">
            <use href="#icon-box"></use>
          </svg></div>
        <div class="summary-card__value" id="assets-summary-total"><%= viewData.totalAssets || 0 %></div>
        <p class="summary-card__text">Asset records in the selected camp.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Quantity</span><svg class="icon" aria-hidden="true">
            <use href="#icon-inbox"></use>
          </svg></div>
        <div class="summary-card__value" id="assets-summary-quantity"><%= viewData.totalQuantity || '0' %></div>
        <p class="summary-card__text">Total quantity across tracked assets.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Not found</span><svg class="icon" aria-hidden="true">
            <use href="#icon-search"></use>
          </svg></div>
        <div class="summary-card__value" id="assets-summary-not-found"><%= viewData.notFoundAssets || 0 %></div>
        <p class="summary-card__text">Assets still marked as undiscovered.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Completed</span><svg class="icon" aria-hidden="true">
            <use href="#icon-check-circle"></use>
          </svg></div>
        <div class="summary-card__value" id="assets-summary-completed"><%= viewData.completedAssets || 0 %></div>
        <p class="summary-card__text">Assets confirmed during inventory.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Types</span><svg class="icon" aria-hidden="true">
            <use href="#icon-filter"></use>
          </svg></div>
        <div class="summary-card__value" id="assets-summary-types"><%= viewData.typeCount || 0 %></div>
        <p class="summary-card__text">Asset types available in the system.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Clean items</span><svg class="icon" aria-hidden="true">
            <use href="#icon-inbox"></use>
          </svg></div>
        <div class="summary-card__value" id="assets-summary-clean-items"><%= cleanItemSummary.totalItems || 0 %></div>
        <p class="summary-card__text">Items stored across large and small warehouses.</p>
      </article>
    </section>

    <section class="workspace-panels" aria-label="Asset information">
      <div class="tab-bar" role="tablist" aria-label="Asset sections">
        <button class="tab-pill is-active" type="button" role="tab" data-tab-trigger="overview" aria-selected="true">Overview</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="all-assets" aria-selected="false">All assets</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="inventory-tracking" aria-selected="false">Inventory tracking</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="asset-types" aria-selected="false">Asset types</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="clean-items" aria-selected="false">Clean items</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="guide" aria-selected="false">Guide</button>
      </div>

      <section class="tab-panel is-active" id="tab-overview" data-tab-panel="overview" role="tabpanel">
        <div class="panel-card">
          <div class="panel-card__header">
            <div>
              <span class="panel-card__eyebrow">Operational overview</span>
              <h2 class="panel-card__title">Inventory coverage and asset pressure</h2>
            </div>
            <div class="panel-card__actions">
              <button class="btn btn-secondary" type="button" data-refresh-assets>
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-refresh"></use>
                </svg>
                <span>Refresh</span>
              </button>
            </div>
          </div>
          <div class="overview-grid">
            <article class="mini-card">
              <h3 class="mini-card__title">Completion share</h3>
              <p class="assets-metric" id="assets-completion-share">0%</p>
            </article>
            <article class="mini-card">
              <h3 class="mini-card__title">Not found share</h3>
              <p class="assets-metric" id="assets-not-found-share">0%</p>
            </article>
            <article class="mini-card">
              <h3 class="mini-card__title">Average quantity</h3>
              <p class="assets-metric" id="assets-average-quantity">0</p>
            </article>
          </div>
        </div>
      </section>

      <section class="tab-panel" id="tab-all-assets" data-tab-panel="all-assets" role="tabpanel" hidden>
        <div class="panel-card">
          <div class="panel-card__header">
            <div>
              <span class="panel-card__eyebrow">All assets</span>
              <h2 class="panel-card__title">Every asset in the selected camp</h2>
            </div>
            <div class="panel-card__actions">
              <button class="btn btn-primary" type="button" id="open-add-asset-modal" <%= canAddAsset ? '' : 'disabled' %>>
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-plus-circle"></use>
                </svg>
                <span>Add asset</span>
              </button>
              <button class="btn btn-secondary" type="button" id="open-asset-bulk-modal" <%= canBulkAssets ? '' : 'disabled' %>>
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-download"></use>
                </svg>
                <span>Bulk update</span>
              </button>
              <button class="btn btn-secondary" type="button" data-refresh-assets>
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-refresh"></use>
                </svg>
                <span>Refresh</span>
              </button>
            </div>
          </div>
          <div class="table-shell">
            <table class="data-table assets-table">
              <thead>
                <tr>
                  <% allAssetColumns.forEach((column) => { %>
                  <% if (column.key === 'actions') { %>
                  <th class="table-action-col">Action</th>
                  <% } else { %>
                  <th id="assets-all-assets-<%= column.key %>-header" aria-sort="none">
                    <div class="table-header-stack">
                      <% if (column.searchable !== false) { %>
                      <label class="search-field" for="assets-all-assets-search-<%= column.key %>-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="assets-all-assets-search-<%= column.key %>-input" type="search" placeholder="<%= column.search %>" autocomplete="off" data-assets-filter-table="allAssets" data-assets-filter-column="<%= column.key %>" value="<%= (tableMeta.allAssets && tableMeta.allAssets.filters && tableMeta.allAssets.filters[column.key]) || '' %>" /></label>
                      <% } %>
                      <% if (column.sortable !== false) { %>
                      <button class="sort-header-button" type="button" data-assets-sort-table="allAssets" data-assets-sort-column="<%= column.key %>" aria-label="Sort by <%= column.label %>"><span><%= column.label %></span><span class="sort-header-button__indicator" data-assets-sort-indicator="allAssets:<%= column.key %>" aria-hidden="true">-</span></button>
                      <% } else { %>
                      <span class="sort-header-button sort-header-button--static"><%= column.label %></span>
                      <% } %>
                    </div>
                  </th>
                  <% } %>
                  <% }) %>
                </tr>
              </thead>
              <tbody data-assets-table-body="allAssets">
                <% if (resolvedAllAssets.length) { %>
                <% resolvedAllAssets.forEach((asset) => { %>
                <tr>
                  <td><code><%= asset.id %></code></td>
                  <td><code><%= asset.code %></code></td>
                  <td><code><%= asset.rfidCode %></code></td>
                  <td><%= asset.name %></td>
                  <td><%= asset.typeName %></td>
                  <td><%= asset.location %></td>
                  <td><%= asset.status %></td>
                  <td><span class="table-badge" data-assets-status="<%= asset.inventoryStatus %>"><%= asset.inventoryStatusLabel %></span></td>
                  <td><%= asset.lastInventoryDate %></td>
                  <td><%= asset.owner %></td>
                  <td><%= asset.category %></td>
                  <td><%= asset.service %></td>
                  <td><%= asset.expandable %></td>
                  <td><%= asset.isFixedLabel %></td>
                  <td><%= asset.isQuantitativeLabel %></td>
                  <td><%= asset.description %></td>
                  <td><%= asset.mrah %></td>
                  <td><%= asset.comments %></td>
                  <td><%= asset.replacedOff %></td>
                  <td><%= asset.replacedBy %></td>
                  <td><%= asset.purchaseDate %></td>
                  <td><%= asset.writtenOffDate %></td>
                  <td><%= asset.createdAt %></td>
                  <td><%= asset.updatedAt %></td>
                  <td><%= asset.m2Inside %></td>
                  <td><%= asset.yearOfLifeCycle %></td>
                  <td><%= asset.restOfLifeCycle %></td>
                  <td><%= asset.restValue %></td>
                  <td><%= asset.purchasePrice %></td>
                  <td><%= asset.quantity %></td>
                  <td>
                    <div class="table-action-group">
                      <button class="btn btn-primary js-edit-asset" type="button" data-asset-id="<%= asset.id %>" <%= canEditAsset ? '' : 'disabled' %>>
                        <svg class="icon" aria-hidden="true">
                          <use href="#icon-pencil-square"></use>
                        </svg><span>Edit</span>
                      </button>
                      <button class="btn btn-danger js-delete-asset" type="button" data-asset-id="<%= asset.id %>" <%= canDeleteAsset ? '' : 'disabled' %>>
                        <svg class="icon" aria-hidden="true">
                          <use href="#icon-trash"></use>
                        </svg><span>Delete</span>
                      </button>
                    </div>
                  </td>
                </tr>
                <% }) %>
                <% } else { %>
                <tr>
                  <td class="table-empty" colspan="<%= allAssetColumns.length %>">No assets found for the selected camp.</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="pagination-row">
            <button class="btn btn-ghost" type="button" data-assets-prev-table="allAssets" <%= Number(tableMeta.allAssets && tableMeta.allAssets.page) > 1 ? '' : 'disabled' %>>Previous</button>
            <span class="pagination-label" data-assets-page-label="allAssets"><%= pageLabel(tableMeta.allAssets) %></span>
            <button class="btn btn-ghost" type="button" data-assets-next-table="allAssets" <%= Number(tableMeta.allAssets && tableMeta.allAssets.page) < Number(tableMeta.allAssets && tableMeta.allAssets.totalPages) ? '' : 'disabled' %>>Next</button>
          </div>
        </div>
      </section>

      <section class="tab-panel" id="tab-inventory-tracking" data-tab-panel="inventory-tracking" role="tabpanel" hidden>
        <div class="panel-card">
          <div class="panel-card__header">
            <div>
              <span class="panel-card__eyebrow">Inventory tracking</span>
              <h2 class="panel-card__title">Asset coverage and quantity movement</h2>
            </div>
            <div class="panel-card__actions">
              <button class="btn btn-danger" type="button" id="restart-inventory-button" <%= canSaveInventory ? '' : 'disabled' %>>
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-refresh"></use>
                </svg>
                <span>Restart inventory</span>
              </button>
              <button class="btn btn-secondary" type="button" data-refresh-assets>
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-refresh"></use>
                </svg>
                <span>Refresh</span>
              </button>
            </div>
          </div>
          <h3 class="inventory-section__title">Inventory Status</h3>
          <div class="table-shell">
            <table class="data-table data-table--compact">
              <thead>
                <tr>
                  <% statusColumns.forEach((column) => { %>
                  <th id="assets-status-<%= column.key %>-header" aria-sort="none">
                    <div class="table-header-stack">
                      <% if (column.searchable !== false) { %>
                      <label class="search-field" for="assets-status-search-<%= column.key %>-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="assets-status-search-<%= column.key %>-input" type="search" placeholder="<%= column.search %>" autocomplete="off" data-assets-filter-table="inventoryStatusRows" data-assets-filter-column="<%= column.key %>" value="<%= (tableMeta.inventoryStatusRows && tableMeta.inventoryStatusRows.filters && tableMeta.inventoryStatusRows.filters[column.key]) || '' %>" /></label>
                      <% } %>
                      <button class="sort-header-button" type="button" data-assets-sort-table="inventoryStatusRows" data-assets-sort-column="<%= column.key %>" aria-label="Sort by <%= column.label %>"><span><%= column.label %></span><span class="sort-header-button__indicator" data-assets-sort-indicator="inventoryStatusRows:<%= column.key %>" aria-hidden="true">-</span></button>
                    </div>
                  </th>
                  <% }) %>
                </tr>
              </thead>
              <tbody data-assets-table-body="inventoryStatusRows">
                <% resolvedInventoryStatusRows.forEach((row) => { %>
                <tr>
                  <td><span class="table-badge" data-assets-status="<%= row.status %>"><%= row.label %></span></td>
                  <td><%= row.lastInventoryDate %></td>
                  <td><%= row.assetCount %></td>
                  <td><%= row.quantity %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <div class="pagination-row">
            <button class="btn btn-ghost" type="button" data-assets-prev-table="inventoryStatusRows" <%= Number(tableMeta.inventoryStatusRows && tableMeta.inventoryStatusRows.page) > 1 ? '' : 'disabled' %>>Previous</button>
            <span class="pagination-label" data-assets-page-label="inventoryStatusRows"><%= pageLabel(tableMeta.inventoryStatusRows) %></span>
            <button class="btn btn-ghost" type="button" data-assets-next-table="inventoryStatusRows" <%= Number(tableMeta.inventoryStatusRows && tableMeta.inventoryStatusRows.page) < Number(tableMeta.inventoryStatusRows && tableMeta.inventoryStatusRows.totalPages) ? '' : 'disabled' %>>Next</button>
          </div>
          <h3 class="inventory-section__title">Inventory Events</h3>
          <div class="table-shell">
            <table class="data-table data-table--compact">
              <thead>
                <tr>
                  <% eventColumns.forEach((column) => { %>
                  <th id="assets-events-<%= column.key %>-header" aria-sort="none">
                    <div class="table-header-stack">
                      <% if (column.searchable !== false) { %>
                      <label class="search-field" for="assets-events-search-<%= column.key %>-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="assets-events-search-<%= column.key %>-input" type="search" placeholder="<%= column.search %>" autocomplete="off" data-assets-filter-table="inventoryEvents" data-assets-filter-column="<%= column.key %>" value="<%= (tableMeta.inventoryEvents && tableMeta.inventoryEvents.filters && tableMeta.inventoryEvents.filters[column.key]) || '' %>" /></label>
                      <% } %>
                      <button class="sort-header-button" type="button" data-assets-sort-table="inventoryEvents" data-assets-sort-column="<%= column.key %>" aria-label="Sort by <%= column.label %>"><span><%= column.label %></span><span class="sort-header-button__indicator" data-assets-sort-indicator="inventoryEvents:<%= column.key %>" aria-hidden="true">-</span></button>
                    </div>
                  </th>
                  <% }) %>
                </tr>
              </thead>
              <tbody data-assets-table-body="inventoryEvents">
                <% if (resolvedInventoryEvents.length) { %>
                <% resolvedInventoryEvents.forEach((event) => { %>
                <tr>
                  <td><%= event.changedAt %></td>
                  <td><%= event.addedQuantity %></td>
                  <td><%= event.removedQuantity %></td>
                  <td><%= event.lostQuantity %></td>
                  <td><%= event.modifiedQuantity %></td>
                </tr>
                <% }) %>
                <% } else { %>
                <tr>
