<!doctype html>
<html lang="en">
<%- await include('../../../../shared/views/partials/workspace/head', {
  title,
  pageStyles: ['/assets/accommodation/css/accommodation-page.css']
}) %>

<body class="main-workspace" data-page="accommodation-page" data-current-camp-id="<%= campId || '' %>">
  <%- await include('../../../../shared/views/partials/common/a11y-primitives') %>
  <%- await include('../../../../shared/views/partials/workspace/icons') %>
  <%- await include('../../../../shared/views/partials/common/page-data', { pageData: { pageKey, campId: campId || '', currentNav, permissionNames: permissionNames || [] } }) %>

  <input type="hidden" id="csrf-token" value="<%= csrfToken %>" />

  <%- await include('../../../../shared/views/partials/workspace/topbar', {
    navItems: horizontalNavItems,
    currentNav,
    csrfToken
  }) %>

  <main class="workspace-shell" id="main-content">
    <section class="hero-card">
      <div class="hero-card__content">
        <span class="hero-card__eyebrow"><%= eyebrow %></span>
        <h1 class="hero-card__title"><%= title %></h1>
        <p class="hero-card__text"><%= intro %></p>
        <div class="hero-card__meta">
          <span class="hero-chip"><svg class="icon" aria-hidden="true">
              <use href="#icon-house-door"></use>
            </svg><span>Buildings and rooms</span></span>
          <span class="hero-chip"><svg class="icon" aria-hidden="true">
              <use href="#icon-key"></use>
            </svg><span>Key availability</span></span>
          <span class="hero-chip"><svg class="icon" aria-hidden="true">
              <use href="#icon-check-circle"></use>
            </svg><span>Occupancy overview</span></span>
        </div>
      </div>
    </section>

    <section class="summary-grid" aria-label="Accommodation summary">
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Buildings</span></div>
        <div class="summary-card__value" id="summary-buildings">-</div>
        <p class="summary-card__text">Tracked building locations.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Rooms</span></div>
        <div class="summary-card__value" id="summary-rooms">-</div>
        <p class="summary-card__text">Rooms visible in the selected camp.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Keys</span></div>
        <div class="summary-card__value" id="summary-keys">-</div>
        <p class="summary-card__text">Total keys mapped to rooms.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Free keys</span></div>
        <div class="summary-card__value" id="summary-free-keys">-</div>
        <p class="summary-card__text">Keys that are currently available.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Occupied keys</span></div>
        <div class="summary-card__value" id="summary-occupied-keys">-</div>
        <p class="summary-card__text">Keys currently assigned to a soldier.</p>
      </article>
      <article class="mini-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Upcoming actions</span></div>
        <div class="summary-card__value" id="summary-upcoming-action">-</div>
        <p class="summary-card__text">Soldiers that have upcoming actions.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Soldiers</span></div>
        <div class="summary-card__value" id="summary-soldiers">-</div>
        <p class="summary-card__text">Soldiers tracked in this camp.</p>
      </article>
      <article class="summary-card">
        <div class="summary-card__header"><span class="summary-card__eyebrow">Additional items</span></div>
        <div class="summary-card__value" id="summary-additional-items">-</div>
        <p class="summary-card__text">Items and bags assigned to soldiers.</p>
      </article>
    </section>

    <section class="workspace-panels" aria-label="Accommodation workspace">
      <div class="tab-bar" role="tablist" aria-label="Accommodation sections">
        <button class="tab-pill is-active" type="button" role="tab" data-tab-trigger="overview" aria-selected="true">Overview</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="buildings" aria-selected="false">Buildings</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="rooms" aria-selected="false">Rooms</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="keys" aria-selected="false">Keys</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="soldiers" aria-selected="false">Soldiers</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="additional-items" aria-selected="false">Additional items</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="report" aria-selected="false">Report</button>
        <button class="tab-pill" type="button" role="tab" data-tab-trigger="guide" aria-selected="false">Guide</button>
      </div>

      <section class="tab-panel is-active" data-tab-panel="overview" role="tabpanel">
        <div class="panel-card">
          <div class="panel-card__header">
            <div>
              <span class="panel-card__eyebrow">Operational overview</span>
              <h2 class="panel-card__title">Accommodation pressure</h2>
            </div>
            <div class="panel-card__actions">
              <button class="btn btn-secondary" type="button" id="refresh-accommodation-button">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-refresh"></use>
                </svg>
                <span>Refresh</span>
              </button>
            </div>
          </div>
          <div class="overview-split">
            <article class="mini-card">
              <h3 class="mini-card__title">Upcoming accommodation</h3>
              <ul class="name-list" id="upcoming-accommodation-list">
                <li>No pending accommodation entries.</li>
              </ul>
            </article>
            <article class="mini-card">
              <h3 class="mini-card__title">Upcoming release</h3>
              <ul class="name-list" id="upcoming-release-list">
                <li>No pending release entries.</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="tab-panel" data-tab-panel="buildings" role="tabpanel" hidden>
        <div class="panel-card">
          <div class="panel-card__header">
            <div>
              <span class="panel-card__eyebrow">Buildings</span>
              <h2 class="panel-card__title">Buildings and mapped rooms/keys</h2>
            </div>
            <div class="panel-card__actions">
              <button class="btn btn-primary" type="button" id="open-add-building-modal">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-plus-circle"></use>
                </svg>
                <span>Add building</span>
              </button>
              <button class="btn btn-danger" type="button" id="release-selected-buildings-button" disabled>
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-box-arrow-right"></use>
                </svg>
                <span>Release selected</span>
              </button>
              <button class="btn btn-secondary" type="button" id="open-building-import-modal">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-download"></use>
                </svg>
                <span>Bulk update</span>
              </button>
              <button class="btn btn-secondary" type="button" id="refresh-buildings-button">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-refresh"></use>
                </svg>
                <span>Refresh</span>
              </button>
            </div>
          </div>
          <div class="data-table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th class="table-select-col">
                    <input id="building-select-page-checkbox" type="checkbox" aria-label="Select visible occupied buildings" />
                  </th>
                  <th id="building-id-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="building-search-id-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="building-search-id-input" type="search" placeholder="Search identifier" autocomplete="off" data-building-filter-column="id" /></label>
                      <button class="sort-header-button" type="button" data-building-sort-column="id" aria-label="Sort by identifier">
                        <span>Identifier</span>
                        <span class="sort-header-button__indicator" data-building-sort-indicator="id" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="building-name-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="building-search-name-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="building-search-name-input" type="search" placeholder="Search building" autocomplete="off" data-building-filter-column="name" /></label>
                      <button class="sort-header-button" type="button" data-building-sort-column="name" aria-label="Sort by building">
                        <span>Building</span>
                        <span class="sort-header-button__indicator" data-building-sort-indicator="name" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="building-type-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="building-search-type-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="building-search-type-input" type="search" placeholder="Search type" autocomplete="off" data-building-filter-column="type" /></label>
                      <button class="sort-header-button" type="button" data-building-sort-column="type" aria-label="Sort by type">
                        <span>Type</span>
                        <span class="sort-header-button__indicator" data-building-sort-indicator="type" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="building-status-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="building-search-status-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="building-search-status-input" type="search" placeholder="Search status" autocomplete="off" data-building-filter-column="status" /></label>
                      <button class="sort-header-button" type="button" data-building-sort-column="status" aria-label="Sort by status">
                        <span>Status</span>
                        <span class="sort-header-button__indicator" data-building-sort-indicator="status" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="building-rooms-header" aria-sort="none">
                    <div class="table-header-stack">
                      <button class="sort-header-button" type="button" data-building-sort-column="roomCount" aria-label="Sort by rooms">
                        <span>Rooms</span>
                        <span class="sort-header-button__indicator" data-building-sort-indicator="roomCount" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="building-total-keys-header" aria-sort="none">
                    <div class="table-header-stack">
                      <button class="sort-header-button" type="button" data-building-sort-column="totalKeys" aria-label="Sort by total keys">
                        <span>Total keys</span>
                        <span class="sort-header-button__indicator" data-building-sort-indicator="totalKeys" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="building-free-keys-header" aria-sort="none">
                    <div class="table-header-stack">
                      <button class="sort-header-button" type="button" data-building-sort-column="freeKeys" aria-label="Sort by free keys">
                        <span>Free keys</span>
                        <span class="sort-header-button__indicator" data-building-sort-indicator="freeKeys" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="building-occupied-keys-header" aria-sort="none">
                    <div class="table-header-stack">
                      <button class="sort-header-button" type="button" data-building-sort-column="occupiedKeys" aria-label="Sort by occupied keys">
                        <span>Occupied keys</span>
                        <span class="sort-header-button__indicator" data-building-sort-indicator="occupiedKeys" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th class="table-action-col">Action</th>
                </tr>
              </thead>
              <tbody id="buildings-table-body">
                <tr>
                  <td colspan="10">Loading building information...</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="pagination-row">
            <button class="btn btn-ghost" type="button" id="buildings-prev-button">Previous</button>
            <span id="buildings-page-label" class="pagination-label">Page 1</span>
            <button class="btn btn-ghost" type="button" id="buildings-next-button">Next</button>
          </div>
        </div>
      </section>

      <section class="tab-panel" data-tab-panel="rooms" role="tabpanel" hidden>
        <div class="panel-card">
          <div class="panel-card__header">
            <div>
              <span class="panel-card__eyebrow">Rooms</span>
              <h2 class="panel-card__title">Rooms and mapped keys</h2>
            </div>
            <div class="panel-card__actions">
              <button class="btn btn-primary" type="button" id="open-add-room-modal">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-plus-circle"></use>
                </svg>
                <span>Add room</span>
              </button>
              <button class="btn btn-danger" type="button" id="release-selected-rooms-button" disabled>
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-box-arrow-right"></use>
                </svg>
                <span>Release selected</span>
              </button>
              <button class="btn btn-secondary" type="button" id="open-room-import-modal">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-download"></use>
                </svg>
                <span>Bulk update</span>
              </button>
              <button class="btn btn-secondary" type="button" id="refresh-rooms-button">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-refresh"></use>
                </svg>
                <span>Refresh</span>
              </button>
            </div>
          </div>
          <div class="data-table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th class="table-select-col">
                    <input id="room-select-page-checkbox" type="checkbox" aria-label="Select visible occupied rooms" />
                  </th>
                  <th id="room-id-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="room-search-id-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="room-search-id-input" type="search" placeholder="Search identifier" autocomplete="off" data-room-filter-column="id" /></label>
                      <button class="sort-header-button" type="button" data-room-sort-column="id" aria-label="Sort by identifier">
                        <span>Identifier</span>
                        <span class="sort-header-button__indicator" data-room-sort-indicator="id" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="room-name-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="room-search-name-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="room-search-name-input" type="search" placeholder="Search room" autocomplete="off" data-room-filter-column="name" /></label>
                      <button class="sort-header-button" type="button" data-room-sort-column="name" aria-label="Sort by room">
                        <span>Room</span>
                        <span class="sort-header-button__indicator" data-room-sort-indicator="name" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="room-building-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="room-search-building-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="room-search-building-input" type="search" placeholder="Search building" autocomplete="off" data-room-filter-column="buildingName" /></label>
                      <button class="sort-header-button" type="button" data-room-sort-column="buildingName" aria-label="Sort by building">
                        <span>Building</span>
                        <span class="sort-header-button__indicator" data-room-sort-indicator="buildingName" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="room-status-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="room-search-status-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="room-search-status-input" type="search" placeholder="Search status" autocomplete="off" data-room-filter-column="status" /></label>
                      <button class="sort-header-button" type="button" data-room-sort-column="status" aria-label="Sort by status">
                        <span>Status</span>
                        <span class="sort-header-button__indicator" data-room-sort-indicator="status" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="room-total-keys-header" aria-sort="none">
                    <div class="table-header-stack">
                      <button class="sort-header-button" type="button" data-room-sort-column="totalKeys" aria-label="Sort by total keys">
                        <span>Total keys</span>
                        <span class="sort-header-button__indicator" data-room-sort-indicator="totalKeys" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="room-free-keys-header" aria-sort="none">
                    <div class="table-header-stack">
                      <button class="sort-header-button" type="button" data-room-sort-column="freeKeys" aria-label="Sort by free keys">
                        <span>Free keys</span>
                        <span class="sort-header-button__indicator" data-room-sort-indicator="freeKeys" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="room-occupied-keys-header" aria-sort="none">
                    <div class="table-header-stack">
                      <button class="sort-header-button" type="button" data-room-sort-column="occupiedKeys" aria-label="Sort by occupied keys">
                        <span>Occupied keys</span>
                        <span class="sort-header-button__indicator" data-room-sort-indicator="occupiedKeys" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th class="table-action-col">Action</th>
                </tr>
              </thead>
              <tbody id="rooms-table-body">
                <tr>
                  <td colspan="9">Loading room information...</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="pagination-row">
            <button class="btn btn-ghost" type="button" id="rooms-prev-button">Previous</button>
            <span id="rooms-page-label" class="pagination-label">Page 1</span>
            <button class="btn btn-ghost" type="button" id="rooms-next-button">Next</button>
          </div>
        </div>
      </section>

      <section class="tab-panel" data-tab-panel="keys" role="tabpanel" hidden>
        <div class="panel-card">
          <div class="panel-card__header">
            <div>
              <span class="panel-card__eyebrow">Keys</span>
              <h2 class="panel-card__title">All free and occupied keys</h2>
            </div>
            <div class="panel-card__actions">
              <button class="btn btn-primary" type="button" id="open-add-key-modal">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-plus-circle"></use>
                </svg>
                <span>Add key</span>
              </button>
              <button class="btn btn-secondary" type="button" id="open-key-import-modal">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-download"></use>
                </svg>
                <span>Bulk update</span>
              </button>
              <button class="btn btn-secondary" type="button" id="refresh-keys-button">
                <svg class="icon" aria-hidden="true">
                  <use href="#icon-refresh"></use>
                </svg>
                <span>Refresh</span>
              </button>
            </div>
          </div>
          <div class="data-table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th id="key-id-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="key-search-id-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="key-search-id-input" type="search" placeholder="Search identifier" autocomplete="off" data-key-filter-column="id" /></label>
                      <button class="sort-header-button" type="button" data-key-sort-column="id" aria-label="Sort by identifier">
                        <span>Identifier</span>
                        <span class="sort-header-button__indicator" data-key-sort-indicator="id" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="key-name-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="key-search-name-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="key-search-name-input" type="search" placeholder="Search key" autocomplete="off" data-key-filter-column="name" /></label>
                      <button class="sort-header-button" type="button" data-key-sort-column="name" aria-label="Sort by key">
                        <span>Key</span>
                        <span class="sort-header-button__indicator" data-key-sort-indicator="name" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="key-nfc-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="key-search-nfc-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="key-search-nfc-input" type="search" placeholder="Search NFC code" autocomplete="off" data-key-filter-column="nfcCode" /></label>
                      <button class="sort-header-button" type="button" data-key-sort-column="nfcCode" aria-label="Sort by NFC code">
                        <span>NFC code</span>
                        <span class="sort-header-button__indicator" data-key-sort-indicator="nfcCode" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="key-room-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="key-search-room-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="key-search-room-input" type="search" placeholder="Search room" autocomplete="off" data-key-filter-column="roomName" /></label>
                      <button class="sort-header-button" type="button" data-key-sort-column="roomName" aria-label="Sort by room">
                        <span>Room</span>
                        <span class="sort-header-button__indicator" data-key-sort-indicator="roomName" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="key-building-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="key-search-building-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="key-search-building-input" type="search" placeholder="Search building" autocomplete="off" data-key-filter-column="buildingName" /></label>
                      <button class="sort-header-button" type="button" data-key-sort-column="buildingName" aria-label="Sort by building">
                        <span>Building</span>
                        <span class="sort-header-button__indicator" data-key-sort-indicator="buildingName" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="key-status-header" aria-sort="none">
                    <div class="table-header-stack">
                      <label class="search-field" for="key-search-status-input"><svg class="icon" aria-hidden="true">
                          <use href="#icon-search"></use>
                        </svg><input id="key-search-status-input" type="search" placeholder="Search status" autocomplete="off" data-key-filter-column="status" /></label>
                      <button class="sort-header-button" type="button" data-key-sort-column="status" aria-label="Sort by status">
                        <span>Status</span>
                        <span class="sort-header-button__indicator" data-key-sort-indicator="status" aria-hidden="true">-</span>
                      </button>
                    </div>
                  </th>
                  <th id="key-soldier-header" aria-sort="none">
                    <div class="table-header-stack">
