<!doctype html>
<html lang="en">
<%- await include('../../../../shared/views/partials/auth/head', {
  title,
  pageStyles: ['/assets/auth/css/change-password.css']
}) %>

<body data-page="auth-change-password">
  <%- await include('../../../../shared/views/partials/common/a11y-primitives') %>
  <%- await include('../../../../shared/views/partials/auth/icons') %>
  <%- await include('../../../../shared/views/partials/auth/theme-toolbar') %>

  <main class="saas-auth" id="main-content">
    <%- await include('../../../../shared/views/partials/auth/brand-panel', {
      headline: 'Change your password with clear policy guidance.',
      subtext: 'Use a strong password that is unique to this system. The form validates requirements before submission and keeps the process predictable for users and administrators.',
      badges: ['Strong password policy', 'Session-protected', 'Reduced error loops'],
      panelEyebrow: 'Password change workflow',
      panelTitle: 'Enterprise-friendly password reset with less user friction.',
      panelText: 'Visible requirements, confirmation checks and consistent feedback make the update process clearer and safer.',
      featureCards: [
        { icon: 'PW', title: 'Strong password rules', text: 'Length, upper and lower case letters, number, symbol and change-from-current protection.' },
        { icon: 'OK', title: 'Immediate validation', text: 'Users can see what is missing before they submit the form.' },
        { icon: 'SEC', title: 'Safer request handling', text: 'Sensitive fields are cleared after server-side validation errors.' },
      ],
      featureList: [],
      panelClass: 'security-panel',
      panelAriaLabel: 'Password guidance'
    }) %>

    <section class="saas-auth__right">
      <div class="login-card">
        <header class="login-card__header">
          <span class="login-card__eyebrow">Credential update</span>
          <h1 class="login-card__title"><%= title %></h1>
          <p class="login-card__hint">Choose a long, unique password that you do not use anywhere else.</p>
        </header>

        <%- await include('../../../../shared/views/partials/auth/alert', {
          id: 'change-password-alert',
          textId: 'change-password-error-message',
          message: '',
          isVisible: false,
        }) %>

        <form id="change-password" class="login-form" action="/web/password/change" method="POST" autocomplete="off" novalidate data-state-root="true">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-section">
            <div class="field">
              <label for="username">Username</label>
              <input id="username" name="username" type="text" autocomplete="username" placeholder="Enter username" required />
              <div class="field__help">Use the same username you sign in with.</div>
            </div>
            <div class="field">
              <label for="current-password">Current password</label>
              <div class="input-with-icon"><input id="current-password" name="current-password" type="password" autocomplete="current-password" placeholder="Enter current password" required /><%- await include('../../../../shared/views/partials/auth/password-toggle-button', { targetId: 'current-password' }) %></div>
            </div>
            <div class="field">
              <label for="new-password">New password</label>
              <div class="input-with-icon"><input id="new-password" name="new-password" type="password" autocomplete="new-password" placeholder="Create a new password" required /><%- await include('../../../../shared/views/partials/auth/password-toggle-button', { targetId: 'new-password' }) %></div>
              <div class="pw-meter" aria-hidden="true">
                <progress id="pw-meter-bar" class="pw-meter__bar" max="100" value="0"></progress>
              </div>
              <ul class="pw-rules" aria-label="Password requirements">
                <li id="rule-len">At least 8 characters</li>
                <li id="rule-upper">One uppercase letter</li>
                <li id="rule-lower">One lowercase letter</li>
                <li id="rule-num">One number</li>
                <li id="rule-sym">One symbol (@$!%*?& or similar)</li>
                <li id="rule-diff">Different from current password</li>
              </ul>
            </div>
            <div class="field">
              <label for="confirm-new-password">Confirm new password</label>
              <div class="input-with-icon"><input id="confirm-new-password" name="confirm-new-password" type="password" autocomplete="new-password" placeholder="Re-enter new password" required /><%- await include('../../../../shared/views/partials/auth/password-toggle-button', { targetId: 'confirm-new-password' }) %></div>
              <div class="field__help">Must exactly match the new password.</div>
            </div>
          </div>
          <button type="submit" class="btn-primary">Update password</button>
          <div id="loading-indicator" class="loading" aria-live="polite">
            <div class="spinner" aria-hidden="true"></div><span>Updating password…</span>
          </div>
          <p class="legal">If you did not intend to change this password, contact your administrator immediately.</p>
        </form>
      </div>
    </section>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script type="module" src="/assets/auth/js/change-password/change-password-page.ts"></script>
</body>

</html>
