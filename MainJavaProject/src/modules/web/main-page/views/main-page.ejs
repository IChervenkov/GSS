</form>`
  }) %>

  <%- await include('../../../../shared/views/partials/workspace/modal', {
    id: 'user-modal',
    titleId: 'user-modal-title',
    closeLabel: 'Close user modal',
    eyebrow: 'User lifecycle',
    title: 'Add user',
    description: 'Create a user account with a controlled temporary password flow.',
    descriptionId: 'user-modal-text',
    body: `<form id="user-form" class="workspace-form" novalidate>
  <input type="hidden" id="user-form-mode" name="mode" value="create" />
  <input type="hidden" id="user-id-input" name="id" />
  <div class="field">
    <label for="user-name-input">Username</label>
    <div class="input-icon-field">
      <svg class="icon" aria-hidden="true">
        <use href="#icon-person-gear"></use>
      </svg>
      <input id="user-name-input" name="username" type="text" placeholder="username@company.com" required />
    </div>
