  <div class="field" id="user-password-field">
    <label for="user-password-input" id="user-password-label">Temporary password</label>
    <div class="input-icon-field">
      <svg class="icon" aria-hidden="true">
        <use href="#icon-lock"></use>
      </svg>
      <input id="user-password-input" name="password" type="text" placeholder="Generated when needed" />
    </div>
    <div class="field__hint" id="user-password-hint">Leave empty during create to let the system generate one.</div>
  </div>
  <div class="workspace-form__actions">
    <button type="submit" class="btn btn-primary" id="save-user-button">Save user</button>
    <button type="button" class="btn btn-ghost" data-close-modal="true">Cancel</button>
  </div>
</form>`
  }) %>

  <%- await include('../../../../shared/views/partials/workspace/confirm-modal') %>

  <div class="workspace-modal" id="temp-password-modal" hidden>
    <div class="workspace-modal__backdrop" data-close-modal="true"></div>
    <section class="workspace-modal__dialog workspace-modal__dialog--compact" role="dialog" aria-modal="true" aria-labelledby="temp-password-modal-title">
      <button type="button" class="workspace-modal__close" data-close-modal="true" aria-label="Close temporary password modal">×</button>
      <header class="workspace-modal__header">
        <span class="workspace-modal__eyebrow">Temporary password</span>
        <h2 id="temp-password-modal-title" class="workspace-modal__title">Store this credential securely</h2>
