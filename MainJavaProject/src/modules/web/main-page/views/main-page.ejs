    body: `<form id="add-camp-form" class="workspace-form" novalidate>
  <div class="field">
    <label for="add-camp-name-input">Camp name</label>
    <div class="input-icon-field">
      <svg class="icon" aria-hidden="true">
        <use href="#icon-building"></use>
      </svg>
      <input id="add-camp-name-input" name="campName" type="text" placeholder="Camp Alpha" required />
    </div>
  </div>
  <div class="workspace-form__actions">
    <button type="submit" class="btn btn-primary">Create camp</button>
    <button type="button" class="btn btn-ghost" data-close-modal="true">Cancel</button>
  </div>
</form>`
  }) %>

  <%- await include('../../../../shared/views/partials/workspace/modal', {
    id: 'edit-camp-modal',
    titleId: 'edit-camp-modal-title',
    closeLabel: 'Close edit camp modal',
