<%- include('./partials/workspace/page-start', {
  title,
  pageKey,
  bodyClass: 'main-workspace',
  currentCampId: campId || '',
  mainId: 'main-content',
  pageData: {
    page: pageKey,
    csrfToken,
    currentCampId: campId || ''
  }
}) %>

  <%- include('./partials/workspace/topbar', {
    navItems: horizontalNavItems,
    currentNav
  }) %>

  <main class="workspace-shell" id="main-content">
    <section class="hero-card">
      <div class="hero-card__content">
        <span class="hero-card__eyebrow"><%= eyebrow %></span>
        <h1 class="hero-card__title"><%= title %></h1>
        <p class="hero-card__text"><%= intro %></p>
        <div class="hero-card__meta">
          <% highlights.forEach((highlight) => { %>
          <span class="hero-chip"><span><%= highlight %></span></span>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="panel-card">
      <div class="panel-card__header">
        <div>
          <span class="panel-card__eyebrow">Next refactor step</span>
          <h2 class="panel-card__title">Feature module is in place</h2>
        </div>
      </div>
      <p class="hero-card__text"><%= migrationNotice %></p>
    </section>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script type="module" src="/assets/shared/js/workspace/static-page.ts"></script>
  <%- include('./partials/workspace/page-end') %>
