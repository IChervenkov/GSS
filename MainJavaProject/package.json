{
  "name": "gss",
  "version": "1.0.0",
  "description": "",
  "main": "./src/bootstrap/server.ts",
  "scripts": {
    "start": "node ./scripts/runtime.ts",
    "dev": "node ./scripts/runtime.ts",
    "lint": "node ./scripts/lint.ts && node ./scripts/check-csp-hygiene.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:smoke && npm run test:coverage-map",
    "test:unit": "node --require ./scripts/register-typescript.ts --test tests/unit/**/*.test.ts",
    "test:integration": "node --require ./scripts/register-typescript.ts --test tests/integration/**/*.test.ts tests/realtime/**/*.test.ts",
    "test:e2e": "node --require ./scripts/register-typescript.ts --test tests/e2e/**/*.test.ts",
    "test:coverage-map": "node ./scripts/print-coverage-map.ts",
    "test:smoke": "node --require ./scripts/register-typescript.ts --test tests/smoke/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "node ./scripts/create-build-metadata.ts",
    "db:migrate": "node --require ./scripts/register-typescript.ts ./scripts/run-migrations.ts",
    "db:schema-doc": "node --require ./scripts/register-typescript.ts ./scripts/generate-schema-doc.ts",
    "db:migration-gate": "node --require ./scripts/register-typescript.ts ./scripts/migration-gate.ts",
    "security:secret-scan": "node ./scripts/secret-scan.ts",
    "security:dependency-audit": "node ./scripts/dependency-audit-policy.ts",
    "ops:up": "docker compose -f ops/observability/docker-compose.yml up -d",
    "ops:down": "docker compose -f ops/observability/docker-compose.yml down",
    "ops:logs": "docker compose -f ops/observability/docker-compose.yml logs -f",
    "dev:server": "nodemon ./src/bootstrap/server.ts",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "prod:up": "docker compose --profile production up --build -d postgres redis app",
    "prod:down": "docker compose --profile production down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "bcryptjs": "3.0.3",
    "connect-redis": "7.1.1",
    "cors": "2.8.5",
    "csrf-sync": "4.2.1",
    "dayjs": "1.11.19",
    "dotenv": "17.2.3",
    "ejs": "4.0.1",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "hpp": "0.2.3",
    "joi": "18.2.1",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "pg": "8.17.1",
    "qrcode": "1.5.4",
    "redis": "4.7.1",
    "socket.io": "4.8.3",
    "speakeasy": "2.0.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/hpp": "0.2.7",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.1.0",
    "@types/node": "^24.13.3",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/speakeasy": "2.0.10",
    "nodemon": "3.1.10"
  },
  "overrides": {
    "qs": "6.15.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "ws": "8.21.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
