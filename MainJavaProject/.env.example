# GSS environment reference
# Canonical names only. Deprecated aliases like REDIS_URL, REDIS_URI,
# TOKEN_EXPIRES_IN, ACCESS_TOKEN_TTL_MINUTES, REFRESH_TOKEN_TTL_DAYS,
# JWT_SECRET, and SESSION_REDIS_URL are intentionally unsupported.
# Copy this file to .env for local development and replace every placeholder.

# Runtime identity
NODE_ENV=local
ENVIRONMENT_NAME=local
PORT=3000
APP_NAME=GSS
APP_URL=http://localhost:3000
APP_VERSION=1.0.0
APP_BUILD_SHA=local
APP_BUILD_TIME=1970-01-01T00:00:00.000Z

# Auth and session secrets
# SESSION_SECRET: current cookie signing secret.
# SESSION_SECRET_PREVIOUS: comma-separated rotated cookie secrets kept temporarily during rotation.
# ACCESS_TOKEN_SECRET / REFRESH_TOKEN_SECRET: JWT signing keys.
SESSION_SECRET=replace-me-with-64-random-characters-session-secret
SESSION_SECRET_PREVIOUS=
ACCESS_TOKEN_SECRET=replace-me-with-64-random-characters-access-token-secret
REFRESH_TOKEN_SECRET=replace-me-with-64-random-characters-refresh-token-secret
SECRET_NAME=GSS
CSP_REPORT_ONLY=true

# Token lifetime policy
# ACCESS_TOKEN_EXPIRES_IN is in minutes.
# REFRESH_TOKEN_EXPIRES_IN is in days.
ACCESS_TOKEN_EXPIRES_IN=15
REFRESH_TOKEN_EXPIRES_IN=14
ACCESS_TOKEN_ISSUER=gss-api
ACCESS_TOKEN_AUDIENCE=gss-clients
REFRESH_SESSION_MAX_ACTIVE_PER_USER=10
REFRESH_SESSION_MAX_ACTIVE_PER_DEVICE=3
SESSION_TTL_MS=28800000
SESSION_ABSOLUTE_TTL_MS=86400000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/

# PostgreSQL connection and runtime DB policy
DB_USER=gss
DB_HOST=localhost
DB_NAME=gss
DB_PASSWORD=replace-me
DB_PORT=5432
DATABASE_SSL=false
DATABASE_MAX_CLIENTS=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DB_RUN_MIGRATIONS_ON_BOOT=true
ALLOW_RUNTIME_MIGRATIONS=true
DB_RUN_MAINTENANCE_ON_BOOT=true
DB_MAINTENANCE_INTERVAL_MS=300000
DB_FAILED_LOGINS_RETENTION_DAYS=7
DB_AUDIT_ARCHIVE_AFTER_DAYS=180

# Mobile/app shared secrets
HASH_APP_BIKE=replace-me-with-a-real-app-secret-hash-1
HASH_APP_LAUNDRY=replace-me-with-a-real-app-secret-hash-2
HASH_APP_ASSET=replace-me-with-a-real-app-secret-hash-3
HASH_APP_GYM=replace-me-with-a-real-app-secret-hash-4
APP_BIKE_VERSION=1.4.1
APP_LAUNDRY_VERSION=1.4.2
APP_ASSET_VERSION=1.5.3
APP_BIKE_FILE_PATH=androidApp/gss-bike-1.4.1-release.apk
APP_LAUNDRY_FILE_PATH=androidApp/gss-laundry-1.4.2-release.apk
APP_ASSET_FILE_PATH=androidApp/gss-asset-1.5.3-release.apk

# Redis and shared infrastructure
# Use REDIS_HOST and REDIS_PORT only. Set both or leave both empty.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_REQUIRED=false
SESSION_REDIS_PREFIX=sess:

# Abuse protection and throttling
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_BY_IP=20
LOGIN_RATE_LIMIT_MAX_BY_USERNAME=10
QR_REQUEST_RATE_LIMIT_WINDOW_MS=300000
QR_REQUEST_RATE_LIMIT_MAX=3
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_CHANGE_RATE_LIMIT_MAX=5
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# Security and auth workflow timing
SECURITY_UPLOAD_MAX_FILE_SIZE=10485760
TWO_FACTOR_ENROLLMENT_TTL_SECONDS=600
ONE_TIME_QR_TTL_SECONDS=30
ADMIN_USERNAME=admin@example.com
BCRYPT_ROUNDS=12
TRUST_PROXY=false
LOG_LEVEL=info

# Observability
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_AUTH_TOKEN=replace-me-with-a-real-metrics-token
OBSERVABILITY_HEALTH_AUTH_TOKEN=replace-me-with-a-real-health-token
OBSERVABILITY_INSTANCE=local

# Shutdown and networking
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
CONNECTION_DRAIN_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=66000

# Backup and recovery targets
BACKUP_S3_BUCKET=
BACKUP_RETENTION_DAYS=14
RPO_MINUTES=15
RTO_MINUTES=60

# Optional dedicated integration test database connection string
TEST_DATABASE_URL=
DATABASE_URL_TEST=
